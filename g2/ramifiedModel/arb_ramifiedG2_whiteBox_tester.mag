J:= Jacobian(C);

U1 := R!x^2+x+FF.1^2;
V1 := R!FF.1*x+1;
D1 := J![U1,V1];
un2,un1,un0,vn1,vn0 := DBL(U1,V1,f,h);
nU:= R! un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! vn1*x^1 + vn0*x^0;
Cantor:= 2*D1;
assert (un2*x^2 + un1*x^1 + un0*x^0) eq Cantor[1] and (vn1*x^1 + vn0*x^0) eq Cantor[2];


