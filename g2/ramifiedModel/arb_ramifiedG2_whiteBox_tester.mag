FF := GF(4);
R<x>:=PolynomialRing(FF);
f:= R! x^5 + FF.1*x^3 + FF.1^2*x^2 + x + FF.1^2;
h:= R! FF.1^2;
C:= HyperellipticCurve(f,h);
J:= Jacobian(C);

U1 := R!x^2+FF.1^2*x+FF.1;
V1 := R!x;
U2 := R!x^2+FF.1^2*x+FF.1;
V2 := R!FF.1;
D1 := J![U1,V1];
D2 := J![U2,V2];
un2,un1,un0,vn1,vn0 := ADD(U1,V1,U2,V2,f,h);
nU:= R! un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! vn1*x^1 + vn0*x^0;
Cantor:= D1 + D2;
assert (un2*x^2 + un1*x^1 + un0*x^0) eq Cantor[1] and (vn1*x^1 + vn0*x^0) eq Cantor[2];


FF := GF(5);
R<x>:=PolynomialRing(FF);
f:= R! x^5 + 2*x^4 + 2*x^2 + 4;
h:= R! 3*x + 2;
C:= HyperellipticCurve(f,h);
J:= Jacobian(C);

U1 := R!x^2+4;
V1 := R!3*x;
U2 := R!x^2+4;
V2 := R!2*x+1;
D1 := J![U1,V1];
D2 := J![U2,V2];
un2,un1,un0,vn1,vn0 := ADD(U1,V1,U2,V2,f,h);
nU:= R! un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! vn1*x^1 + vn0*x^0;
Cantor:= D1 + D2;
assert (un2*x^2 + un1*x^1 + un0*x^0) eq Cantor[1] and (vn1*x^1 + vn0*x^0) eq Cantor[2];


