clear;
///////////////////////////////////////////////////////////////////////////////
/////// TESTING RAMIFIED MODEL DIVISOR ARITHMETIC OVER CHAR TWO FIELDS ////////
///////////////////////////////////////////////////////////////////////////////
//
// Sebastian Lindner, 2019
//-----------------------------------------------------------------------------
// OVERVIEW
//-----------------------------------------------------------------------------
// This script tests divisor arithmetic functions from ch2_ramifiedG2_DBL.mag, 
// and ch2_ramifiedG2_ADD.mag.
//
///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////
//LOAD FILES
///////////////////////////////////////////////////////////////////////////////
DBL_DEBUG:= false;
ADD_DEBUG:= false;
load "ramifiedUtilities.mag";
load "g2Formulas/ch2_ramifiedG2_DBL.mag";
load "g2Formulas/ch2_ramifiedG2_ADD.mag";
"     ";

///////////////////////////////////////////////////////////////////////////////
//GLOBAL TESTING VARIABLES
///////////////////////////////////////////////////////////////////////////////
//Field sizes below 32 for random testing
FIELDS:= {2,4,8,16,32};
DIVISORS:= 500; //Number of divisor additions and doubling to test per curve
TRIALS:= #FIELDS;
DEBUG:= false;
TEST_DBL:= true;
TEST_ADD:= true;


///////////////////////////////////////////////////////////////////////////////
//REPRODUCIBILITY
///////////////////////////////////////////////////////////////////////////////
// These testers never set or reported a seed, so a failure in a rarely-drawn
// branch could not be replayed -- and a failure you cannot replay is a failure
// you cannot diagnose. The seed and step are printed in the banner below;
// RND_SEED=<n> reruns that draw sequence exactly.
if GetEnv("RND_SEED") ne "" then
    SetSeed(StringToInteger(GetEnv("RND_SEED")));
end if;

/////////////////////////////////////////////////////////
///////////////////// TEST LOOPS ////////////////////////
/////////////////////////////////////////////////////////

printf "///////////////////////////////////////////////////////////////////////\n";
printf "//\n";
printf "// - Small finite field and curve picked at random for each trial. \n";
printf "// - %o total trials.            \n", TRIALS;
printf "// - %o divisor additions and doubles each per trial.            \n", DIVISORS;
sd, st:= GetSeed();
printf "// - Random seed %o, step %o. Replay this run with RND_SEED=%o\n", sd, st, sd;
printf "//";
trial:=1;
errorFlag:= false;
nCmp:= 0;
for F in FIELDS do
  printf "\n//    Trail # %o over FF(%o).", trial, F;
  trial+:=1;
  // Random finite field FF and polynomial ring over FF
  FF:=GF(F);
  R<x>:=PolynomialRing(FF);

  f,h:= RandomG2Char2Curve(F);
  C:= HyperellipticCurve(f,h);
  Jac:= Jacobian(C);

  if DEBUG then
    "\n";
    FF, "f is: ", f, "h is: ", h;
    " ";
  end if;

  divisor:= 0;
  while divisor le DIVISORS do
    divisor+:=1;

    /////////////////////////////////////////////////////
    ///RANDOM DIVISORS
    /////////////////////////////////////////////////////
    D1:= Random(Jac);
    if DEBUG then
      "Divisor D1 is: ", D1;
    end if;
    u1:= D1[1];
    v1:= D1[2];

    D2:= Random(Jac);
    if DEBUG then
      "Divisor D2 is: ", D2;
    end if;
    u2:= D2[1];
    v2:= D2[2];

    
    /////////////////////////////////////////////////////
    ///TEST FORMULAS ON DIVISORS
    /////////////////////////////////////////////////////
    if DEBUG then "  "; end if;
    if TEST_DBL then
      un2,un1,un0,vn1,vn0 := DBL(u1,v1,f,h);
      nCmp+:= 1;
      cantor:= D1 + D1;
      if (un2*x^2 + un1*x + un0) ne cantor[1] or (vn1*x + vn0) ne cantor[2] then
        printf "//     Doubling %o failed over finite field FF(%o) where f = %o and h = %o \n", D1, F, f, h;
        errorFlag:= true;
      end if;
    end if;

    if TEST_ADD then
      if D1 ne D2 then
        un2,un1,un0,vn1,vn0 := ADD(u1,v1,u2,v2,f,h);
        nCmp+:= 1;
        cantor:= D1 + D2;
        if (un2*x^2 + un1*x + un0) ne cantor[1] or (vn1*x + vn0) ne cantor[2] then
          printf "//     Adding %o with %o failed over finite field FF(%o) where f = %o and h = %o \n", D1, D2, F, f, h;
          errorFlag:= true;
        end if; 
      end if;
    end if;     
  end while; 
end for;
printf "\n//";
// E12: a tester that loaded nothing used to print the same green
// summary as one that verified everything, because TEST_ADD/TEST_DBL
// are configuration switches and "No errors." is true by vacuity.
// The count makes an empty run loud, and the assert makes it fatal:
// test_all.sh greps for "Runtime error|Assertion failed".
printf "\n// Comparisons: %o", nCmp;
assert nCmp gt 0;
if errorFlag then
  printf "\n// Errors occured.";
else
  printf "\n// No errors.";
end if;
printf "\n//";
printf "\n///////////////////////////////////////////////////////////////////////\n";
quit;
