///////////////////////////////////////////////////////////////////////////////
// Author: Randall Apperley, Amir Asgari, Sebastian Lindner                                                       
//
// Description: Explicit divisor addition formulas for the 4 coordinate
//              Mumford representation over arbitrary fields where:
//
//              h(x) = h3*x^3 + h2*x^2 + h1*x + h0 (h3 in {0,1}) and
//              f(x) = x^7 + f6x^6 + f5x^5 + f4x^4 + f3x^3 + f2x^2 + f1x + f0
//
//
// Precondition: the Deg* cases below assume D1 != D2 (the thesis Require
//               clause). The ADD dispatcher routes D1 = D2 to DBL, so callers
//               need not check; calling a Deg* case directly still requires it.
///////////////////////////////////////////////////////////////////////////////

//Must keep next line in this format for latex conversion
//Constant: f6,f5,f4,f3,f2,f1,f0,h2,h1,h0
//Ignore: h3

///////////////////////////////////////////////////////////////////////////////
// Deg1ADD():
// Input: u0, v0:   Mumford coordinates for degree 1 divisor D1
//        up0, vp0: Mumford coordinates for degree 1 divisor D2
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of two degree one
//              divisors. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg1ADD:= function(u0,v0,up0,vp0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    //No curve coefficients are needed: with u = up and D1 ne D2, the two
    //v values are the two roots of y^2 + h(x0)y = f(x0), so D2 = -D1 and
    //the sum is the neutral element.
    FF := Parent(u0);
    R<x> := PolynomialRing(FF);
    //f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x + f0;
    //h := h3*x^3 + h2*x^2 + h1*x + h0;
    u := x + u0;
    v := R!v0;
    up := x + up0;
    vp := R!vp0;
    Q := quo<R | up>;

    //Formulation
    d := u mod up;
    if IsZero(d) then
        return 0,0,0,1,0,0,0;
    end if;
    s := (vp - v)*R!(Q!d^-1) mod up;
    upp := u*up;
    vpp := (v + u*s) mod upp;
    return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    */ //endIGNORE
    
    //d := u mod up;
    d:= u0 - up0;
    if IsZero(d) then

		if ADD_DEBUG then "Deg1ADD | Case #2: gcd(u,up) = u"; end if;
        return 0,0,0,1,0,0,0;
    end if;//d
    
    //s := (vp - v)*R!(Q!d^-1) mod up;
    w1 := d^-1;
    s0:= w1*(vp0 - v0);

    //upp := u*up;
    upp1:= u0 + up0;
    upp0:= u0*up0;

    //vpp := (v + u*s) mod upp;
    //vpp1:= s0;
    vpp0:= v0 + u0*s0;
    
	if ADD_DEBUG then "Deg1ADD | Typical"; end if;
    return 0, 1, upp1, upp0, 0, s0, vpp0;
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg12ADD():
// Input: u0, v0:   Mumford coordinates for degree 1 divisor D1
//        up1..vp0: Mumford coordinates for degree 2 divisor D2
//        f6..f2, h3..h0: curve coefficients
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of a degree one and a
//              degree two divisor. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg12ADD:= function(u0, v0, up1, up0, vp1, vp0, f6, f5, f4, f3, f2, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(up0);
    R<x> := PolynomialRing(FF);
    //f is truncated at the lowest coefficient this case needs: the omitted
    //coefficients have degree below the divisor's, so they fall in the
    //discarded remainder of every division here; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    up := x^2 + up1*x + up0;
    vp := vp1*x + R!vp0;
    u := x + u0;
    v := R!v0;
    Q := quo<R | u>;

    //Formulation
    d := up mod u;
    if IsZero(d) then
        dw := (h + v + vp) mod u;
        if IsZero(dw) then
            upp := ExactQuotient(up, u);
            vpp := vp mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        k := (f - vp*(vp + h)) div up;   //Exact quotient
        s := R!(Q!dw^-1)*k mod u;
        upp := up*u;
        vpp := (vp + up*s) mod upp;
        return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    end if;
    s := R!(Q!d^-1)*(v - vp) mod u;
    upp := up*u;
    vpp := (vp + up*s) mod upp;
    return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    */ //endIGNORE

    //d := up mod u;
    t0 := u0^2;
    t1 := u0*up1;
    d:= up0 - t1 + t0;
    if IsZero(d) then
        //dw := (h + v + vp) mod u;
        vh1:= h1 + vp1;
        dw:= h0 + vp0 + v0 - u0*(vh1 - h2*u0 + h3*t0);
        if IsZero(dw) then
            //upp := ExactQuotient(up, u);
            upp0:= up1 - u0;
            //vpp := vp mod upp;
            vpp0:= vp0 - vp1*upp0;

            if ADD_DEBUG then "Deg12ADD | Case #2.2: gcd(up,u) = u, gcd(u,h+v+vp) = u"; end if;
            return 0, 0, 1, upp0, 0, 0, vpp0;
        end if;//dw

        //k := (f - vp*(vp + h)) div up;
        //k5:= 1;
        k4:= f6 - up1;
        t2:= up1*k4;
        k3:= f5 - up0 - t2;
        t3:= up0*k3;
        k2:= f4 - h3*vp1 - (up0 + up1)*(k3 + k4) + t2 + t3;        // karatsuba
        k1:= f3 - h3*vp0 - h2*vp1 - t3 - up1*k2;
        k0:= f2 - h2*vp0 - vp1*vh1 - up0*k2 - up1*k1;

        //s := R!(Q!dw^-1)*k mod u;
        //sp5:= 1;
        sp4:= k4 - u0;
        sp3:= k3 - u0*sp4;
        sp2:= k2 - u0*sp3;
        sp1:= k1 - u0*sp2;
        sp0:= k0 - u0*sp1;
        w1 := dw^-1;
        s0:= w1*sp0;

        //upp := up*u;
        //upp3:= 1;
        upp2:= u0 + up1;
        upp1:= t1 + up0;
        upp0:= u0*up0;

        //vpp := (vp + up*s) mod upp;
        //vpp2:= s0;
        vpp1:= up1*s0 + vp1;
        vpp0:= up0*s0 + vp0;

        if ADD_DEBUG then "Deg12ADD | Case #2.1: gcd(up,u) = u, gcd(u,h+v+vp) = 1"; end if;
        return 1, upp2, upp1, upp0, s0, vpp1, vpp0;
    end if;//d

    //s := R!(Q!d^-1)*(v - vp) mod u;
    w1 := d^-1;
    s0:= w1*(v0 - vp0 + u0*vp1);

    //upp := up*u;
    //upp3:= 1;
    upp2:= u0 + up1;
    upp1:= t1 + up0;
    upp0:= u0*up0;

    //vpp := (vp + up*s) mod upp;
    //vpp2:= s0;
    vpp1:= up1*s0 + vp1;
    vpp0:= up0*s0 + vp0;

    if (ADD_DEBUG) then "Deg12ADD | Typical"; end if;
    return 1, upp2, upp1, upp0, s0, vpp1, vpp0;
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg22ADD():
// Input: u1..v0: Mumford coordinates for degree 2 divisor D1
//        up1..vp0: Mumford coordinates for degree 2 divisor D2
//        f6..f2, h3..h0: curve coefficients
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of two degree two
//              divisors. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg22ADD:= function(u1, u0, v1, v0, up1, up0, vp1, vp0, f6, f5, f4, f3, f2, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(u0);
    R<x> := PolynomialRing(FF);
    //f is truncated at the lowest coefficient this case needs: the omitted
    //coefficients have degree below the divisor's, so they fall in the
    //discarded remainder of every division here; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    u := x^2 + u1*x + u0;
    v := v1*x + R!v0;
    up := x^2 + up1*x + up0;
    vp := vp1*x + R!vp0;
    Q := quo<R | up>;

    //Formulation
    dw1 := u mod up;                    // = (a1^-1)*S for S,a1,b1 = XGCD(u,up);
    d := Resultant(u,up);               // computed with 2x2 system
    if IsZero(d) then
        if IsZero(dw1) then             //u = up
            dw2 := (h + v + vp) mod u;  // = (b2^-1)*S for S,a2,b2 = XGCD(u,h + v + vp);
            if IsZero(dw2) then         //vp = -v - h
                return 0,0,0,1,0,0,0;
            end if;
            k := (f - v*(v + h)) div u;   //Exact quotient
            b2 := LeadingCoefficient(dw2)^-1;
            u := ExactQuotient(u,dw2*b2);
            s := b2*k mod u;
            upp := u^2;
            vpp := (v + u*s) mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        a1 := LeadingCoefficient(dw1)^-1;
        S1 := dw1*a1;
        dw3 := (h + v + vp) mod S1;     // = (b2^-1)*S for S,a2,b2 = XGCD(S1,h + v + vp);
        if IsZero(dw3) then
            //S,a2,b2 := XGCD(S1,h + v + vp);
            //S1 = S, a2 = 1, b2 = 0;
            u := ExactQuotient(u,S1);
            up := ExactQuotient(up,S1);
            s := a1*(vp - v) mod up;
            upp := u*up;
            vpp := (v + u*s) mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        k := (f - v*(v + h)) div u;   //Exact quotient
        //S,a2,b2 := XGCD(S1,h + v + vp);
        //S := 1;
        b2 := FF!dw3^-1;
        t := (1 - b2*(h + v + vp)) mod up;
        a2 := ExactQuotient(t,S1);
        s := (a2*a1*(vp - v) + b2*k) mod up;
        //M1 := ExactQuotient(u*s-v+v,up); M2:=ExactQuotient(s*(h+v+vp)-k,up); upp:=-s*M1-M2;
        upp := ExactQuotient(-s*(s*u + 2*v + h) + k, up);
        upp := upp/LeadingCoefficient(upp);
        vpp := (-s*u - v - h) mod upp;
        return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    end if;
    s := R!(Q!dw1^-1)*(vp - v) mod up;
    k := (f - v*(v + h)) div u;   //Exact quotient
    //M1 := ExactQuotient(u*s-v+v,up); M2:=ExactQuotient(s*(h+v+vp)-k,up); upp:=-s*M1-M2;
    upp := ExactQuotient(-s*(s*u + 2*v + h) + k, up);
    upp := upp/LeadingCoefficient(upp);
    vpp := (-s*u - v - h) mod upp;
    return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    */ //endIGNORE

	h3Timesup1:= h3*up1;

	// vh = h + v
	vh1:= h1 + v1;
	vh0:= h0 + v0;

	// vt = vp - v
	vt1:= vp1 - v1;
	vt0:= vp0 - v0;

    // dw1 = u mod up
    dw11:= u1 - up1;
    dw10:= u0 - up0;

    // set up system of equations to solve for s = (vp-v)/u mod up
    // and find the determinant
    // from Lindner's MSc thesis (pages 63-64)
    m4:= dw10;
    m3:= -dw11;
    m2:= -up0*m3;
	m1:= m4 + up1*m3;

    det:= m4*m1 - m2*m3;

    // if gcd(u,up) != 1
    if (det eq 0) then

		// ht = vh + vp
		vpPlusvh1:= vh1 + vp1;
		vpPlusvh0:= vh0 + vp0;

        // if gcd(u,up) = up
        if (dw11 eq 0) then
			temp2:= h2 - h3Timesup1;

            // dw2 = (h + vp + v) mod up
            dw21:= vpPlusvh1 - h3*up0 - up1*temp2;
            dw20:= vpPlusvh0 - up0*temp2;

            // if gcd(up,h+vp+v) = up
            if (dw21 eq 0 and dw20 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u,up) = up
				// gcd(up,h+vp+v) = up
                // DB = P1-P2, DA = P2-P1
                // return P0

				if (ADD_DEBUG) then "Deg22ADD | Case #3.2: gcd(u,up) = up, gcd(up,h+vp+v) = up"; end if;
                return 0, 0, 0, 1, 0, 0, 0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u,up) = up	=> a1=0, b1=1
			// gcd(up,h+vp+v) = dw
            // DB = P1+P2, DA = P2-P1
            // return 2P2

			// w1 = (f - v*h - v^2)/u
			//k5:= 1;
			k4:= f6 - u1;
			ta:= u1*k4;
			k3:= f5 - u0 - ta;
			tb:= u0*k3;
			k2:= f4 - h3*v1 - (u0 + u1)*(k3 + k4) + ta + tb;		// karatsuba
			k1:= f3 - h3*v0 - h2*v1 - tb - u1*k2;
			k0:= f2 - h2*v0 - v1*vh1 - u0*k2 - u1*k1;

            // at = (  up^-1 mod h+vp+v   )*dw21
            //    = ( (-(h+vp+v)/up)/dw21  )*dw21
            //    = (          a2          )*dw21
            //at1:= -h3;
            //at0:= -temp2;

            // st = ((up^-1 mod h+vp+v)*dw21)*(u^-1 mod up)*(vp-v) + ((h+vp+v^-1 mod up)*dw21)*w1
            //    = ((       a2        )*dw21)*(     a1     )*( vt  ) + ((       b2        )*dw21)*w1
            //    = (           at          )*(     0      )*( vt  ) + (           1           )*w1
            //    = w1
            //st5:= 1;
            //st4:= k4;
            //st3:= k3;
            //st2:= k2;
            //st1:= k1;
            //st0:= k0;

            //dm = dw2/dw21	(dm = monic(dw2))
            dw21Inv:= 1/dw21;
            dm0:= dw20*dw21Inv;

            // u = u/dm
            u0:= u1 - dm0;

            // Reducing w1 here rather than st gives the same result at the same
            // cost -- the two differ by a multiple of u, which this reduction
            // removes. Measured: no change in any column. w1 is used because it
            // is already in hand.
            // sp = st mod u
            //sp5:= 1;
            sp4:= k4 - u0;
            sp3:= k3 - u0*sp4;
            sp2:= k2 - u0*sp3;
            sp1:= k1 - u0*sp2;
            sp0:= k0 - u0*sp1;

            // s = sp/dw21
            s0:= sp0*dw21Inv;

            // upp = u*up = u^2
            upp3:= 0;
            upp2:= 1;
            upp1:= u0 + u0;
            upp0:= u0^2;

            // vpp = (u*s + v) mod upp
            vpp2:= 0;
            vpp1:= s0 + v1;
            vpp0:= u0*s0 + v0;

			if (ADD_DEBUG) then "Deg22ADD | Case #3.1: gcd(u,up) = up, gcd(up,h+vp+v) = dw (deg 1)"; end if;
            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // dw3 = (h + vp + v) mod dw1
        dw11Sq:= dw11^2;
        dw30:= dw11Sq*(dw11*vpPlusvh0 - dw10*vpPlusvh1) + dw10^2*(h2*dw11 - h3*dw10);		//dw11^3

        // if gcd(dw1,h+vp+v) = dw1
        if (dw30 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // S = gcd(u,up) = dw1, actually the monic of the latter
              // a1 = lcf(dw1)^-1 = u^-1 mod up
			// S' = gcd(dw1,h+vp+v) = monic(dw1)
            // DB = P1+P2, DA = P3-P1
            // return P2+P3

            // dm = monic(dw1) = dw1/dw11
            dw11Inv:= 1/dw11;
            // dm1 = 1
        	dm0:= dw10*dw11Inv;

            // u = u/dm
            u0:= u1 - dm0;
            // up = up/dm
            up0:= up1 - dm0;

            // s = vt/u mod up
            s0:= (vt0 - up0*vt1)*dw11Inv;

            // upp = up*u
            upp3:= 0;
            upp2:= 1;
            upp1:= up0 + u0;
            upp0:= up0*u0;

            // vpp = (u*s + v) mod upp
            vpp2:= 0;
            vpp1:= s0 + v1;
            vpp0:= u0*s0 + v0;

			if (ADD_DEBUG) then "Deg22ADD | Case #2.2: gcd(u,up) = d (deg 1), gcd(d,h+vp+v) = d"; end if;
            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u,up) = dw1
		// gcd(dw1,h+vp+v) = 1
        // DB = P1+P2, DA = P1+P3
        // return 2P1+P2+P3

        // w1 = (f - v*h - v^2)/u
        //k5:= 1;
        k4:= f6 - u1;
		ta:= u1*k4;
        k3:= f5 - u0 - ta;
		tb:= u0*k3;
        k2:= f4 - h3*v1 - (u0 + u1)*(k3 + k4) + ta + tb;		// karatsuba
        k1:= f3 - h3*v0 - h2*v1 - tb - u1*k2;
        k0:= f2 - h2*v0 - v1*vh1 - u0*k2 - u1*k1;

        // a1 = u^-1 mod up
        //    = 1/dw11
        w0:= 1/(dw30*dw11);
        a1:= dw30*w0;            // (dw30)/(dw30*dw11) = 1/dw11

        // b2 = h+vp+v^-1 mod dw1
        //    = 1/dw30 (or dw11^3 / dw30?)
        b2:= (dw11Sq^2)*w0;

        // dm = dw1/dw11 = monic(dw1)
        //dm1:= 1;
        dm0:= dw10*a1;            // dw10/dw11

        // vp = a1*vt
        t18:= a1*vt1;
        t19:= a1*vt0;

        // at = ( dm^-1 mod h+vp+v )*dw30
        //    = ((-(h+vp+v)/dm)/dw30)*dw30
        //    = (        a2         )*dw30
        //    = -(h + vp + v)/dm
        //at2:= -h3;
        at1:= -h2 + h3*dm0;
        at0:= -vpPlusvh1 - dm0*at1;

        // st = (( dm^-1 mod h+vp+v)*dw30)*((u^-1 mod up)*(vp-v)) + ((h+vp+v^-1 mod dm)*dw30)*w1
        //    = ((        a2        )*dw30)*((     a1     )*(vp-v)) + (         b2       )*dw30)*w1
        //    = (           at           )*(          vp          ) + (           1           )*w1
        //    = w1 + at*vp
        ta:= at1*t18;
        tb:= at0*t19;

        //st5:= 1;
        //st4:= k4;
        st3:= k3 - h3*t18;
        st2:= k2 - h3*t19 + ta;
        st1:= k1 + (at0 + at1)*(t18 + t19) - ta - tb;		// karatsuba
        st0:= k0 + tb;

        // sp = st mod up
        //sp5:= 1;
        sp4:= k4 - up1;
		temp3:= up1*sp4;
        sp3:= st3 - up0 - temp3;
        ta:= up0*sp3;
        sp2:= st2 - (up0 + up1)*(sp3 + sp4) + temp3 + ta;     // karatsuba
        sp1:= st1 - ta - up1*sp2;
        sp0:= st0 - up0*sp2;

        // s = sp/dw30
        s1:= sp1*b2;
        s0:= sp0*b2;

        // upp = (w1 - s*(h + 2*v + u*s))/up
		ta:= u1*s0;
        temp4:= vh1 + u0*s1 + ta;
		temp5:= h2 + s0;

        upp3:= 1;
        upp2:= sp4 - h3*s1 - s1^2;
        upp1:= k3 - up0 - h3*s0 - s1*(s1*dw11 + s0 - h3Timesup1 + temp5) - temp3;
        upp0:= k2 - up0*upp2 - up1*upp1 - s0*temp5 - s1*(v1 + ta + temp4);

        // vpp = -h - v - u*s mod upp
        ta:= h3 + s1;

        vpp2:= s1*(upp2 - u1) + h3*upp2 - temp5;
        vpp1:= upp1*ta - temp4;
        vpp0:= upp0*ta - vh0 - u0*s0;

		if (ADD_DEBUG) then "Deg22ADD | Case #2.1: gcd(u,up) = d (deg 1), gcd(d,h+vp+v) = 1"; end if;
        return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(u,up) = 1
    // DB = P1+P2, DA = P3+P4
    // return P1+P2+P3+P4

    // w1 = (f - v*h - v^2)/u
    //k5:= 1;
    k4:= f6 - u1;
    k3:= f5 - u0 - u1*k4;
    k2:= f4 - h3*v1 - u0*k4 - u1*k3;

    // partially solve system to get sp = s*det
    // from Lindner's MSc thesis (pages 63-64)
    sp1:= vt1*m4 + vt0*m3;
    sp0:= vt0*m1 + vt1*m2;

    detInv:= 1/det;

    // s = sp/det
    s1:= sp1*detInv;
    s0:= sp0*detInv;

    // upp = (w1 - s*(h + 2*v + u*s))/up
    //	Because deg(w1)=5 and deg(s*(h + 2*v + u*s))=4 and w1 is already monic,
    //	lcf(s)=s1 has no role in lcf of the numerator of upp above; so, unlike
    //	Lindner's formulas for genus 2, there's no need to compute lcf(s)^-1=1/s1
    //	and the monic version of s.
    ta:= k4 - up1;
    tb:= u1*s0;
    temp2:= vh1 + u0*s1 + tb;
	temp3:= h2 + s0;

    upp3:= 1;
    upp2:= ta - h3*s1 - s1^2;
    upp1:= k3 - up0 - h3*s0 - s1*(s1*dw11 + s0 - h3Timesup1 + temp3) - up1*ta;
    upp0:= k2 - up0*upp2 - up1*upp1 - s0*temp3 - s1*(v1 + tb + temp2);

    // vpp = -h - v - u*s mod upp
    ta:= h3 + s1;

    vpp2:= s1*(upp2 - u1) + h3*upp2 - temp3;
    vpp1:= upp1*ta - temp2;
    vpp0:= upp0*ta - vh0 - u0*s0;

	if (ADD_DEBUG) then "Deg22ADD | Typical"; end if;
    return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg13ADD():
// Input: u0, v0:   Mumford coordinates for degree 1 divisor D1
//        up2..vp0: Mumford coordinates for degree 3 divisor D2
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of a degree one and a
//              degree three divisor. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg13ADD:= function(u0, v0, up2, up1, up0, vp2, vp1, vp0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(up0);
    R<x> := PolynomialRing(FF);
    //f is truncated at the lowest coefficient this case needs: the omitted
    //coefficients have degree below the divisor's, so they fall in the
    //discarded remainder of every division here; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    up := x^3 + up2*x^2 + up1*x + up0;
    vp := vp2*x^2 + vp1*x + vp0;
    u := x + u0;
    v := R!v0;
    Q := quo<R | u>;

    //Formulation
    d := up mod u;                  //u is linear, so this is the resultant
    if IsZero(d) then
        dw := (h + v + vp) mod u;   // = (b2^-1)*S for S,a2,b2 = XGCD(u,h + v + vp);
        if IsZero(dw) then          //v = -vp - h at the point of u
            upp := ExactQuotient(up,u);
            vpp := vp mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        k := (f - vp*(vp + h)) div up;   //Exact quotient
        s := k*R!(Q!dw^-1) mod u;
        //M1 := ExactQuotient(up*s-v+vp,u); M2:=ExactQuotient(s*(h+v+vp)-k,u); upp:=-s*M1-M2;
        upp := ExactQuotient(-s*(up*s + 2*vp + h) + k, u);
        upp := upp/LeadingCoefficient(upp);
        vpp := (-up*s - vp - h) mod upp;
        return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    end if;
    s := R!(Q!d^-1)*(v - vp) mod u;
    k := (f - vp*(vp + h)) div up;   //Exact quotient
    //M1 := ExactQuotient(up*s-v+vp,u); M2:=ExactQuotient(s*(h+v+vp)-k,u); upp:=-s*M1-M2;
    upp := ExactQuotient(-s*(up*s + 2*vp + h) + k, u);
    upp := upp/LeadingCoefficient(upp);
    vpp := (-up*s - vp - h) mod upp;
    return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    */ //endIGNORE

	// vh = h + vp
	vh2:= h2 + vp2;
	vh1:= h1 + vp1;
	vh0:= h0 + vp0;

	temp1:= h3*u0 - vh2;

    // dw1 = up mod u
	temp2:= up2 - u0;
    temp3:= up1 - u0*temp2;

    dw10:= up0 - u0*temp3;

    // if gcd(up,u) = u
    if (dw10 eq 0) then

        // dw2 = (h + v + vp) mod u
        dw20:= vh0 + v0 - u0*(vh1 + u0*temp1);

        // if gcd(u,h+v+vp) = u
        if (dw20 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(up,u) = u
            // DB = P1, DA = P2-P1+P3
            // return P2+P3

            // upp = up/u
            upp3:= 0;
            upp2:= 1;
            upp1:= temp2;
            upp0:= temp3;

            // vpp = vp mod upp
            vpp2:= 0;
            vpp1:= vp1 - upp1*vp2;
            vpp0:= vp0 - upp0*vp2;

            if (ADD_DEBUG) then "Deg13ADD: gcd(up,u) = u, DB = P1, DA = P2-P1+P3"; end if;
            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(up,u) = u
        // DB = P1, DA = P1+P2+P3
        // return 2P1+P2+P3

        // w1 = (f - vp*h - vp^2)/up
        //k4:= 1;
        k3:= f6 - up2;
		ta:= up2*k3;
        k2:= f5 - up1 - h3*vp2 - ta;
		tb:= up1*k2;
        k1:= f4 - up0 - h3*vp1 - vp2*vh2 - (up1 + up2)*(k2 + k3) + ta + tb;		// karatsuba
        k0:= f3 - h3*vp0 - vp1*vh2 - vp2*vh1 - up0*k3 - tb - up2*k1;

        // s = (u^-1 mod h+v+vp)*(up^-1 mod u)*(v-vp) + (h+v+vp^-1 mod u)*w1 mod u
        //   = (       a2        )*(     a1     )*(v-vp) + (        b2       )*w1 mod u
        //   = (       a2        )*(     0      )*(v-vp) + (       1/dw2      )*w1 mod u
        //   = w1/dw2 mod u
		temp4:= k3 - u0;
		temp5:= k2 - u0*temp4;

        s0:= (k0 - u0*(k1 - u0*temp5))/dw20;
        s0Timesup1 := s0*up1;

        // upp = (w1 - s*(h + 2*vp + up*s))/u
        upp3:= 1;
        upp2:= temp4 - h3*s0 - s0^2;
        upp1:= temp5 - s0*(s0*temp2 - temp1 + vp2);
        upp0:= k1 - s0*(s0Timesup1 + vh1 + vp1) - u0*upp1;


        // vpp = -h - vp - up*s mod upp
        s0Plush3 := s0 + h3;
        vpp2:= s0Plush3*upp2 - s0*up2 - vh2;
        vpp1:= s0Plush3*upp1 - s0Timesup1 - vh1;
        vpp0:= s0Plush3*upp0 - s0*up0 - vh0;

        if (ADD_DEBUG) then "Deg13ADD: gcd(up,u) = u, DB = P1, DA = P1+P2+P3"; end if;
        return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(up,u) = 1
    // DB = P1, DA = P2+P3+P4
    // return P1+P2+P3+P4

    // w1 = (f - vp*h - vp^2)/up
    //k4:= 1;
    k3:= f6 - up2;
    k2:= f5 - up1 - h3*vp2 - up2*k3;
    k1:= f4 - up0 - h3*vp1 - vp2*vh2 - up1*k3 - up2*k2;

    // s = (v - vp)/up mod u
    s0:= (v0 - vp0 + u0*(vp1 - u0*vp2))/dw10;

    // upp = (w1 - s*(h + 2*vp + up*s))/u
	ta:= k3 - u0;
    s0Timesup1 := s0*up1;

    upp3:= 1;
    upp2:= ta - h3*s0 - s0^2;
    upp1:= k2 - s0*(s0*temp2 - temp1 + vp2) - u0*ta;
    upp0:= k1 - s0*(s0Timesup1 + vh1 + vp1) - u0*upp1;

    // vpp = -h - vp - up*s mod upp
    s0Plush3 := s0 + h3;
    vpp2:= s0Plush3*upp2 - s0*up2 - vh2;
    vpp1:= s0Plush3*upp1 - s0Timesup1 - vh1;
    vpp0:= s0Plush3*upp0 - s0*up0 - vh0;

    if (ADD_DEBUG) then "Deg13ADD: Typical"; end if;
    return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg23ADD():
// Input: u1..v0: Mumford coordinates for degree 2 divisor D1
//        up2..vp0: Mumford coordinates for degree 3 divisor D2
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of a degree two and a
//              degree three divisor. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg23ADD:= function(u1, u0, v1, v0, up2, up1, up0, vp2, vp1, vp0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(up0);
    R<x> := PolynomialRing(FF);
    //f is truncated at the lowest coefficient this case needs: the omitted
    //coefficients have degree below the divisor's, so they fall in the
    //discarded remainder of every division here; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    up := x^3 + up2*x^2 + up1*x + up0;
    vp := vp2*x^2 + vp1*x + vp0;
    u := x^2 + u1*x + u0;
    v := v1*x + R!v0;
    Q := quo<R | u>;

    //Formulation
    d := Resultant(up,u);               // computed with 2x2 system
    if IsZero(d) then
        dw1 := up mod u;                // = (a1^-1)*S for S,a1,b1 = XGCD(up,u);
        if IsZero(dw1) then             //u divides up
            dw2 := (h + v + vp) mod u;  // = (b2^-1)*S for S,a2,b2 = XGCD(u,h + v + vp);
            dw := Resultant(u,h + v + vp);
            if IsZero(dw) then
                if IsZero(dw2) then     //-D1 sits inside D2
                    upp := ExactQuotient(up,u);
                    vpp := vp mod upp;
                    return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
                end if;
                k := (f - vp*(vp + h)) div up;   //Exact quotient
                b2 := LeadingCoefficient(dw2)^-1;
                S := dw2*b2;
                up := ExactQuotient(up,S);
                u := ExactQuotient(u,S);
                s := b2*k mod u;
                upp := up*u;
                vpp := (vp + up*s) mod upp;
                return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
            end if;
            k := (f - vp*(vp + h)) div up;   //Exact quotient
            b2 := R!(Q!dw2^-1);
            s := b2*k mod u;
            //M1 := ExactQuotient(up*s-v+vp,u); M2:=ExactQuotient(s*(h+v+vp)-k,u); upp:=-s*M1-M2;
            upp := ExactQuotient(-s*(s*up + 2*vp + h) + k, u);
            upp := upp/LeadingCoefficient(upp);
            vpp := (-s*up - vp - h) mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        a1 := LeadingCoefficient(dw1)^-1;
        S := dw1*a1;
        dw3 := (h + v + vp) mod S;      // = (b2^-1)*S for S,a2,b2 = XGCD(S,h + v + vp);
        if IsZero(dw3) then
            //S1,a2,b2 := XGCD(S,h + v + vp);
            //S1 = S, a2 = 1, b2 = 0;
            up := ExactQuotient(up,S);
            u := ExactQuotient(u,S);
            s := a1*(v - vp) mod u;
            upp := up*u;
            vpp := (vp + up*s) mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        //S1,a2,b2 := XGCD(S,h + v + vp);
        //S1 = 1;
        k := (f - vp*(vp + h)) div up;   //Exact quotient
        b2 := FF!dw3^-1;
        t := (1 - b2*(h + v + vp)) mod u;
        a2 := ExactQuotient(t,S);
        s := (a2*a1*(v - vp) + b2*k) mod u;
        //M1 := ExactQuotient(up*s-v+vp,u); M2:=ExactQuotient(s*(h+v+vp)-k,u); upp:=-s*M1-M2;
        upp := ExactQuotient(-s*(s*up + 2*vp + h) + k, u);
        upp := upp/LeadingCoefficient(upp);
        vpp := (-s*up - vp - h) mod upp;
        return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    end if;//d
    s := R!(Q!up^-1)*(v - vp) mod u;
    k := (f - vp*(vp + h)) div up;   //Exact quotient
    //M1 := ExactQuotient(up*s-v+vp,u); M2:=ExactQuotient(s*(h+v+vp)-k,u); upp:=-s*M1-M2;
    upp := ExactQuotient(-s*(s*up + 2*vp + h) + k, u);
    upp := upp/LeadingCoefficient(upp);
    vpp := (-s*up - vp - h) mod upp;
    return Coeff(upp,3), Coeff(upp,2), Coeff(upp,1), Coeff(upp,0),
           Coeff(vpp,2), Coeff(vpp,1), Coeff(vpp,0);
    */ //endIGNORE

	temp1:= h3*u1;

	// vh = h + vp
	vh2:= h2 + vp2;
	vh1:= h1 + vp1;
	vh0:= h0 + vp0;

	// vt = v - vp
	//vt2:= 0 - vp2 = -vp2;
	vt1:= v1 - vp1;
	vt0:= v0 - vp0;

    // dw1 = up mod u
    temp2:= u1 - up2;
	temp3:= u1^2 - u0;

    dw11:= up1 - u1*up2 + temp3;
    dw10:= up0 + u0*temp2;

    // set u system of equations to solve for s = (v-vp)/up mod u
    // and find the determinant
    // from Lindner's MSc thesis (pages 63-64)
    m4:= dw10;
    m3:= -dw11;
    m2:= -u0*m3;
    m1:= m4 + u1*m3;

    det:= dw10*m1 + m2*dw11;

    // if gcd(up,u) != 1
    if (det eq 0) then

		// ht = vh + v
		ht1:= vh1 + v1;
		ht0:= vh0 + v0;

        // if gcd(up,u) = u
        if (dw11 eq 0) then

            // dw2 = (h + v + vp) mod u
            ta:= temp1 - vh2;

            dw21:= ht1 - h3*u0 + u1*ta;
            dw20:= ht0 + u0*ta;

            // if gcd(u,h+v+vp) = u
            if (dw21 eq 0 and dw20 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(up,u) = u
                // DB = P1+P2, DA = P3-P1-P2
                // return P3

                // upp = up/u
                upp3:= 0;
                upp2:= 0;
                upp1:= 1;
                upp0:= -temp2;

                // vpp = vp mod upp
                vpp2:= 0;
                vpp1:= 0;
                vpp0:= vp0 - upp0*(vp1 - vp2*upp0);

                if (ADD_DEBUG) then "Deg23ADD: gcd(up,u) = u, DB = P1+P2, DA = P3-P1-P2"; end if;
                return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

			// w1 = (f - vp*h - vp^2)/up
			//k4:= 1;
			k3:= f6 - up2;
			ta:= up2*k3;
			k2:= f5 - up1 - h3*vp2 - ta;
			tb:= up1*k2;
			k1:= f4 - up0 - h3*vp1 - vp2*vh2 - (up1 + up2)*(k2 + k3) + ta + tb;		// karatsuba
			k0:= f3 - h3*vp0 - vp1*vh2 - vp2*vh1 - up0*k3 - tb - up2*k1;

            // dx = u mod dw2
            dx0:= u0*dw21^2 + dw20*(dw20 - u1*dw21);        // w(dx0) = dw21^2

            // if gcd (u,h+v+vp) = dw2
            if (dw21 ne 0 and dx0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(up,u) = u
                // DB = P1+P2, DA = P2-P1+P3
                // return 2P2+P3

                // dm = dw2/dw21, dw21Inv = 1/dw21
                dw21Inv:= 1/dw21;
                dm0:= dw20*dw21Inv;

                // u = u/dm
                u0:= u1 - dm0;

                // up = up/dm
                ta:= up2 - dm0;

                up0:= up1 - dm0*ta;
                up1:= ta;

                // s = (u^-1 mod h+v+vp)*(up^-1 mod u)*(v-vp) + (h+v+vp^-1 mod u)*w1 mod u
                //   = (       a2        )*(     a1     )*(v-vp) + (        b2       )*w1 mod u
                //   = (       a2        )*(     0      )*(v-vp) + (      1/dw21      )*w1 mod u
                //   = w1/dw2 mod u
                s0:= ((((u0 - k3)*u0  + k2)*u0 - k1)*u0 + k0)*dw21Inv;

                // upp = u*up
                upp3:= 1;
                upp2:= u0 + up1;
                upp1:= u0*up1 + up0;
                upp0:= u0*up0;

                // vpp = (up*s + vp) mod upp
                vpp2:= s0 + vp2;
                vpp1:= up1*s0 + vp1;
                vpp0:= up0*s0 + vp0;

                if (ADD_DEBUG) then "Deg23ADD: gcd(up,u) = u, DB = P1+P2, DA = P2-P1+P3"; end if;
                return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // kp = k mod u
            kp3:= k3 - u1;
			ta:= u1*kp3;
            kp2:= k2 - ta - u0;
            tb:= u0*kp2;
            kp1:= k1 - (u0 + u1)*(kp2 + kp3) + ta + tb;		// karatsuba
            kp0:= k0 - tb;

            // bt = (h+v+vp^-1 mod u)*dx
            //    = (   -(u/dw2)/dx   )*dx
            //    = (       b2        )*dx
            //    = -(u/dw2)
            bt1:= -dw21;                 // w(bt) = dw21^2
            bt0:= dw20 - u1*dw21;

            // sp = (u^-1 mod h+v+vp)*(up^-1 mod u)*(v-vp) + (h+v+vp^-1 mod u)*dx*w1 mod u
            //    = (       a2        )*(     a1     )*(v-vp) + (        b2       )*dx*w1 mod u
            //    = (       a2        )*(     0      )*(v-vp) + (         bt         )*(  w1R  ) mod u
            //    = bt*w1R mod u
            ta:= bt1*kp1;
            tb:= bt0*kp0;

            //sp2:= ta;				// w(sp) = w(bt)*w(w1R) = w(bt) = dw21^2
            sp1:= (bt1 + bt0)*(kp1 + kp0) - ta - tb - u1*ta;		// karatsuba
            sp0:= tb - u0*ta;

            if (sp1 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(up,u) = u
                // DB = P1+P2, DA = P1+P2+P3

                // s = sp/dx0
                s0:= sp0/dx0;

                // upp = (w1 - s*(h + 2*vp + up*s))/u
                upp3:= 0;
                upp2:= 1;
                upp1:= kp3 - h3*s0 - s0^2;
                upp0:= kp2 + s0*(temp1 + s0*temp2 - vh2 - vp2);

                // vpp = -h - vp - up*s mod upp
                ta:= up2 - upp1;
                tb:= vh2 - h3*upp1;

                vpp2:= 0;
                vpp1:= s0*(upp1*ta - up1 + upp0) + upp1*tb + h3*upp0 - vh1;
                vpp0:= s0*(upp0*ta - up0) + upp0*tb - vh0;

                if (ADD_DEBUG) then "Deg23ADD: gcd(up,u) = u, DB = P1+P2, DA = P1+P2+P3, deg(s) = 0"; end if;
                return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(up,u) = u
            // DB = P1+P2, DA = P1+P2+P3

            // s = sp/dx, s1Inv = 1/s1
            w1:= 1/(sp1*dx0);       // because sp and dx have weights: 1/(sp1*dx0*dw21^4)
            w2:= dx0*w1;            // (dx0*dw21^2)/(sp1*dx0*dw21^4) = 1/(sp1*dw21^2)
            s1Inv:= dx0*w2;            // (dx0*dw21^2)/(sp1*dw21^2) = dx0/sp1 = 1/s1

            sm0:= sp0*w2;           // (sp0*dw21^2)/(sp1*dw21^2) = sp0/sp1 = s0/s1
            s1:= sp1^2*w1;          // (sp1^2*dw21^4)/(sp1*dx0*dw21^4) = sp1/dx0 = s1

            // upp = (w1 - s*(h + 2*vp + up*s))/u (made monic)
            temp4:= sm0*up2;
			ta:= up1 + temp4;
			tb:= vh2 + vp2;

			upp3:= 1;
			upp2:= h3*s1Inv - temp2 + sm0 + sm0 - s1Inv^2;
			upp1:= ta - u0 - u1*upp2 + temp4 + sm0^2 + (tb + h3*sm0 - k3*s1Inv)*s1Inv;
			upp0:= up0 - u1*upp1 - u0*upp2 + sm0*(up1 + ta) + (vh1 + vp1 + sm0*tb - k2*s1Inv)*s1Inv;

            // vpp = -h - vp - up*s mod upp
            ta:= up2 - upp2;
            tb:= up1 - upp1;
            tc:= up0 - upp0;

            vpp2:= s1*(upp2*(ta + sm0) - temp4 - tb) - vh2 + h3*upp2;
            vpp1:= s1*(upp1*ta - sm0*tb - tc) - vh1 + h3*upp1;
            vpp0:= s1*(upp0*ta - sm0*tc) - vh0 + h3*upp0;

            if (ADD_DEBUG) then "Deg23ADD: gcd(up,u) = u, DB = P1+P2, DA = P1+P2+P3, deg(s) = 1"; end if;
            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;
        // gcd(up,u) = dw1

        // dw3 = (h + v + vp) mod dw1
        temp4:= dw11^2;
        temp5:= dw11*temp4;
        temp6:= dw11*vh2 - dw10*h3;       //dw11 ?
        temp7:= temp4*ht1 - dw10*temp6;		//dw11^2 ?

        dw30:= temp5*ht0 - dw10*temp7;     // w(dw3) = dw11^3

        // if gcd(dw1,h+v+vp) = dw1
        if (dw30 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(up,u) = dw1
            // DB = P1+P2, DA = P3-P1+P4
            // return return P2+P3+P4

            // dw11Inv:= 1/dw11
            dw11Inv:= 1/dw11;

            // dm = dw1/dw11
        	// dm1:= 1
            dm0:= dw10*dw11Inv;

            // u = u/dm
            u0:= u1 - dm0;

            // up = up/dm
            ta:= up2 - dm0;

            up0:= up1 - dm0*ta;
            up1:= ta;

            // v = (v - vp) mod u
            //t22:= -vp2;
            t21:= vt1 + u0*vp2;
            t20:= vt0 - u0*t21;

            // s = (dw1^-1 mod h+v+vp)*(up^-1 mod u)*(v-vp) + (h+v+vp^-1 mod dw1)*w1 mod u
            //   = (       a2       )*(     a1     )*(v-vp) + (       b2       )*w1 mod u
            //   = (       1        )*(    1/dw11    )*(v-vp) + (       0        )*w1 mod u
            //   = a1*v
            s0:= dw11Inv*t20;

            // upp = u*up
            upp3:= 1;
            upp2:= u0 + up1;
            upp1:= u0*up1 + up0;
            upp0:= u0*up0;

            // vpp = (up*s + vp) mod upp
            vpp2:= s0 + vp2;
            vpp1:= up1*s0 + vp1;
            vpp0:= up0*s0 + vp0;

            if (ADD_DEBUG) then "Deg23ADD: gcd(up,u) = dw1, DB = P1+P2, DA = P3-P1+P4"; end if;
            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

		// w1 = (f - vp*h - vp^2)/up
		//k4:= 1;
		k3:= f6 - up2;
		ta:= up2*k3;
		k2:= f5 - up1 - h3*vp2 - ta;
		tb:= up1*k2;
		k1:= f4 - up0 - h3*vp1 - vp2*vh2 - (up1 + up2)*(k2 + k3) + ta + tb;		// karatsuba
		k0:= f3 - h3*vp0 - vp1*vh2 - vp2*vh1 - up0*k3 - tb - up2*k1;

        // at = ( dw1^-1 mod h+v+vp )*(up^-1 mod u)*dw30
        //    = (        a2        )*( a1  )*dw30
        //    = ((-(h+v+vp)/dw1)/dw30)*(1/dw11 )*dw30
        //    = (-(h+v+vp)/dw1)/dw11
        at2:= -h3*temp4; // w(at) = dw11^2; but why? Seemingly it should be dw11^4 since deg(h+v+vp)-deg(dw1)+1 = 3-1+1 = 3 and there's an extra div by dw11 above.
        at1:= -temp6*dw11;
        at0:= -temp7;

        // z = at*vt
        ta:= at1*vt1;       // w(z) = w(at)*w(vt) = dw11^2
        tb:= at0*vt0;

        z4:= -at2*vp2;
        z3:= (at1 + at2)*(vt1 - vp2) - z4 - ta;           	// karatsuba
        z2:= (at0 + at2)*(vt0 - vp2) - z4 + ta - tb;		// karatsuba
        z1:= (at0 + at1)*(vt0 + vt1) - ta - tb;           	// karatsuba
        z0:= tb;

        // sp = (dw1^-1 mod h+v+vp)*dw30*(up^-1 mod u)*(v-vp) + (h+v+vp^-1 mod dw1)*dw30*w1 mod u
        //    = (       a2       )*dw30*(     a1     )*( vt  ) + (       b2       )*dw30*w1 mod u
        //    = (       1        )*dw30*(    1/dw11    )*( vt  ) + (     1/dw30      )*dw30*w1 mod u
        //    = z + w1 mod u
        sp4:= z4 + temp5;                                             //dw11^2,dw11^3
        ta:= u1*sp4;                                               //dw11^2,dw11^3
        sp3:= z3 + k3*temp5 - ta;                                     //dw11^2,dw11^3
        tb:= u0*sp3;                                               //dw11^2,dw11^3
        sp2:= z2 + k2*temp5 - (u0 + u1)*(sp3 + sp4) + ta + tb;		//dw11^2,dw11^3 karatsuba
        sp1:= z1 + k1*temp5 - u1*sp2 - tb;                           //dw11^2,dw11^3
        sp0:= z0 + k0*temp5 - u0*sp2;                                //dw11^2,dw11^3

        if (sp1 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(up,u) = dw1
            // DB = P1+P2, DA = P1+P3+P4

            // s = sp/dw3
            s0:= sp0/dw30;       // (sp0*(z part is dw11^2 w1 part is dw11^3))/(dw30*dw11^3) = sp0/dw30 = s0

            // upp = (w1 - s*(h + 2*vp + up*s))/u
			upp3:= 0;
			upp2:= 1;
			upp1:= k3 - u1 - h3*s0 - s0^2;
			upp0:= k2 + s0*(temp1 + s0*temp2 - vh2 - vp2) + temp3 - u1*k3;

            // vpp = -h - vp - up*s mod upp
            ta:= up2 - upp1;
            tb:= vh2 - h3*upp1;

            vpp2:= 0;
            vpp1:= s0*(upp1*ta - up1 + upp0) + upp1*tb + h3*upp0 - vh1;
            vpp0:= s0*(upp0*ta - up0) + upp0*tb - vh0;

            if (ADD_DEBUG) then "Deg23ADD: gcd(up,u) = dw1, DB = P1+P2, DA = P1+P3+P4, deg(s) = 0"; end if;
            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(up,u) = dw1
        // DB = P1+P2, DA = P1+P3+P4
        // return 2P1+P2+P3+P4

        // s1Inv:= 1/s1, s = sp/dw2, sm = s/s1
                                // for sp*, z part is dw11^2 w1 part is dw11^3
        w1:= 1/(dw30*sp1);       // 1/(dw30*sp1*dw11^6)
        s1Inv:= dw30^2*w1;          // (dw30^2*dw11^6)/(dw30*sp1*dw11^6) = dw30/sp1 = 1/s1

        sm0:= dw30*sp0*w1;       // (dw30*sp0*dw11^6)/(dw30*sp1*dw11^6) = sp0/sp1 = s0/s1 = sm0
        s1:= sp1^2*w1;          // (sp1^2*dw11^6)/(dw30*sp1*dw11^6) = sp1/dw30 = s1

        // upp = (w1 - s*(h + 2*vp + up*s))/u (made monic)
        temp8:= sm0*up2;
		ta:= up1 + temp8;
		tb:= vh2 + vp2;

		upp3:= 1;
		upp2:= h3*s1Inv - temp2 + sm0 + sm0 - s1Inv^2;
		upp1:= ta - u0 - u1*upp2 + temp8 + sm0^2 + (tb + h3*sm0 - k3*s1Inv)*s1Inv;
		upp0:= up0 - u1*upp1 - u0*upp2 + sm0*(up1 + ta) + (vh1 + vp1 + sm0*tb - k2*s1Inv)*s1Inv;

        // vpp = -h - vp - up*s mod upp
        ta:= up2 - upp2;
        tb:= up1 - upp1;
        tc:= up0 - upp0;

        vpp2:= s1*(upp2*(ta + sm0) - temp8 - tb) - vh2 + h3*upp2;
        vpp1:= s1*(upp1*ta - sm0*tb - tc) - vh1 + h3*upp1;
        vpp0:= s1*(upp0*ta - sm0*tc) - vh0 + h3*upp0;

        if (ADD_DEBUG) then "Deg23ADD: gcd(up,u) = dw1, DB = P1+P2, DA = P1+P3+P4, deg(s) = 1"; end if;
        return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // w1 = (f - vp*h - vp^2)/up
    //k4:= 1;
    k3:= f6 - up2;
    k2:= f5 - up1 - h3*vp2 - up2*k3;

    // v = v - vp mod u
    //t22:= -vp2;
    t21:= vt1 + u1*vp2;
    t20:= vt0 + u0*vp2;

    // partially solve system to get sp = s*det
    // from Lindner's MSc thesis (pages 63-64)
    sp0:= t20*m1 + t21*m2;
    sp1:= t20*m3 + t21*m4;

    if (sp1 eq 0) then
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(up,u) = 1
        // DB = P1+P2, DA = P1+P3+P4

        // s = sp/det
        s0:= sp0/det;

        // upp = (w1 - s*(h + 2*vp + up*s))/u
        upp3:= 0;
        upp2:= 1;
        upp1:= k3 - u1 - h3*s0 - s0^2;
        upp0:= k2 + s0*(temp1 + s0*temp2 - vh2 - vp2) + temp3 - u1*k3;

        // vpp = -h - vp - up*s mod upp
        ta:= up2 - upp1;
        tb:= vh2 - h3*upp1;

        vpp2:= 0;
        vpp1:= s0*(upp1*ta - up1 + upp0) + upp1*tb + h3*upp0 - vh1;
        vpp0:= s0*(upp0*ta - up0) + upp0*tb - vh0;

        if (ADD_DEBUG) then "Deg23ADD: Typical, deg(s) = 0"; end if;
        return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(up,u) = 1
    // DB = P1+P2, DA = P3+P4+P5
    // return P1+P2+P3+P4+P5

    // s1Inv:= 1/s1, s = sp/det, sm = s/s1
    w1:= 1/(det*sp1);       // 1/(s1*det^2)
    w2:= det*w1;            // det/(s1*det^2) = 1/(s1*det)
    s1Inv:= det*w2;            // det/(s1*det) = 1/s1

    sm0:= sp0*w2;           // (s0*det)/(s1*det) = s0/s1
    s1:= sp1^2*w1;          // (s1^2*det^2)/(s1*det^2) = s1

    // upp = (w1 - s*(h + 2*vp + up*s))/u (made monic)
    temp4:= sm0*up2;
	ta:= up1 + temp4;
	tb:= vh2 + vp2;

    upp3:= 1;
    upp2:= h3*s1Inv - temp2 + sm0 + sm0 - s1Inv^2;
    upp1:= ta - u0 - u1*upp2 + temp4 + sm0^2 + (tb + h3*sm0 - k3*s1Inv)*s1Inv;
    upp0:= up0 - u1*upp1 - u0*upp2 + sm0*(up1 + ta) + (vh1 + vp1 + sm0*tb - k2*s1Inv)*s1Inv;

    // vpp = -h - vp - up*s mod upp
    ta:= up2 - upp2;
    tb:= up1 - upp1;
    tc:= up0 - upp0;

    vpp2:= s1*(upp2*(ta + sm0) - temp4 - tb) - vh2 + h3*upp2;
    vpp1:= s1*(upp1*ta - sm0*tb - tc) - vh1 + h3*upp1;
    vpp0:= s1*(upp0*ta - sm0*tc) - vh0 + h3*upp0;

    if (ADD_DEBUG) then "Deg23ADD: Typical"; end if;
    return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg3ADD():
// Input: u2..v0: Mumford coordinates for degree 3 divisor D1
//        up2..vp0: Mumford coordinates for degree 3 divisor D2
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of two degree three
//              divisors. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg3ADD:= function(u2, u1, u0, v2, v1, v0, up2, up1, up0, vp2, vp1, vp0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(u0);
    R<x> := PolynomialRing(FF);
    //f is truncated at the lowest coefficient this case needs: the omitted
    //coefficients have degree below the divisor's, so they fall in the
    //discarded remainder of every division here; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    u := x^3 + u2*x^2 + u1*x + u0;
    v := v2*x^2 + v1*x + v0;
    up := x^3 + up2*x^2 + up1*x + up0;
    vp := vp2*x^2 + vp1*x + vp0;
    Q := quo<R | up>;

    //Formulation
    dw1 := u mod up;                    // = (a1^-1)*S for S,a1,b1 = XGCD(u,up);
    d := Resultant(u,up);               // computed with 3x3 system
    if IsZero(d) then                   //gcd(u,up) != 1
        if IsZero(dw1) then             //u = up, so gcd(u,up) = up
            dw2 := (h + v + vp) mod up; // = (b2^-1)*S1 for S1,a2,b2 = XGCD(up,h + v + vp);
            if IsZero(dw2) then         //CASE #4.3: vp = -v - h, so D2 = -D1
                return 0,0,0,1,0,0,0;
            end if;
            k := (f - v*(v + h)) div u;   //Exact quotient
            //dx = up mod dw2, taken at the formal degree 2 for dw2, which is what the
            //  dw22^2 weight on the explicit dx does. A linear dw2 always divides up, so
            //  a plain remainder would vanish there and send a degree 1 second gcd into
            //  the composition-only case below; taken at the formal degree, dx degenerates
            //  to dw2 itself and falls through correctly. Same device for bt, ew and at.
            dx := (Degree(dw2) eq 2) select (up mod dw2) else dw2;
            if IsZero(dx) then          //CASE #4.2: S1 = dw2, of degree 2
                //S1,a2,b2 := XGCD(up,h + v + vp);
                //a1 = 0 because gcd(u,up) = up;
                b2 := LeadingCoefficient(dw2)^-1;
                S1 := dw2*b2;
                up := ExactQuotient(up,S1);
                u := ExactQuotient(u,S1);
                s := b2*k mod up;
                upp := up*u;
                vpp := (v + u*s) mod upp;
                return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
            end if;
            //CASE #4.1: S1 = dx made monic, of degree 1
            //S1,a2,b2 := XGCD(up,h + v + vp);
            //a1 = 0 because gcd(u,up) = up;
            dx1Inv := LeadingCoefficient(dx)^-1;
            S1 := dx*dx1Inv;
            bt := (Degree(dw2) eq 2) select (-(up div dw2)) else R!1;    // = b2*dx1
            b2 := bt*dx1Inv;
            up := ExactQuotient(up,S1);
            u := ExactQuotient(u,S1);
            s := b2*k mod up;
            upp := ExactQuotient(k*S1 - s*(s*u + 2*v + h), up);
            vpp := (-s*u - v - h) mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        //ew = up mod dw1, at the formal degree 2 for dw1: a linear dw1 always divides up,
        //  and there ew degenerates to dw1 itself, which is already the degree 1 gcd
        ew := (Degree(dw1) eq 2) select (up mod dw1) else dw1;
        if IsZero(ew) then              //gcd(u,up) = dw1, of degree 2
            vt := vp - v;
            a1 := LeadingCoefficient(dw1)^-1;
            S := dw1*a1;
            dw3 := (h + v + vp) mod S;  // = (b2^-1)*S1 for S1,a2,b2 = XGCD(S,h + v + vp);
            if IsZero(dw3) then         //CASE #3.5
                //S1,a2,b2 := XGCD(S,h + v + vp);
                //S1 = S, a2 = 1, b2 = 0;
                u := ExactQuotient(u,S);
                up := ExactQuotient(up,S);
                s := a1*vt mod up;
                upp := up*u;
                vpp := (v + u*s) mod upp;
                return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
            end if;
            k := (f - v*(v + h)) div u;   //Exact quotient
            dy := Resultant(S,h + v + vp);      // = dw1 mod dw3, up to weight
            if IsZero(dy) then          //CASE #3.4
                //S1,a2,b2 := XGCD(S,h + v + vp);
                //S1 = dw3 made monic, of degree 1;
                b2 := LeadingCoefficient(dw3)^-1;
                S1 := dw3*b2;
                t := S1 - b2*(h + v + vp);
                a2 := ExactQuotient(t,S);
                u := ExactQuotient(u,S1);
                up := ExactQuotient(up,S1);
                s := (a2*a1*vt + b2*k) mod up;
                upp := ExactQuotient(k*S1 - s*(s*u + 2*v + h), up);
                vpp := (-s*u - v - h) mod upp;
                return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
            end if;
            //S1,a2,b2 := XGCD(S,h + v + vp);
            //S1 = 1;
            QS := quo<R | S>;
            b2 := R!(QS!dw3^-1);
            t := (1 - b2*(h + v + vp)) mod up;
            a2 := ExactQuotient(t,S);
            s := (a2*a1*vt + b2*k) mod up;
            if Degree(s) lt 2 then      //CASES #3.3 (deg(s) = 0) and #3.2 (deg(s) = 1)
                upp := ExactQuotient(-s*(s*u + 2*v + h) + k, up);
                upp := upp/LeadingCoefficient(upp);
                vpp := (-s*u - v - h) mod upp;
                return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
            end if;
            //CASE #3.1: one continued fraction step (reachable only with S1 = 1)
            q, r := Quotrem(up,s);
            M1 := ExactQuotient((vp - v)*q + u*r, up);
            M2 := ExactQuotient(r*(h + v + vp) + q*k, up);
            upp := r*M1 - q*M2;
            z := ExactQuotient(u*r - upp, q);
            upp := upp/LeadingCoefficient(upp);
            vpp := (z - v - h) mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        //gcd(u,up) = ew, of degree 1
        at := (Degree(dw1) eq 2) select (-(up div dw1)) else R!1;    // = a1*ew1
        ew1Inv := LeadingCoefficient(ew)^-1;
        a1 := at*ew1Inv;
        S := ew*ew1Inv;
        dw4 := (h + v + vp) mod S;      // = (b2^-1)*S1 for S1,a2,b2 = XGCD(S,h + v + vp);
        if IsZero(dw4) then             //CASE #2.4
            //S1,a2,b2 := XGCD(S,h + v + vp);
            //S1 = S, a2 = 1, b2 = 0;
            k := (f - v*(v + h)) div u;   //Exact quotient
            u := ExactQuotient(u,S);
            up := ExactQuotient(up,S);
            vt := vp - v;
            y := a1*vt;
            s := y mod up;
            upp := ExactQuotient(k*S - s*(s*u + 2*v + h), up);
            vpp := (-s*u - v - h) mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        //S1,a2,b2 := XGCD(S,h + v + vp);
        //S1 = 1;
        k := (f - v*(v + h)) div u;   //Exact quotient
        vt := vp - v;
        b2 := FF!dw4^-1;
        t := (1 - b2*(h + v + vp)) mod up;
        a2 := ExactQuotient(t,S);
        s := (a2*a1*vt + b2*k) mod up;
        if Degree(s) lt 2 then          //CASES #2.3 (deg(s) = 0) and #2.2 (deg(s) = 1)
            upp := ExactQuotient(-s*(s*u + 2*v + h) + k, up);
            upp := upp/LeadingCoefficient(upp);
            vpp := (-s*u - v - h) mod upp;
            return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
        end if;
        //CASE #2.1: one continued fraction step (reachable only with S1 = 1)
        q, r := Quotrem(up,s);
        M1 := ExactQuotient((vp - v)*q + u*r, up);
        M2 := ExactQuotient(r*(h + v + vp) + q*k, up);
        upp := r*M1 - q*M2;
        z := ExactQuotient(u*r - upp, q);
        upp := upp/LeadingCoefficient(upp);
        vpp := (z - v - h) mod upp;
        return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    end if;
    //gcd(u,up) = 1
    k := (f - v*(v + h)) div u;   //Exact quotient
    vt := vp - v;
    s := R!(Q!dw1^-1)*vt mod up;
    if Degree(s) lt 2 then              //CASES #1.3 (deg(s) = 0) and #1.2 (deg(s) = 1)
        upp := ExactQuotient(-s*(s*u + 2*v + h) + k, up);
        upp := upp/LeadingCoefficient(upp);
        vpp := (-s*u - v - h) mod upp;
        return Coeff(upp,3),Coeff(upp,2),Coeff(upp,1),Coeff(upp,0),Coeff(vpp,2),Coeff(vpp,1),Coeff(vpp,0);
    end if;
    //CASE #1.1, the typical path: one continued fraction step
    q, r := Quotrem(up,s);
    M1 := ExactQuotient((vp - v)*q + u*r, up);
    M2 := ExactQuotient(r*(h + v + vp) + q*k, up);
    upp := r*M1 - q*M2;
    z := ExactQuotient(u*r - upp, q);
    upp := upp/LeadingCoefficient(upp);
    vpp := (z - v - h) mod upp;
    return Coeff(upp,3), Coeff(upp,2), Coeff(upp,1), Coeff(upp,0),
           Coeff(vpp,2), Coeff(vpp,1), Coeff(vpp,0);
    */ //endIGNORE

	// vh = h + v
	vh0:= h0 + v0;
	vh1:= h1 + v1;
	vh2:= h2 + v2;

	// ht = vh + vp
	// Only ht2 is needed on the generic path -- it is read at the resultant
	// below. ht1 and ht0 are read solely inside the `det eq 0` branch, so they
	// are formed there instead; the special cases pay the same two additions,
	// just later.
	ht2:= vh2 + vp2;

    // dw1 = u mod up
    dw12:= u2 - up2;
    dw11:= u1 - up1;
    dw10:= u0 - up0;

    // set up system of equations to solve for s = (vp-v)/u mod up
    // and find the determinant
	ta:= up2*dw12;
	tb:= up1*dw12;
	tc:= up0*dw12;
	temp1:= dw11 - ta;
    temp2:= dw10 - tb;
	temp3:= dw12*tc;
	temp4:= dw11*temp1;
	temp5:= dw10*temp1;

    m9:= dw10*temp2 + dw11*tc;
	m8:= -temp5 - temp3;
	m7:= temp4 - dw12*temp2;

    tf:= -up0*m7;

    m5:= m9 + up2*m8;
    m3:= -up0*m8;
    m2:= tf;
    m1:= m5 + up1*m7;

    det:= dw10*m1 + dw11*m2 + dw12*m3;

    // if gcd(u,up) != 1
    if (det eq 0) then

		ht1:= vh1 + vp1;
		ht0:= vh0 + vp0;

        // if gcd(u,up) = up
        if (dw12 eq 0 and dw11 eq 0) then

            // dw2 = (h + vp + v) mod up
            dw22:= ht2 - h3*up2;
            dw21:= ht1 - h3*up1;
            dw20:= ht0 - h3*up0;

            // if gcd(up,h+vp+v) = up
            if (dw22 eq 0 and dw21 eq 0 and dw20 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #4.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u,up) = up
                // DB = P1+P2-P3, DA = P3-P1-P2
                // return P0

				if (ADD_DEBUG) then "Deg3ADD: gcd(u,up) = up, DB = P1+P2-P3, DA = P3-P1-P2"; end if;
                return 0, 0, 0, 1, 0, 0, 0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #4.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

			// w1 = (f - v*h - v^2)/u
			//k4:= 1;
			k3:= f6 - u2;
			ta:= u2*k3;
			k2:= f5 - u1 - h3*v2 - ta;
			tb:= u1*k2;
			k1:= f4 - u0 - h3*v1 - v2*vh2 - (u1 + u2)*(k2 + k3) + ta + tb;		// karatsuba
			k0:= f3 - h3*v0 - v1*vh2 - v2*vh1 - u0*k3 - tb - u2*k1;

            // dx = up mod dw2
            ta:= dw22^2;
            temp6:= up2*dw22 - dw21;                    //dw22

            dx1:= up1*ta - dw20*dw22 - dw21*temp6;		// w(dx) = dw22^2
            dx0:= up0*ta - dw20*temp6;

            // if gcd(up,h+vp+v) = dw2
            if (dx1 eq 0 and dx0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #4.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u,up) = up
                // DB = P1+P2+P3, DA = P3-P1-P2
                // return 2P1

                // dw22Inv = h+vp+v^-1 mod up
                //    = b2
                dw22Inv:= 1/dw22;

                // dm = dw2/dw22
            	// NOTE: No need to compute dm0 since u, up, and dm are monic and we'll do exact divisions u/dm
            	//	and up/dm where doing each long division reveals that dm0 has no role in coeffs of the quotient.
                dm1:= dw21*dw22Inv;

                // up = up/dm
                //up1:= 1;
                up0:= up2 - dm1;

                // u = u/dm
                //u1:= 1;
                u0:= u2 - dm1;

                // s = (up^-1 mod h+vp+v)*(u^-1 mod up)*(vp-v) + (h+vp+v^-1 mod up)*w1 mod up
                //   = (       a2        )*(     a1     )*(vp-v) + (       b2        )*w1 mod up
                //   = (       a2        )*(     0      )*(vp-v) + (       dw22Inv        )*w1 mod up
                //   = w1*dw22Inv mod up
                s0:= (k0 - up0*(k1 - up0*(k2 - up0*(k3 - up0))))*dw22Inv;

                // upp = up*u
                upp3:= 0;
                upp2:= 1;
                upp1:= up0 + u0;
                upp0:= up0*u0;

                // vpp = (u*s + v) mod upp
                vpp2:= 0;
                vpp1:= s0 + v1 - upp1*v2;
                vpp0:= u0*s0 + v0 - upp0*v2;

				if (ADD_DEBUG) then "Deg3ADD: gcd(u,up) = up, DB = P1+P2+P3, DA = P3-P1-P2"; end if;
                return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #4.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #4.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u,up) = up
            // gcd(up,h+vp+v) = dx (degree 1)
            // DB = P1+P2+P3, DA = P3+P2-P1
            // return 2P2+2P3

            // dx1Inv = 1/dx1, dm = dx/dx1
            dx1Inv:= 1/dx1;			// 1/(dx1*dw22^2) because of weight of dx1

            //dm1:= 1;
            dm0:= dx0*dx1Inv;		// (dx0*dw22^2)/(dx1*dw22^2) = dx0/dx1

            // bt = (h+vp+v^-1 mod up)*dx1
            //    = (       b2        )*dx1
            //    = (  (-up/dw2)/dx1   )*dx1
            //    = -up/dw2
            bt1:= -dw22;     // w(bt) = dw22^2
            bt0:= -temp6;

            // up = up/dm
            ta:= up2 - dm0;

            up0:= up1 - dm0*ta;
            up1:= ta;

            // u = u/dm
            ta:= u2 - dm0;

            u0:= u1 - dm0*ta;
			u1:= ta;

            // kp = k mod up
            //kp4:= 1;
            kp3:= k3 - up1;
            ta:= up1*kp3;
            kp2:= k2 - up0 - ta;
            tb:= up0*kp2;
            kp1:= k1 - (up0 + up1)*(kp2 + kp3) + ta + tb;		// karatsuba
            kp0:= k0 - tb;

            // sp = (up^-1 mod h+vp+v)*(u^-1 mod up)*dx1*(vp-v) + (h+vp+v^-1 mod up)*dx1*w1 mod up
            //    = (       a2        )*(     a1     )*dx1*(vp-v) + (       b2        )*dx1*w1 mod up
            //    = (       a2        )*(     0      )*dx1*(vp-v) + (          bt         )*(  w1R  ) mod up
            //    = bt*w1R mod up
            ta:= bt1*kp1;
            tb:= bt0*kp0;

            sp1:= (bt0 + bt1)*(kp0 + kp1) - ta - tb - up1*ta;		// w(sp) = dx1*dw22^2, but why? karatsuba
            sp0:= tb - up0*ta;

            // s = sp/dx1
            s1:= sp1*dx1Inv;        // (s1*dx1*dw22^2)/(dx1*dw22^2) = s1
            s0:= sp0*dx1Inv;        // (s0*dx1*dw22^2)/(dx1*dw22^2) = s0

            // upp = (dm*w1 - s*(h + 2*v + u*s))/up, why to multiply dm by w1? Based on which step of NUCOMP, etc.?
			temp7:= vh2 + s0;
			ta:= temp7 + v2;
            tb:= s0*u1;
			temp8:= vh1 + tb + s1*u0;

            upp3:= 1;
            upp2:= kp3 + dm0 - h3*s1 - s1^2;
            upp1:= kp2 - h3*s0 + kp3*dm0 - s1*(ta + s0 - h3*up1 - s1*(up1 - u1));
            upp0:= k1 + k2*dm0 - up1*upp1 - up0*upp2 - s1*(temp8 + v1 + tb) - s0*ta;

            // vpp = -h - v - u*s mod upp
            ta:= h3 + s1;

            vpp2:= h3*upp2 - temp7 - s1*(u1 - upp2);
            vpp1:= upp1*ta - temp8;
            vpp0:= upp0*ta - vh0 - u0*s0;

			if (ADD_DEBUG) then "Deg3ADD: gcd(u,up) = up, DB = P1+P2+P3, DA = P3+P2-P1"; end if;
            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #4.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ew = up mod dw1
        ew1:= m7;		// w(ew) = dw12^2
        ew0:= -m8;

        // if gcd(u,up) = dw1
        if (ew1 eq 0) then

			// vt = vp - v
			vt2:= vp2 - v2;
			vt1:= vp1 - v1;
			vt0:= vp0 - v0;

            // dw3 = h + vp + v mod dw1
			temp6:= dw12^2;
			ta:= dw10*dw12;					//dw12
            tb:= ht2*dw12 - h3*dw11;		//dw12

            dw31:= ht1*temp6 - h3*ta - dw11*tb;		// w(dw3) = dw12^2
            dw30:= ht0*temp6 - dw10*tb;

            // if gcd(dw1,h+vp+v) = dw1
            if (dw31 eq 0 and dw30 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.5 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u,up) = dw1
                // DB = P1+P2+P3, DA = P4-P1-P2
                // return P3+P4

                // dw12Inv = 1/dw12, dm = dw1/dw12
                dw12Inv:= 1/dw12;

                dm1:= dw11*dw12Inv;

                // u = u/dw1
                u0:= u2 - dm1;

                // up = up/dw1
                up0:= up2 - dm1;

                // s = (dw1^-1 mod h+vp+v)*(u^-1 mod up)*(vp-v) + (h+vp+v^-1 mod dw1)*w1 mod up
                //   = (       a2       )*(     a1     )*(vp-v) + (       b2       )*w1 mod up
                //   = (       1        )*(    1/dw12    )*(vp-v) + (       0        )*w1 mod up
                //   = (vp-v)/dw12 mod up
                s0:= (vt0 - up0*(vt1 - up0*vt2))*dw12Inv;

                // upp = up*u
                upp3:= 0;
                upp2:= 1;
                upp1:= up0 + u0;
                upp0:= up0*u0;

                // vpp = (u*s + v) mod upp
                vpp2:= 0;
                vpp1:= s0 + v1 - upp1*v2;
                vpp0:= u0*s0 + v0 - upp0*v2;

				if (ADD_DEBUG) then "Deg3ADD: gcd(u,up) = dw1, DB = P1+P2+P3, DA = P4-P2-P1"; end if;
                return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.5 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

			// w1 = (f - v*h - v^2)/u
			//k4:= 1;
			k3:= f6 - u2;
			ta:= u2*k3;
			k2:= f5 - u1 - h3*v2 - ta;
			tb:= u1*k2;
			k1:= f4 - u0 - h3*v1 - v2*vh2 - (u1 + u2)*(k2 + k3) + ta + tb;		// karatsuba
			k0:= f3 - h3*v0 - v1*vh2 - v2*vh1 - u0*k3 - tb - u2*k1;

            // dy = dw1 mod dw3
            temp7:= dw31^2;
            temp8:= dw11*dw31 - dw30*dw12;

            dy0:= dw10*temp7 - dw30*temp8;		// w(dy) = dw31^2*dw12^2, but why?


            // if gcd(dw1,h+vp+v) = dw3
            if (dy0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u,up) = dw1
                // DB = P1+P2+P3, DA = P4-P1+P2
                // return 2P2+P3+P4

                // dw12Inv = 1/dw12, dm = dw3/dw31
                w1:= 1/(dw31*dw12);        // 1/(dw31*dw12^3)
                dw12Inv:= dw31*w1;            // (dw31*dw12^2)/(dw31*dw12^3) = 1/dw12
                w2:= dw12*w1;             // dw12/(dw31*dw12^3) = 1/(dw31*dw12^2)

                dm0:= dw30*w2;           // (dw30*dw12^2)/(dw31*dw12^2) = dw30/dw31

                // b2 = h+vp+v^-1 mod dw1
                //    = 1/dw31
                b2:= temp6*w2;           	// dw12^2/(dw31*dw12^2) = 1/dw31

                // at = ((dw1^-1 mod h+vp+v )*dw31)*(u^-1 mod up)
                //    = ((       a2        )*dw31)*(     a1     )
                //    = ((-(h+vp+v/dw1)/dw31 )*dw31)*(    1/dw12    )
                //    = ((-(h+vp+v/dw1)/dw31 )*dw31)*(     dw12Inv     )
                //    = -(h+vp+v/dw1)*dw12Inv
                at1:= -h3*dw12Inv;
                at0:= -(dw11*at1 + ht2)*dw12Inv;

				// u = u/dw3
                ta:= u2 - dm0;

                u0:= u1 - dm0*ta;
                u1:= ta;

                // up = up/dw3
                ta:= up2 - dm0;

                up0:= up1 - dm0*ta;
                up1:= ta;

                // sp = (dw1^-1 mod h+vp+v)*dw31*(u^-1 mod up)*(vp-v) + (h+vp+v^-1 mod dw1)*dw31*w1 mod up
                //    = (       a2       )*dw31*(     a1     )*( vt  ) + (       b2       )*dw31*w1 mod up
                //    = (                at                 )*( vt  ) + (     1/dw31      )*dw31*w1 mod up
                //    = (w1 + at*vt) mod up
				temp9:= k3 - up1;
				t10:= k2 - up0;
                ta:= at1*vt2;
                tb:= at0*vt1;

                //sp4:= 1;
                sp3:= temp9 + ta;
                tc:= up1*sp3;
                sp2:= t10 + (at0 + at1)*(vt1 + vt2) - ta - tb - tc;					// karatsuba
                td:= up0*sp2;
                sp1:= k1 + tb + at1*vt0 - (up0 + up1)*(sp2 + sp3) + tc + td;		// karatsuba
                sp0:= k0 + at0*vt0 - td;

                // s = sp/dw31
                s1:= sp1*b2;
                s0:= sp0*b2;

				// upp = (dm*w1 - s*(h + 2*v + u*s))/up // why to multiply dm by w1?
				t11:= vh2 + s0;
				ta:= t11 + v2;
				tb:= s0*u1;
				t12:= vh1 + tb + s1*u0;

				upp3:= 1;
				upp2:= temp9 + dm0 - h3*s1 - s1^2;
				upp1:= t10 - h3*s0 + temp9*(dm0 - up1) - s1*(ta + s0 - h3*up1 - s1*(up1 - u1));
				upp0:= k1 + k2*dm0 - up1*upp1 - up0*upp2 - s1*(t12 + v1 + tb) - s0*ta;

				// vpp = -h - v - u*s mod upp
				ta:= h3 + s1;

				vpp2:= h3*upp2 - t11 - s1*(u1 - upp2);
				vpp1:= upp1*ta - t12;
				vpp0:= upp0*ta - vh0 - u0*s0;

				if (ADD_DEBUG) then "Deg3ADD: gcd(u,up) = dw1, DB = P1+P2+P3, DA = P4-P1+P2"; end if;
                return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;
			// gcd(dw1,h+vp+v) = 1

            // b2 = (  h+vp+v^-1 mod dw1   )
            //    = (     -dw1/dw3      )/dy0
            //    = (       bt       )/dy0
            bt1:= -temp6*dw31;     // w(bt) = dw31^2; doing long division, bt1 and bt0 seem to be the current ones divided by dw12!
            bt0:= -dw12*temp8;

            // a2 = (     dw1^-1 mod h+vp+v      )
            //    = (1 + (h+vp+v/dw1)*(dw1/dw3))/dy0
            //    = (1 + (    y    )*(-bt ))/dy0
            //    = (1 + (        z        ))/dy0
            //    = (          at          )/dy0

            // y = h+vp+v/dw1
            y1:= h3*dw12;					// w(y) = dw12
            y0:= ht2*dw12 - h3*dw11;

            // z = -bt*y
            ta:= bt0*y0;

            z2:= -bt1*y1;                               // w(z) = w(bt)*w(y) = dw31^2*dw12
            z1:= -z2 + ta - (bt0 + bt1)*(y0 + y1);		// karatsuba
            z0:= -ta;

            // at = 1 + z
            at2:= z2;               // w(at) = w(z) = dw31^2*dw12
            at1:= z1;
            at0:= temp7*dw12 + z0;      // because we want at=1+z to have the weight dw31^2*dw12, so that after dividing by the latter we get 1 + weightless z

            // lh = at*vt
            ta:= at1*vt1;
            tb:= at0*vt0;

            lh4:= at2*vt2;                                      // w(lh) = w(at)*1 = dw31^2*dw12
            lh3:= (at1 + at2)*(vt1 + vt2) - lh4 - ta;           // karatsuba
            lh2:= ta + (at0 + at2)*(vt0 + vt2) - lh4 - tb;		// karatsuba
            lh1:= (at0 + at1)*(vt0 + vt1) - ta - tb;            // karatsuba
            lh0:= tb;


            // rh = b2*w1
            ta:= bt1*temp6;		//dw31^2*dw12^2 //extra dw12^2 added here (1 extra dw12^2 compared to the LHS)
            tb:= bt0*temp6;      	//dw31^2*dw12^2 //extra dw12^2 added here (1 extra dw12^2 compared to the LHS)
            tc:= ta*k3;       	//dw31^2*dw12^2
            td:= tb*k2;       	//dw31^2*dw12^2
            te:= ta*k1;       	//dw31^2*dw12^2
            tf:= tb*k0;       	//dw31^2*dw12^2

            rh5:= ta;                                   //dw31^2*dw12^2
            rh4:= tc + tb;                              //dw31^2*dw12^2
            rh3:= (ta + tb)*(k2 + k3) - tc - td;		//dw31^2*dw12^2 karatsuba
            rh2:= td + te;                              //dw31^2*dw12^2
            rh1:= (ta + tb)*(k0 + k1) - te - tf;        //dw31^2*dw12^2 karatsuba
            rh0:= tf;                                   //dw31^2*dw12^2

            // sp = (d^-1 mod h+vp+v)*dy0*(u^-1 mod up)*dw12*(vp-v) + (h+vp+v^-1 mod d)*dy0*w1 mod up
            //    = (       a2       )*dy0*(     a1     )*dw12*( vt  ) + (       b2       )*dy0*w1 mod up
            //    = (     at/dy0     )*dy0*(    1/dw12    )*dw12*( vt  ) + (     bt/dy0     )*dy0*w1 mod up
            //    = (         at         )*(       1       )*( vt  ) + (         bt         )*w1 mod up
            //    = (                      lh                      ) + (          rh          ) mod up
            //    = (lh + rh) mod up
            sp5:= rh5;
            ta:= up2*sp5;
            sp4:= lh4 + rh4 - ta;
            tb:= up1*sp4;
            sp3:= lh3 + rh3 - (up1 + up2)*(sp4 + sp5) + ta + tb;            // karatsuba
            tc:= up0*sp3;

            sp2:= lh2 + rh2 - tb - (up0 + up2)*(sp3 + sp5) + ta + tc;		// karatsuba
            sp1:= lh1 + rh1 - (up0 + up1)*(sp3 + sp4) + tb + tc;            // karatsuba
            sp0:= lh0 + rh0 - tc;

            if (sp2 eq 0) then
                if (sp1 eq 0) then
                    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                    // gcd(u,up) = dw1
                    // DB = P1+P2+P3, DA = P1+P2+P4

                    // s = sp/(dy0*dw12)
                    s0:= sp0/(dy0*dw12);

                    // upp = (w1 - s*(h + 2*v + u*s))/up
                    upp3:= 0;
                    upp2:= 0;
                    upp1:= 1;
                    upp0:= k3 - up2 - h3*s0 - s0^2;

                    // vpp = -h - v - u*s mod upp
                    vpp2:= 0;
                    vpp1:= 0;
                    vpp0:= upp0*(u1*s0 + vh1 + upp0*(s0*(upp0 - u2) - vh2 + h3*upp0)) - vh0 - u0*s0;

					if (ADD_DEBUG) then "Deg3ADD: gcd(u,up) = dw1, DB = P1+P2+P3, DA = P1+P2+P4, deg(s) = 0"; end if;
                    return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
                    // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                end if;

                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u,up) = dw1
                // DB = P1+P2+P3, DA = P1+P2+P4

                // s = sp/(dy0*dw12), s1Inv = 1/s1, sm = s/s1
                ta:= dy0*dw12;

                w1:= 1/(sp1*ta);        // 1/(s1*dy0^2*dw12)
                w2:= ta*w1;             // (dy0*dw12)/(s1*dy0^2*dw12) = 1/s1*dy0
                s1Inv:= ta*w2;             // (dy0*dw12)/(s1*dy0) = 1/s1

                s1:= sp1^2*w1;          // (s1^2*dy0^2)/(s1*dy0^2*dw12) = s1/dw12 = s1
                sm0:= sp0*w2;           // s0*dy0/s1*dy0 = s0/s1

                // upp = (w1 - s*(h + 2*v + u*s))/up (made monic)
                temp9:= sm0*u2;

                upp3:= 0;
                upp2:= 1;
                upp1:= dw12 + sm0 + sm0 + h3*s1Inv - s1Inv^2;
				t10:= upp1 - sm0;
                upp0:= dw11 + temp9 + (sm0 - up2)*t10 + (vh2 + v2 + (sm0 - k3)*s1Inv)*s1Inv;

                // vpp = -h - v - u*s mod upp
                ta:= s1*(t10 - u2) - h3;
                tb:= upp1*ta;
                tc:= s1*(upp0 - u1 - temp9) - vh2 - tb;
                td:= upp0*tc;

                vpp2:= 0;
                vpp1:= -s1*(u0 + u1*sm0) - vh1 - (upp0 + upp1)*(tc + ta) + tb + td;		// karatsuba
                vpp0:= -s1*(u0*sm0) - vh0 - td;

                if (ADD_DEBUG) then "Deg3ADD: gcd(u,up) = dw1, DB = P1+P2+P3, DA = P1+P2+P4, deg(s) = 1"; end if;
                return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u,up) = dw1
            // DB = P1+P2+P3, DA = P1+P2+P4
            // return 2P1+2P2+P3+P4

            // s = sp/(dy0*dw12), s2Inv = 1/s2, sm = s/s2
            ta:= dy0*dw12;

            w1:= 1/(sp2*ta);        // 1/(s2*dy0^2*dw12)
            w2:= ta*w1;             // (dy0*dw12)/(s2*dy0^2*dw12) = 1/s2*dy0
            s2Inv:= ta*w2;             // (dy0*dw12)/(s2*dy0) = 1/s2

            s2:= sp2^2*w1;          // (s2^2*dy0^2)/(s2*dy0^2*dw12) = s2/dw12 = s2
            sm1:= sp1*w2;           // s1*dy0/s2*dy0 = s1/s2
            sm0:= sp0*w2;           // s0*dy0/s2*dy0 = s0/s2

			// q, r = DivRem(up, s)
            // q = quot(up/s)
            //q1:= 1;           // w(q) = s2
            q0:= up2 - sm1;

            // r = up mod s
            r1:= s2*(up1 - sm1*q0 - sm0);       // w(r) = s2
            r0:= s2*(up0 - sm0*q0);

            // M1 = (q*(vp - v) + r*u)/up
            //M11:= r1;                 //s2^2 ?
            M10:= vt2 + r0 + r1*dw12;     // w(M1) = s2

            // M2 = (r*(h + vp + v) + q*w1)/up
            //M22:= 1;                                                          // w(M2) = s2
            M21:= k3 + h3*r1 - sm1;
            M20:= k2 + h3*r0 - sm1*(k3 - up2) + r1*(ht2 - h3*up2) - up1;

            // upp = r*M1 - q*M2 (monic)
			// weights of r, M1, q, and M2 (each of which is s2) don't matter anymore for computing upp, because
			//	we just need monic(upp); in fact weightless upp / lcf(weightless upp) = weighted upp / lcf(weighted upp) which can be rewritten as
			//	(weighted upp / s2^2) / lcf(weighted upp / s2^2) = weighted upp / lcf(weighted upp) = monic(upp)
            upp3:= 1;
            upp2:= M21 - r1^2 + q0;
            upp1:= M20 - r1*(M10 + r0) + M21*q0;
            upp0:= M20*q0 - r0*M10;

            // vpp = ((u*r - upp)/q - v - h) mod upp
            ta:= r0 - r1*q0;
			tb:= (u2 - q0)*ta + (upp2 - q0)*s2Inv;

			vpp2:= r1*(u2 - upp2) + ta + s2Inv - vh2 + h3*upp2;
            vpp1:= r1*(u1 - upp1) + tb - vh1 + h3*upp1;
			vpp0:= r1*(u0 - upp0) + u1*ta - q0*tb + upp1*s2Inv - vh0 + h3*upp0;

            if (ADD_DEBUG) then "Deg3ADD: gcd(u,up) = dw1, DB = P1+P2+P3, DA = P1+P2+P4, deg(s) = 2"; end if;
            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;
		// gcd(u, up) = ew, because det=0 here, thus gcd is non-trivial and deg(ew)=1; so, dw1 mod ew must be 0, otherwise we would have gcd(u,up)=1, i.e., trivial.

        // at = (u^-1 mod up)*ew1
        //    = (     a1     )*ew1
        //    = ( -(up/dw1)/ew1 )*ew1
        //    = -(up/dw1)
        at1:= -dw12;		// w(at) = dw12^2
        at0:= temp1;

        // dw4 = (h + vp + v) mod ew
        temp4:= ew1^2;
		temp5:= ht2*ew1 - ew0*h3;
		temp6:= ht1*temp4;
		temp7:= ew0*temp5;
        temp8:= ew1*temp4;		// ew1^3

        dw40:= ht0*temp8 - ew0*(temp6 - temp7);		// w(dw4) = (weighted ew1)^3 = (weightless ew1)^3*dw12^6

        // if gcd(ew,h+vp+v) = ew
        if (dw40 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u,up) = ew
            // DB = P1+P2+P3, DA = P4-P1+P5
            // return P2+P3+P4+P5

            // w1 = (f - v*h - v^2)/u
            //k4:= 1;
            k3:= f6 - u2;
            k2:= f5 - u1 - f6*u2 - h3*v2 + u2^2;
            k1:= f4 - u0 - f6*u1 - h3*v1 - v2*vh2 - u2*(k2 - u1);

            // ew1Inv = 1/ew1, dm = ew/ew1
            ew1Inv:= 1/ew1;         	// 1/(ew1*dw12^2)

            em0:= ew0*ew1Inv;		// (ew0*dw12^2)/(ew1*dw12^2) = ew0/ew1

            // a1 = u^-1 mod up
            //    = at/ew1
            a11:= at1*ew1Inv;
            a10:= at0*ew1Inv;

            // u = u/em
            ta:= u2 - em0;
            u0:= u1 - em0*ta;
            u1:= ta;

            // up = up/em
            ta:= up2 - em0;
            up0:= up1 - em0*ta;
            up1:= ta;

            // vt = vp - v
            vt2:= vp2 - v2;
            vt1:= vp1 - v1;
            vt0:= vp0 - v0;

            // y = a1*vt
            ta:= a10*vt1;

            y3:= a11*vt2;
            y2:= (a10 + a11)*(vt1 + vt2) - y3 - ta;		// karatsuba
            y1:= a11*vt0 + ta;
            y0:= a10*vt0;

            // s = (ew^-1 mod h+vp+v)*(u^-1 mod up)*(vp-v) + (h+vp+v^-1 mod ew)*w1 mod up
            //   = (       a2       )*(     a1     )*( vt  ) + (       b2       )*w1 mod up
            //   = (       1        )*(         y          ) + (       0        )*w1 mod up
            //   = y mod up
            s3:= y3;
            ta:= up1*s3;
            s2:= y2 - ta;
            tb:= up0*s2;
            s1:= y1 - (up0 + up1)*(s2 + s3) + ta + tb;		// karatsuba
            s0:= y0 - tb;

            // upp = (w1*em - s*(h + 2*v + u*s))/up
            t10:= s0*u1;
            t11:= s1*u0;
            ta:= k3 - up1;

            upp3:= 1;
            upp2:= ta + em0 - h3*s1 - s1^2;
            upp1:= k2 - up0 - ta*(up1 - em0) - s1*(h2 + 2*(v2 + s0) - h3*up1 + s1*(u1 - up1)) - h3*s0;
            upp0:= k1 - up1*(upp1) - up0*(upp2) - s1*(h1 + 2*(v1 + t10) + t11) + em0*k2 - s0*(vh2 + v2 + s0);

            // vpp = -h - v - u*s mod upp
			ta:= h3 + s1;

            vpp2:= h3*upp2 + s1*(upp2 - u1) - vh2 - s0;
            vpp1:= upp1*ta - t10 - t11 - vh1;
            vpp0:= upp0*ta - s0*u0 - vh0;

            //"Deg3ADD - gcd(u,up) = e, DB = P1+P2+P3, DA = P4-P1+P5";
            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;
		// gcd(ew,h+vp+v) = 1

        // w1 = (f - v*h - v^2)/u
		ta:= h3*v2;
		tb:= h2*v1;

        //k4:= 1;
        k3:= f6 - u2;
        k2:= f5 - u1 - f6*u2 - ta + u2^2;
        k1:= f4 - u0 - f6*u1 - h3*v1 - v2*vh2 - u2*(k2 - u1);                      // no karatsuba, use u2 multiplication
        k0:= f3 - f6*u0 - h3*v0 - tb - u2*(k1 - u0) - u1*(k2) - v2*(vh1 + v1);

        // vt = vp - v
        vt2:= vp2 - v2;
        vt1:= vp1 - v1;
        vt0:= vp0 - v0;

        // a2 = ( ew^-1 mod h+vp+v )
        //    = ( -(h+vp+v)/ew )/dw40
        //    = (      y       )/dw40
        // y = -(h+vp+v)/ew
        y2:= -h3*temp4;			// w(y) = ew1^2, but shouldn't be ew1^3?
        y1:= -ew1*temp5;
        y0:= -(temp6 - temp7);

        // z = at*vt mod up
        z3:= at1*vt2;                           				//dw12^2
		ta:= at0*vt1;											//dw12^2
        z2:= (at0 + at1)*(vt1 + vt2) - z3  - ta - up2*z3;		//dw12^2 karatsuba
        z1:= at1*vt0 + ta - up1*z3;        						//dw12^2
        z0:= at0*vt0 - up0*z3;                  				//dw12^2

        // lh = y*z
		ta:= y1*z1;										//ew1^2*dw12^2
		tb:= y0*z0;										//ew1^2*dw12^2

        lh4:= y2*z2;                       				//ew1^2*dw12^2
        lh3:= (y1 + y2)*(z1 + z2) - lh4 - ta;			//ew1^2*dw12^2 karatsuba
        lh2:= ta + (y0 + y2)*(z0 + z2) - lh4 - tb;		//ew1^2*dw12^2 karatsuba
        lh1:= (y0 + y1)*(z0 + z1) - ta - tb;            //ew1^2*dw12^2 karatsuba
        lh0:= tb;                       				//ew1^2*dw12^2

        //rhs = w1
        rh4:= temp8;        	//ew1^3
        rh3:= k3*temp8;     	//ew1^3
        rh2:= k2*temp8;     	//ew1^3
        rh1:= k1*temp8;     	//ew1^3
        rh0:= k0*temp8;		//ew1^3

        // sp = ( ew^-1 mod h+vp+v )*dw40*(u^-1 mod up)*ew1*(vp-v) + (h+vp+v^-1 mod ew)*dw40*w1 mod up
        //    = (        a2        )*dw40*(     a1     )*ew1*( vt  ) + (       b2       )*dw40*w1 mod up
        //    = ((-(h+vp+v)/ew)/dw40)*dw40*( -(up/d)/ew1 )*ew1*( vt  ) + (     1/dw40      )*dw40*w1 mod up
        //    = (          y           )*(      at       )*( vt  ) + (         1          )*w1 mod up
        //    = (          y           )*(           z           ) + (         1          )*w1 mod up
        //    = (                       lh                       ) + (          rh          ) mod up
        //    = lh + rh mod up
        sp4:= lh4 + rh4;
		ta:= up2*sp4;
        sp3:= lh3 + rh3 - ta;
		tb:= up1*sp3;

        sp2:= lh2 + rh2 - (up1 + up2)*(sp3 + sp4) + ta + tb;		// karatsuba
        sp1:= lh1 + rh1 - tb - up0*sp4;
        sp0:= lh0 + rh0 - up0*sp3;

        if (sp2 eq 0) then
            if (sp1 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u,up) = ew
                // DB = P1+P2+P3, DA = P1+P4+P5

                // s = sp/dw40
                s0:= sp0/(dw40);

                // upp = (w1 - s*(h + 2*v + u*s))/up
                upp3:= 0;
                upp2:= 0;
                upp1:= 1;
                upp0:= k3 - up2 - h3*s0 - s0^2;

                // vpp = -h - v - u*s mod upp
                vpp2:= 0;
                vpp1:= 0;
                vpp0:= upp0*(u1*s0 + vh1 + upp0*(s0*(upp0 - u2) - vh2 + h3*upp0)) - vh0 - u0*s0;

                return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u,up) = ew
            // DB = P1+P2+P3, DA = P1+P4+P5

            // s = sp/dw40, s1Inv = 1/s1, sm = s/s1
            ta:= dw40;

            w1:= 1/(sp1*ta);        // 1/(s1*dw40^2*dw12)
            w2:= ta*w1;             // (dw40*dw12)/(s1*dw40^2*dw12) = 1/s1*dw40
            s1Inv:= ta*w2;             // (dw40*dw12)/(s1*dw40) = 1/s1

            s1:= sp1^2*w1;          // (s1^2*dw40^2)/(s1*dw40^2*dw12) = s1/dw12 = s1
            sm0:= sp0*w2;           // s0*dw40/s1*dw40 = s0/s1

            // upp = (w1 - s*(h + 2*v + u*s))/up (made monic)
            tsb:= sm0*u2;

            upp3:= 0;
            upp2:= 1;
            upp1:= dw12 + h3*s1Inv + 2*sm0 - s1Inv^2;
            upp0:= (sm0 - up2)*(upp1 - sm0) + tsb + dw11 + (vh2 + v2 + (sm0 - k3)*s1Inv)*s1Inv;

            // vpp = -h - v - u*s mod upp
            ta:= s1*(upp1 - u2 - sm0) - h3;
            tc:= upp1*ta;
            tb:= s1*(upp0 - u1 - tsb) - vh2 - tc;
            td:= upp0*tb;

            vpp2:= 0;
            vpp1:= -s1*(u0 + u1*sm0) - vh1 - (upp0 + upp1)*(ta + tb) + tc + td;        // karatsuba
            vpp0:= -s1*(u0*sm0) - vh0 - td;

            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u,up) = ew
        // DB = P1+P2+P3, DA = P1+P4+P5
        // return 2P1+P2+P3+P4+P5

        // s = sp/dw40, s2Inv = 1/s2, sm = s/s2
        tx:= dw40;

        w1:= 1/(sp2*tx);        // 1/(s2*dw40^2*dw12)
        w2:= tx*w1;             // (dw40*dw12)/(s2*dw40^2*dw12) = 1/s2*dw40
        s2Inv:= tx*w2;             // (dw40*dw12)/(s2*dw40) = 1/s2

        s2:= sp2^2*w1;          // (s2^2*dw40^2)/(s2*dw40^2*dw12) = s2/dw12 = s2
        sm1:= sp1*w2;           // s1*dw40/s2*dw40 = s1/s2
        sm0:= sp0*w2;           // s0*dw40/s2*dw40 = s0/s2

        // q = up/s
        //q1:= 1;           //s2
        q0:= up2 - sm1;     //s2

        // r = up mod s
        r1:= s2*(up1 - sm1*q0 - sm0);       //s2
        r0:= s2*(up0 - sm0*q0);             //s2

        // M1 = (q*(vp - v) + r*u)/up
        //M11:= r1;                 //s2^2
        M10:= vt2 + r0 + r1*dw12;     // w(M1)=s2

        // M2 = (r*(h + vp + v) + q*w1)/up
        //M22:= 1;					// w(M2)=s2
        M21:= k3 + h3*r1 - sm1;
        M20:= k2 + h3*r0 - sm1*(k3 - up2) + r1*(ht2 - h3*up2) - up1;

        // upp = r*M1 - q*M2 (monic)
        upp3:= 1;
        upp2:= M21 - r1^2 + q0;
        upp1:= M20 - r1*(M10 + r0) + M21*q0;
        upp0:= M20*q0 - r0*M10;

        // vpp = ((u*r - upp)/q - v - h) mod upp
        tx:= r0 - r1*q0;
        ty:= (u2 - q0)*tx + (upp2 - q0)*s2Inv;        // shared by vpp1 and vpp0

        vpp2:= r1*(u2 - upp2) + tx + s2Inv - vh2 + h3*upp2;
        vpp1:= r1*(u1 - upp1) + ty - vh1 + h3*upp1;
        vpp0:= r1*(u0 - upp0) + u1*tx - q0*ty + upp1*s2Inv - vh0 + h3*upp0;

        return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    end if;
	// gcd(u,up)=1

    // w1 = (f - v*h - v^2)/u
	ta:= h3*v2;

    //k4:= 1;
    k3:= f6 - u2;
    k2:= f5 - u1 - f6*u2 - ta + u2^2;
    // k1 and k0 are not formed here. Only the top two coefficients of the
    // quotient (f - v*h - v^2)/u are used on this path -- k3 and k2 feed
    // the resultant below -- and the thesis's efficient exact division
    // (sec:exactdiv) says only the highest d1 - d2 + 1 are ever needed. Their
    // former definitions read:
    //   k1:= f4 - u0 - f6*u1 - (h3 + h2)*(v2 + v1) + ta + tb - v2^2 - u2*(k2 - u1);
    //   k0:= f3 - f6*u0 - h3*v0 - tb - u2*(k1 - u0) - u1*(k2) - v2*(h1 + 2*v1);
    // and tb := h2*v1 existed only to serve them.


    //vt = vp - v
    vt2:= vp2 - v2;
    vt1:= vp1 - v1;
    vt0:= vp0 - v0;

    // m6 and m4 close the adjugate. The sp1 row below is their only reader, and
    // it is on the gcd(u,up) = 1 path, so they belong here rather than above the
    // `det eq 0` test -- the special cases all return without reading them.
    //
    // Each is the plain cofactor with a term that is identically zero folded in,
    // which is what lets tf, m8 and m7 stand in for products the cofactor would
    // otherwise need. The zero terms are tc*(tb + temp2 - dw10) for m6 and
    // temp1*temp2 - temp2*temp1 for m4. Both entries are ordinary adjugate
    // values, nonzero for essentially every curve, and the reuse-free forms are
    //   m6 = dw10*tc + up1*temp5 - up0*temp4            (adj_23)
    //   m4 = up2*temp4 - dw11*temp2 - temp3 - temp1*tb   (adj_21)
    //
    // `tf` is assigned once above the `det eq 0` test and reassigned inside it at
    // the dw31^2*dw12^2 block. This read is safe only because every path in
    // that block returns, so the reassignment can never reach here. Preserve that
    // property or move tf's definition down.
    m6:= tf - up1*m8;
    m4:= m8 + up2*m7;

	// partially solve system to get sp = s*det
    sp0:= vt0*m1 + vt1*m2 + vt2*m3;
    sp1:= vt0*m4 + vt1*m5 + vt2*m6;
    sp2:= vt0*m7 + vt1*m8 + vt2*m9;
	// 11m 0s 8a
	// top: 16m 0s 9a
	// total: 27m 0s 17a (equivalent 98a)


    if (sp2 eq 0) then
        if (sp1 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u,up) = 1
            // DB = P1+P2+P3, DA = P4+P5+P6

            // s = sp/det
            s0:= sp0/det;

            // upp = (w1 - s*(h + 2*v + u*s))/up
            upp3:= 0;
            upp2:= 0;
            upp1:= 1;
            upp0:= k3 - up2 - h3*s0 - s0^2;

            // vpp = -h - v - u*s mod upp
            vpp2:= 0;
            vpp1:= 0;
            vpp0:= upp0*(u1*s0 + vh1 + upp0*(s0*(upp0 - u2) - vh2 + h3*upp0)) - vh0 - u0*s0;

            return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u,up) = 1
        // DB = P1+P2+P3, DA = P4+P5+P6

        // s = sp/det, s1Inv = 1/s1, sm = s/s1
        tx:= det;

        w1:= 1/(sp1*tx);        // 1/(s1*det^2)
        w2:= tx*w1;             // 1/sp1 = 1/(s1*det)
        s1Inv:= tx*w2;             // det/(s1*det) = 1/s1

        s1:= sp1^2*w1;          // (s1^2*det^2)/(s1*det^2) = s1
        sm0:= sp0*w2;           // (s0*det)/(s1*det) = s0/s1

        // upp = (w1 - s*(h + 2*v + u*s))/up (made monic)
        tsb:= sm0*u2;

        upp3:= 0;
        upp2:= 1;
        upp1:= dw12 + h3*s1Inv + 2*sm0 - s1Inv^2;
        upp0:= (sm0 - up2)*(upp1 - sm0) + tsb + dw11 + (vh2 + v2 + (sm0 - k3)*s1Inv)*s1Inv;

        // vpp = -h - v - u*s mod upp
        tn3:= s1*(upp1 - u2 - sm0) - h3;
        tx:= upp1*tn3;
        tn2:= s1*(upp0 - u1 - tsb) - vh2 - tx;
        ty:= upp0*tn2;

        vpp2:= 0;
        vpp1:= -s1*(u0 + u1*sm0) - vh1 - (upp0 + upp1)*(tn2 + tn3) + tx + ty;        // karatsuba
        vpp0:= -s1*(u0*sm0) - vh0 - ty;

        return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(u,up) = 1
    // DB = P1+P2+P3, DA = P4+P5+P6
    // return P1+P2+P3+P4+P5+P6

    // s = sp/(det), s2Inv = 1/s2, sm = s/s2
    tx:= det;

    w1:= 1/(sp2*tx);        // 1/(s2*det^2)
    w2:= tx*w1;             // det/(s2*det^2) = 1/(s2*det)
    s2Inv:= tx*w2;             // det/(s2*det) = 1/s2

    s2:= sp2^2*w1;          // (s2^2*det^2)/(s2*det^2) = s2
    sm1:= sp1*w2;           // s1*det/(s2*det) = s1/s2
    sm0:= sp0*w2;           // s0*det/(s2*det) = s0/s2

	// q,r = DivRem(up,s)
    // q = quot(up/s)
    //q1:= 1;           //s2
    q0:= up2 - sm1;     //s2

    // r = up mod s
    r1:= s2*(up1 - sm1*q0 - sm0);       //s2
    r0:= s2*(up0 - sm0*q0);             //s2

    // M1 = (q*(vp - v) + r*u)/up
    //M11:= r1;                 //s2^2
    M10:= vt2 + r0 + r1*dw12;     //s2

    // M2 = (r*(h + vp + v) + q*w1)/up
    //M22:= 1;                                                              //s2
    M21:= k3 + h3*r1 - sm1;                                                 //s2
    M20:= k2 + h3*r0 - sm1*(k3 - up2) + r1*(ht2 - h3*up2) - up1;      		//s2

    // upp = r*M1 - q*M2 (monic)
    upp3:= 1;
    upp2:= M21 - r1^2 + q0;
    upp1:= M20 - r1*(M10 + r0) + M21*q0;
    upp0:= M20*q0 - r0*M10;

    // vpp = ((u*r - upp)/q - v - h) mod upp
    tx:= r0 - r1*q0;
    ty:= (u2 - q0)*tx + (upp2 - q0)*s2Inv;        // shared by vpp1 and vpp0

    vpp2:= r1*(u2 - upp2) + tx + s2Inv - vh2 + h3*upp2;
    vpp1:= r1*(u1 - upp1) + ty - vh1 + h3*upp1;
    vpp0:= r1*(u0 - upp0) + u1*tx - q0*ty + upp1*s2Inv - vh0 + h3*upp0;

    return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// ADD():
// Input: D1, D2:     divisors as [u, v] polynomial pairs, any degrees
//        f, h, h:    curve polynomials
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = D1 + D2
//
// Description: Dispatches on the operand degrees to the Deg* cases above,
//              normalising the larger-degree divisor first. D1 = D2 is routed
//              to DBL, so the D1 != D2 assumption of the cases holds below.
///////////////////////////////////////////////////////////////////////////////
ADD:= function(D1, D2, f, h)//startIGNORE

    // D1 = D2 is a doubling, not an addition: the Deg* cases below assume
    // D1 != D2 (the thesis Require clause) and return wrong results without it.
    // Above the operand sort on purpose -- identical operands have nothing to
    // normalise, and the guard then owes nothing to the tie-break for
    // equal-degree u.
    if D1 eq D2 then
        return DBL(D1,f,h);
    end if;

    // ensure u is always the larger polynomial
    if D2[1] le D1[1] then
        u:= D1[1]; v:= D1[2];
        up:= D2[1]; vp:= D2[2];

    else
        up:= D1[1]; vp:= D1[2];
        u:= D2[1]; v:= D2[2];

    end if;

    f7:= Coeff(f, 7); f6:= Coeff(f, 6); f5:= Coeff(f, 5); f4:= Coeff(f, 4); f3:= Coeff(f, 3); f2:= Coeff(f, 2); f1:= Coeff(f, 1); f0:= Coeff(f, 0);
    h3:= Coeff(h,3); h2:= Coeff(h,2); h1:= Coeff(h,1); h0:= Coeff(h,0);

    u3:= Coeff(u,3); u2:= Coeff(u,2); u1:= Coeff(u,1); u0:= Coeff(u,0);
    v2:= Coeff(v,2); v1:= Coeff(v,1); v0:= Coeff(v,0);

    up3:= Coeff(up,3); up2:= Coeff(up,2); up1:= Coeff(up,1); up0:= Coeff(up,0);
    vp2:= Coeff(vp,2); vp1:= Coeff(vp,1); vp0:= Coeff(vp,0);

    if (u3 ne 0) then
        if (up3 ne 0) then
            return Deg3ADD(u2, u1, u0, v2, v1, v0, up2, up1, up0, vp2, vp1, vp0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);

        elif (up2 ne 0) then
            return Deg23ADD(up1, up0, vp1, vp0, u2, u1, u0, v2, v1, v0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);

        elif (up1 ne 0) then
            return Deg13ADD(up0, vp0, u2, u1, u0, v2, v1, v0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);

        else
			return u3, u2, u1, u0, v2, v1, v0;

		end if;

    elif (u2 ne 0) then
        if (up2 ne 0) then
            return Deg22ADD(u1, u0, v1, v0, up1, up0, vp1, vp0, f6, f5, f4, f3, f2, h3, h2, h1, h0);

        elif (up1 ne 0) then
            return Deg12ADD(up0, vp0, u1, u0, v1, v0, f6, f5, f4, f3, f2, h3, h2, h1, h0);
            
        else
            return u3, u2, u1, u0, v2, v1, v0;
        
        end if;
    
    elif (u1 ne 0) then
        if (up1 ne 0) then
            return Deg1ADD(u0, v0, up0, vp0);
            
        else
            return u3, u2, u1, u0, v2, v1, v0;
        
        end if;     
    
    else
        return u3, u2, u1, u0, v2, v1, v0;
    
    end if;
        
    "THIS SHOULD NEVER HAPPEN";
    return -1, -1, -1, -1, -1, -1, -1; 
    
end function;//endIGNORE
