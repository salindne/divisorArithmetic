///////////////////////////////////////////////////////////////////////////////
// Author: Randall Apperley, Amir Asgari, Sebastian Lindner                                                       
//
// Description: Explicit divisor addition formulas for the 4 coordinate
//              Mumford representation over arbitrary fields where:
//
//              h(x) = h3*x^3 + h2*x^2 + h1*x + h0 (h3 in {0,1}) and
//              f(x) = x^7 + f6x^6 + f5x^5 + f4x^4 + f3x^3 + f2x^2 + f1x + f0
//
// On h3 in {0,1}: always reachable, and here a costing convention rather than a
//              domain restriction. Reachable because x -> a^2*x, y -> a^7*y
//              (dividing through by a^14) leaves f monic and sends h's leading
//              coefficient to h3/a, so a = h3 makes h monic; no division by 2,
//              3 or 7 is involved, so it holds in every characteristic. It is
//              declared so h3 can be //Ignore'd, which is only sound when h3 is
//              0 or 1. Note the contrast with genus 2, which is about how the
//              formulas were derived and not about the mathematics: the same
//              scaling makes h monic there too, but the genus-2 formulas were
//              written using the assumption, so they are wrong for h2 outside
//              {0,1} in every characteristic tested (char 2, 3, 5, 7, 11, 13 --
//              not a GF(4) quirk). These genus-3 formulas were written
//              generically in h3 and were measured correct outside {0,1}, so
//              the declaration narrows what is claimed and tested, not what
//              works -- and the assumption is so far declared but unexploited.
//
// Precondition: the Deg* cases below assume D1 != D2 (the thesis Require
//               clause). The ADD dispatcher routes D1 = D2 to DBL, so callers
//               need not check; calling a Deg* case directly still requires it.
///////////////////////////////////////////////////////////////////////////////


//Must keep next line in this format for latex conversion
//Constant: f6,f5,f4,f3,f2,f1,f0,h2,h1,h0
//Ignore: h3

///////////////////////////////////////////////////////////////////////////////
// Deg1ADD():
// Input: u1_0, v1_0: Mumford coordinates for degree 1 divisor D1
//        u2_0, v2_0: Mumford coordinates for degree 1 divisor D2
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of two degree one
//              divisors. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg1ADD:= function(u1_0, v1_0, u2_0, v2_0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    //No curve coefficients are needed: with u1 = u2 and D1 ne D2, the two
    //v values are the two roots of y^2 + h(x0)y = f(x0), so D2 = -D1 and
    //the sum is the neutral element.
    FF := Parent(u1_0);
    R<x> := PolynomialRing(FF);
    u1 := x + u1_0;
    v1 := R!v1_0;
    u2 := x + u2_0;
    v2 := R!v2_0;

    d := u1 mod u2;
    if IsZero(d) then
        return 0, 0, 0, 1, 0, 0, 0;
    end if;
    s := (v2 - v1)*FF!Coeff(d,0)^-1 mod u2;
    un := u1*u2;
    vn := (v1 + u1*s) mod un;
    return Coeff(un,3), Coeff(un,2), Coeff(un,1), Coeff(un,0),
           Coeff(vn,2), Coeff(vn,1), Coeff(vn,0);
    */ //endIGNORE
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u1,u2) = 1	(typical)
    // 2) gcd(u1,u2) = u1	(DB = P1, DA = -P1, return P0)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++
    
    // d = u1 mod u2
    d0:= u1_0 - u2_0;
    
    // if gcd(u1,u2) = u1
    if (d0 eq 0) then
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u1,u2) = u1
        // DB = P1, DA = -P1
        // return P0
        
		if (ADD_DEBUG) then "Deg1ADD | Case #2: gcd(u1,u2) = u1"; end if;
        return 0, 0, 0, 1, 0, 0, 0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;
    
    // ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(u1,u2) = 1
    // DB = P1, DA = P2
    // return P1+P2
    
    // s = (v2 - v1)/u1 mod u2 = (v2 - v1) * d^-1
    d0Inv := d0^-1;
    s0:= d0Inv * (v2_0 - v1_0);

    // un = u1*u2
    un3:= 0;
    un2:= 1;
    un1:= u1_0 + u2_0;
    un0:= u1_0*u2_0;

    // vn = (v1 + u1*s) mod un
    vn2:= 0;
    vn1:= s0;
    vn0:= v1_0 + u1_0*s0;
    
	if (ADD_DEBUG) then "Deg1ADD | Typical"; end if;
    return un3, un2, un1, un0, vn2, vn1, vn0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg12ADD():
// Input: u1_1..v1_0: Mumford coordinates for degree 2 divisor D1 (deg 2 first)
//        u2_0, v2_0: Mumford coordinates for degree 1 divisor D2
//        f6..f2, h3..h0: curve coefficients
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of a degree two and a
//              degree one divisor. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg12ADD:= function(u1_1, u1_0, v1_1, v1_0, u2_0, v2_0, f6, f5, f4, f3, f2, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(u1_0);
    R<x> := PolynomialRing(FF);
    //f0 is not an argument (nor is f1): at every division below the absent
    //coefficients have degree below the divisor's, so they stay in the
    //discarded remainder; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    u1 := x^2 + u1_1*x + u1_0;
    v1 := v1_1*x + R!v1_0;
    u2 := x + u2_0;
    v2 := R!v2_0;

    k := (f - v1*(v1 + h)) div u1;

    S, a1, b1 := XGCD(u1, u2);
    if not IsOne(S) then
        S, a2, b2 := XGCD(S, v2 + v1 + h);
        if not IsOne(S) then
            u1 := ExactQuotient(u1, S);
            u2 := ExactQuotient(u2, S);
        end if;
        s := (a2*a1*(v2 - v1) + b2*k) mod u2;
    else
        s := a1*(v2 - v1) mod u2;
    end if;

    if Degree(u1) + Degree(u2) le 3 then
        //composition only (a gcd case shrank the degrees)
        un := u1*u2;
        vn := (v1 + u1*s) mod un;
    else
        //one reduction: un = (k*S - s*(s*u1 + 2*v1 + h))/u2, monic
        un := ExactQuotient(k*S - s*(s*u1 + 2*v1 + h), u2);
        un := un/LeadingCoefficient(un);
        vn := (-s*u1 - v1 - h) mod un;
    end if;
    return Coeff(un,3), Coeff(un,2), Coeff(un,1), Coeff(un,0),
           Coeff(vn,2), Coeff(vn,1), Coeff(vn,0);
    */ //endIGNORE
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u1,u2) = 1	            (typical)
    // 2) gcd(u1,u2) = u2
	//		2.1) gcd(u2,h+v2+v1) = 1	(DB = P1, DA = P1+P2, return 2P1+P2)
	//		2.2) gcd(u2,h+v2+v1) = u2	(DB = P1, DA = P2-P1, return P2)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++

	// t1 = h + v1
	t1_1:= h1 + v1_1;
	t1_0:= h0 + v1_0;

    // d = u1 mod u2
	u2_0Sq := u2_0^2;
    u2_0Timesu1_1 := u2_0*u1_1;
    d0:= u1_0 - u2_0Timesu1_1 + u2_0Sq;

    // if gcd(u1,u2) = u2
    if (d0 eq 0) then
        // dw = (h + v2 + v1) mod u2
        dw0:= t1_0 + v2_0 - u2_0*(t1_1 - h2*u2_0 + h3*u2_0Sq);

        // if gcd(u2,h+v2+v1) = u2
        if (dw0 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = u2
			// gcd(u2,v2+v1+h) = u2
            // DB = P1, DA = P2-P1
            // return P2

            // un = u1/u2
            un3:= 0;
            un2:= 0;
            un1:= 1;
            un0:= u1_1 - u2_0;

            // vn = v1 mod un
            vn2:= 0;
            vn1:= 0;
            vn0:= v1_0 - v1_1*un0;

			if (ADD_DEBUG) then "Deg12ADD (deg 2 first) | Case #2.2: gcd(u1,u2) = u2, gcd(u2,h+v2+v1) = u2"; end if;
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u1,u2) = u2
		// gcd(u2,v2+v1+h) = 1
        // DB = P1, DA = P1+P2
        // return 2P1+P2

        // w1 = (f - v1*h - v1^2)/u1
        //w1_5:= 1;
        w1_4:= f6 - u1_1;
		ta:= u1_1*w1_4;
        w1_3:= f5 - u1_0 - ta;
		tb:= u1_0*w1_3;
        w1_2:= f4 - h3*v1_1 - (u1_0 + u1_1)*(w1_3 + w1_4) + ta + tb;		// karatsuba
        w1_1:= f3 - h3*v1_0 - h2*v1_1 - tb - u1_1*w1_2;
        w1_0:= f2 - h2*v1_0 - v1_1*t1_1 - u1_0*w1_2 - u1_1*w1_1;

        // sp = w1 mod u2
        //sp5:= 1;
        sp4:= w1_4 - u2_0;
		sp3:= w1_3 - u2_0*sp4;
        sp2:= w1_2 - u2_0*sp3;
        sp1:= w1_1 - u2_0*sp2;
        sp0:= w1_0 - u2_0*sp1;

        // s = (u2^-1 mod h+v2+v1)*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod u2)*w1 mod u2
        //   = (       a2        )*(     a1     )*(v2-v1) + (       b2        )*(  sp  )
        //   = (       a2        )*(     0      )*(v2-v1) + (      1/dw       )*(  sp  )
        //   = sp/dw
        s0:= sp0/dw0;

        // un = u2*u1
        un3:= 1;
        un2:= u2_0 + u1_1;
        un1:= u2_0Timesu1_1 + u1_0;
        un0:= u2_0*u1_0;

        // vn = (u1*s + v1) mod un
        vn2:= s0;
        vn1:= u1_1*s0 + v1_1;
        vn0:= u1_0*s0 + v1_0;

		if (ADD_DEBUG) then "Deg12ADD (deg 2 first) | Case #2.1: gcd(u1,u2) = u2, gcd(u2,h+v2+v1) = 1"; end if;
        return un3, un2, un1, un0, vn2, vn1, vn0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(u1,u2) = 1
    // DB = P1, DA = P2+P3
    // return P1+P2+P3

    // s = (v2 - v1)/u1 mod u2
    s0:= (v2_0 - v1_0 + u2_0*v1_1)/d0;

    // un = u2*u1
    un3:= 1;
    un2:= u2_0 + u1_1;
    un1:= u2_0Timesu1_1 + u1_0;
    un0:= u2_0*u1_0;

    // vn = u1*s + v1 mod un
    vn2:= s0;
    vn1:= u1_1*s0 + v1_1;
    vn0:= u1_0*s0 + v1_0;

	if (ADD_DEBUG) then "Deg12ADD (deg 2 first) | Typical"; end if;
    return un3, un2, un1, un0, vn2, vn1, vn0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg22ADD():
// Input: u1_1..v1_0: Mumford coordinates for degree 2 divisor D1
//        u2_1..v2_0: Mumford coordinates for degree 2 divisor D2
//        f6..f2, h3..h0: curve coefficients
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of two degree two
//              divisors. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg22ADD:= function(u1_1, u1_0, v1_1, v1_0, u2_1, u2_0, v2_1, v2_0, f6, f5, f4, f3, f2, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(u1_0);
    R<x> := PolynomialRing(FF);
    //f0 is not an argument (nor is f1): at every division below the absent
    //coefficients have degree below the divisor's, so they stay in the
    //discarded remainder; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    u1 := x^2 + u1_1*x + u1_0;
    v1 := v1_1*x + R!v1_0;
    u2 := x^2 + u2_1*x + u2_0;
    v2 := v2_1*x + R!v2_0;

    k := (f - v1*(v1 + h)) div u1;

    S, a1, b1 := XGCD(u1, u2);
    if not IsOne(S) then
        S, a2, b2 := XGCD(S, v2 + v1 + h);
        if not IsOne(S) then
            u1 := ExactQuotient(u1, S);
            u2 := ExactQuotient(u2, S);
        end if;
        s := (a2*a1*(v2 - v1) + b2*k) mod u2;
    else
        s := a1*(v2 - v1) mod u2;
    end if;

    if Degree(u1) + Degree(u2) le 3 then
        //composition only (a gcd case shrank the degrees)
        un := u1*u2;
        vn := (v1 + u1*s) mod un;
    else
        //one reduction: un = (k*S - s*(s*u1 + 2*v1 + h))/u2, monic
        un := ExactQuotient(k*S - s*(s*u1 + 2*v1 + h), u2);
        un := un/LeadingCoefficient(un);
        vn := (-s*u1 - v1 - h) mod un;
    end if;
    return Coeff(un,3), Coeff(un,2), Coeff(un,1), Coeff(un,0),
           Coeff(vn,2), Coeff(vn,1), Coeff(vn,0);
    */ //endIGNORE
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u1,u2) = 1
    //      1.1) DB = P1+P2, DA = P3+P4         (typical)
    // 2) gcd(u1,u2) = d (deg 1)
    //      2.1) gcd(d,h+v2+v1) = 1				(DB = P1+P2, DA = P1+P3, return 2P1+P2+P3)
    //      2.2) gcd(d,h+v2+v1) = d				(DB = P1+P2, DA = P3-P1, return P2+P3)
    // 3) gcd(u1,u2) = u2
    //      3.1) gcd(u2,h+v2+v1) = dw (deg 1)	(DB = P1+P2, DA = P2-P1, return 2P2)
    //      3.2) gcd(u2,h+v2+v1) = u2			(DB = P1-P2, DA = P2-P1, return P0)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++

	h3Timesu2_1:= h3*u2_1;

	// t1 = h + v1
	t1_1:= h1 + v1_1;
	t1_0:= h0 + v1_0;

	// vt = v2 - v1
	vt_1:= v2_1 - v1_1;
	vt_0:= v2_0 - v1_0;

    // dw1 = u1 mod u2
    dw1_1:= u1_1 - u2_1;
    dw1_0:= u1_0 - u2_0;

    // set up system of equations to solve for s = (v2-v1)/u1 mod u2
    // and find the determinant
    // from Lindner's MSc thesis (pages 63-64)
    m4:= dw1_0;
    m3:= -dw1_1;
    m2:= -u2_0*m3;
	m1:= m4 + u2_1*m3;

    det:= m4*m1 - m2*m3;

    // if gcd(u1,u2) != 1
    if (det eq 0) then

		// ht = t1 + v2
		v2Plust1_1:= t1_1 + v2_1;
		v2Plust1_0:= t1_0 + v2_0;

        // if gcd(u1,u2) = u2
        if (dw1_1 eq 0) then
			temp2:= h2 - h3Timesu2_1;

            // dw2 = (h + v2 + v1) mod u2
            dw2_1:= v2Plust1_1 - h3*u2_0 - u2_1*temp2;
            dw2_0:= v2Plust1_0 - u2_0*temp2;

            // if gcd(u2,h+v2+v1) = u2
            if (dw2_1 eq 0 and dw2_0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = u2
				// gcd(u2,h+v2+v1) = u2
                // DB = P1-P2, DA = P2-P1
                // return P0

				if (ADD_DEBUG) then "Deg22ADD | Case #3.2: gcd(u1,u2) = u2, gcd(u2,h+v2+v1) = u2"; end if;
                return 0, 0, 0, 1, 0, 0, 0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = u2	=> a1=0, b1=1
			// gcd(u2,h+v2+v1) = dw
            // DB = P1+P2, DA = P2-P1
            // return 2P2

			// w1 = (f - v1*h - v1^2)/u1
			//w1_5:= 1;
			w1_4:= f6 - u1_1;
			ta:= u1_1*w1_4;
			w1_3:= f5 - u1_0 - ta;
			tb:= u1_0*w1_3;
			w1_2:= f4 - h3*v1_1 - (u1_0 + u1_1)*(w1_3 + w1_4) + ta + tb;		// karatsuba
			w1_1:= f3 - h3*v1_0 - h2*v1_1 - tb - u1_1*w1_2;
			w1_0:= f2 - h2*v1_0 - v1_1*t1_1 - u1_0*w1_2 - u1_1*w1_1;

            // at = (  u2^-1 mod h+v2+v1   )*dw2_1
            //    = ( (-(h+v2+v1)/u2)/dw2_1  )*dw2_1
            //    = (          a2          )*dw2_1
            //at_1:= -h3;
            //at_0:= -temp2;

            // st = ((u2^-1 mod h+v2+v1)*dw2_1)*(u1^-1 mod u2)*(v2-v1) + ((h+v2+v1^-1 mod u2)*dw2_1)*w1
            //    = ((       a2        )*dw2_1)*(     a1     )*( vt  ) + ((       b2        )*dw2_1)*w1
            //    = (           at          )*(     0      )*( vt  ) + (           1           )*w1
            //    = w1
            //st5:= 1;
            //st4:= w1_4;
            //st3:= w1_3;
            //st2:= w1_2;
            //st1:= w1_1;
            //st0:= w1_0;

            //dm = dw2/dw2_1	(dm = monic(dw2))
            dw2_1Inv:= 1/dw2_1;
            dm_0:= dw2_0*dw2_1Inv;

            // u1 = u1/dm
            u1_0:= u1_1 - dm_0;

            // SWAPPING st WITH w1 ALSO WORKS????
            // sp = st mod u1
            //sp5:= 1;
            sp4:= w1_4 - u1_0;
            sp3:= w1_3 - u1_0*sp4;
            sp2:= w1_2 - u1_0*sp3;
            sp1:= w1_1 - u1_0*sp2;
            sp0:= w1_0 - u1_0*sp1;

            // s = sp/dw2_1
            s0:= sp0*dw2_1Inv;

            // un = u1*u2 = u1^2
            un3:= 0;
            un2:= 1;
            un1:= u1_0 + u1_0;
            un0:= u1_0^2;

            // vn = (u1*s + v1) mod un
            vn2:= 0;
            vn1:= s0 + v1_1;
            vn0:= u1_0*s0 + v1_0;

			if (ADD_DEBUG) then "Deg22ADD | Case #3.1: gcd(u1,u2) = u2, gcd(u2,h+v2+v1) = dw (deg 1)"; end if;
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // dw3 = (h + v2 + v1) mod dw1
        dw1_1Sq:= dw1_1^2;
        dw3_0:= dw1_1Sq*(dw1_1*v2Plust1_0 - dw1_0*v2Plust1_1) + dw1_0^2*(h2*dw1_1 - h3*dw1_0);		//dw1_1^3

        // if gcd(dw1,h+v2+v1) = dw1
        if (dw3_0 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // S = gcd(u1,u2) = dw1, actually the monic of the latter
              // a1 = lcf(dw1)^-1 = u1^-1 mod u2
			// S' = gcd(dw1,h+v2+v1) = monic(dw1)
            // DB = P1+P2, DA = P3-P1
            // return P2+P3

            // dm = monic(dw1) = dw1/dw1_1
            dw1_1Inv:= 1/dw1_1;
            // dm_1 = 1
        	dm_0:= dw1_0*dw1_1Inv;

            // u1 = u1/dm
            u1_0:= u1_1 - dm_0;
            // u2 = u2/dm
            u2_0:= u2_1 - dm_0;

            // s = vt/u1 mod u2
            s0:= (vt_0 - u2_0*vt_1)*dw1_1Inv;

            // un = u2*u1
            un3:= 0;
            un2:= 1;
            un1:= u2_0 + u1_0;
            un0:= u2_0*u1_0;

            // vn = (u1*s + v1) mod un
            vn2:= 0;
            vn1:= s0 + v1_1;
            vn0:= u1_0*s0 + v1_0;

			if (ADD_DEBUG) then "Deg22ADD | Case #2.2: gcd(u1,u2) = d (deg 1), gcd(d,h+v2+v1) = d"; end if;
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u1,u2) = dw1
		// gcd(dw1,h+v2+v1) = 1
        // DB = P1+P2, DA = P1+P3
        // return 2P1+P2+P3

        // w1 = (f - v1*h - v1^2)/u1
        //w1_5:= 1;
        w1_4:= f6 - u1_1;
		ta:= u1_1*w1_4;
        w1_3:= f5 - u1_0 - ta;
		tb:= u1_0*w1_3;
        w1_2:= f4 - h3*v1_1 - (u1_0 + u1_1)*(w1_3 + w1_4) + ta + tb;		// karatsuba
        w1_1:= f3 - h3*v1_0 - h2*v1_1 - tb - u1_1*w1_2;
        w1_0:= f2 - h2*v1_0 - v1_1*t1_1 - u1_0*w1_2 - u1_1*w1_1;

        // a1 = u1^-1 mod u2
        //    = 1/dw1_1
        w0:= 1/(dw3_0*dw1_1);
        a1:= dw3_0*w0;            // (dw3_0)/(dw3_0*dw1_1) = 1/dw1_1

        // b2 = h+v2+v1^-1 mod dw1
        //    = 1/dw3_0 (or dw1_1^3 / dw3_0?)
        b2:= (dw1_1Sq^2)*w0;

        // dm = dw1/dw1_1 = monic(dw1)
        //dm_1:= 1;
        dm_0:= dw1_0*a1;            // dw1_0/dw1_1

        // vp = a1*vt
        vp_1:= a1*vt_1;
        vp_2:= a1*vt_0;

        // at = ( dm^-1 mod h+v2+v1 )*dw3_0
        //    = ((-(h+v2+v1)/dm)/dw3_0)*dw3_0
        //    = (        a2         )*dw3_0
        //    = -(h + v2 + v1)/dm
        //at_2:= -h3;
        at_1:= -h2 + h3*dm_0;
        at_0:= -v2Plust1_1 - dm_0*at_1;

        // st = (( dm^-1 mod h+v2+v1)*dw3_0)*((u1^-1 mod u2)*(v2-v1)) + ((h+v2+v1^-1 mod dm)*dw3_0)*w1
        //    = ((        a2        )*dw3_0)*((     a1     )*(v2-v1)) + (         b2       )*dw3_0)*w1
        //    = (           at           )*(          vp          ) + (           1           )*w1
        //    = w1 + at*vp
        ta:= at_1*vp_1;
        tb:= at_0*vp_2;

        //st5:= 1;
        //st4:= w1_4;
        st3:= w1_3 - h3*vp_1;
        st2:= w1_2 - h3*vp_2 + ta;
        st1:= w1_1 + (at_0 + at_1)*(vp_1 + vp_2) - ta - tb;		// karatsuba
        st0:= w1_0 + tb;

        // sp = st mod u2
        //sp5:= 1;
        sp4:= w1_4 - u2_1;
		temp3:= u2_1*sp4;
        sp3:= st3 - u2_0 - temp3;
        ta:= u2_0*sp3;
        sp2:= st2 - (u2_0 + u2_1)*(sp3 + sp4) + temp3 + ta;     // karatsuba
        sp1:= st1 - ta - u2_1*sp2;
        sp0:= st0 - u2_0*sp2;

        // s = sp/dw3_0
        s1:= sp1*b2;
        s0:= sp0*b2;

        // un = (w1 - s*(h + 2*v1 + u1*s))/u2
		ta:= u1_1*s0;
        temp4:= t1_1 + u1_0*s1 + ta;
		temp5:= h2 + s0;

        un3:= 1;
        un2:= sp4 - h3*s1 - s1^2;
        un1:= w1_3 - u2_0 - h3*s0 - s1*(s1*dw1_1 + s0 - h3Timesu2_1 + temp5) - temp3;
        un0:= w1_2 - u2_0*un2 - u2_1*un1 - s0*temp5 - s1*(v1_1 + ta + temp4);

        // vn = -h - v1 - u1*s mod un
        ta:= h3 + s1;

        vn2:= s1*(un2 - u1_1) + h3*un2 - temp5;
        vn1:= un1*ta - temp4;
        vn0:= un0*ta - t1_0 - u1_0*s0;

		if (ADD_DEBUG) then "Deg22ADD | Case #2.1: gcd(u1,u2) = d (deg 1), gcd(d,h+v2+v1) = 1"; end if;
        return un3, un2, un1, un0, vn2, vn1, vn0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(u1,u2) = 1
    // DB = P1+P2, DA = P3+P4
    // return P1+P2+P3+P4

    // w1 = (f - v1*h - v1^2)/u1
    //w1_5:= 1;
    w1_4:= f6 - u1_1;
    w1_3:= f5 - u1_0 - u1_1*w1_4;
    w1_2:= f4 - h3*v1_1 - u1_0*w1_4 - u1_1*w1_3;

    // partially solve system to get sp = s*det
    // from Lindner's MSc thesis (pages 63-64)
    sp1:= vt_1*m4 + vt_0*m3;
    sp0:= vt_0*m1 + vt_1*m2;

    detInv:= 1/det;

    // s = sp/det
    s1:= sp1*detInv;
    s0:= sp0*detInv;

    // un = (w1 - s*(h + 2*v1 + u1*s))/u2
    //	Because deg(w1)=5 and deg(s*(h + 2*v1 + u1*s))=4 and w1 is already monic,
    //	lcf(s)=s1 has no role in lcf of the numerator of un above; so, unlike
    //	Lindner's formulas for genus 2, there's no need to compute lcf(s)^-1=1/s1
    //	and the monic version of s.
    ta:= w1_4 - u2_1;
    tb:= u1_1*s0;
    temp2:= t1_1 + u1_0*s1 + tb;
	temp3:= h2 + s0;

    un3:= 1;
    un2:= ta - h3*s1 - s1^2;
    un1:= w1_3 - u2_0 - h3*s0 - s1*(s1*dw1_1 + s0 - h3Timesu2_1 + temp3) - u2_1*ta;
    un0:= w1_2 - u2_0*un2 - u2_1*un1 - s0*temp3 - s1*(v1_1 + tb + temp2);

    // vn = -h - v1 - u1*s mod un
    ta:= h3 + s1;

    vn2:= s1*(un2 - u1_1) + h3*un2 - temp3;
    vn1:= un1*ta - temp2;
    vn0:= un0*ta - t1_0 - u1_0*s0;

	if (ADD_DEBUG) then "Deg22ADD | Typical"; end if;
    return un3, un2, un1, un0, vn2, vn1, vn0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg13ADD():
// Input: u1_2..v1_0: Mumford coordinates for degree 3 divisor D1 (deg 3 first)
//        u2_0, v2_0: Mumford coordinates for degree 1 divisor D2
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of a degree three and a
//              degree one divisor. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg13ADD:= function(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, u2_0, v2_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(u1_0);
    R<x> := PolynomialRing(FF);
    //f0 is not an argument: at every division below the absent
    //coefficients have degree below the divisor's, so they stay in the
    //discarded remainder; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    u1 := x^3 + u1_2*x^2 + u1_1*x + u1_0;
    v1 := v1_2*x^2 + v1_1*x + v1_0;
    u2 := x + u2_0;
    v2 := R!v2_0;

    k := (f - v1*(v1 + h)) div u1;

    S, a1, b1 := XGCD(u1, u2);
    if not IsOne(S) then
        S, a2, b2 := XGCD(S, v2 + v1 + h);
        if not IsOne(S) then
            u1 := ExactQuotient(u1, S);
            u2 := ExactQuotient(u2, S);
        end if;
        s := (a2*a1*(v2 - v1) + b2*k) mod u2;
    else
        s := a1*(v2 - v1) mod u2;
    end if;

    if Degree(u1) + Degree(u2) le 3 then
        //composition only (a gcd case shrank the degrees)
        un := u1*u2;
        vn := (v1 + u1*s) mod un;
    else
        //one reduction: un = (k*S - s*(s*u1 + 2*v1 + h))/u2, monic
        un := ExactQuotient(k*S - s*(s*u1 + 2*v1 + h), u2);
        un := un/LeadingCoefficient(un);
        vn := (-s*u1 - v1 - h) mod un;
    end if;
    return Coeff(un,3), Coeff(un,2), Coeff(un,1), Coeff(un,0),
           Coeff(vn,2), Coeff(vn,1), Coeff(vn,0);
    */ //endIGNORE
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u1,u2) = 1
    //      1.1) DB = P1, DA = P2+P3+P4     (typical)
    // 2) gcd(u1,u2) = u2
    //      2.1) DB = P1, DA = P1+P2+P3     (return 2P1+P2+P3)
    //      2.2) DB = P1, DA = P2-P1+P3     (return P2+P3)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++

	// t1 = h + v1
	t1_2:= h2 + v1_2;
	t1_1:= h1 + v1_1;
	t1_0:= h0 + v1_0;

	temp1:= h3*u2_0 - t1_2;

    // dw1 = u1 mod u2
	temp2:= u1_2 - u2_0;
    temp3:= u1_1 - u2_0*temp2;

    dw1_0:= u1_0 - u2_0*temp3;

    // if gcd(u1,u2) = u2
    if (dw1_0 eq 0) then

        // dw2 = (h + v2 + v1) mod u2
        dw2_0:= t1_0 + v2_0 - u2_0*(t1_1 + u2_0*temp1);

        // if gcd(u2,h+v2+v1) = u2
        if (dw2_0 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = u2
            // DB = P1, DA = P2-P1+P3
            // return P2+P3

            // un = u1/u2
            un3:= 0;
            un2:= 1;
            un1:= temp2;
            un0:= temp3;

            // vn = v1 mod un
            vn2:= 0;
            vn1:= v1_1 - un1*v1_2;
            vn0:= v1_0 - un0*v1_2;

            if (ADD_DEBUG) then "Deg13ADD (deg 3 first): gcd(u1,u2) = u2, DB = P1, DA = P2-P1+P3"; end if;
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u1,u2) = u2
        // DB = P1, DA = P1+P2+P3
        // return 2P1+P2+P3

        // w1 = (f - v1*h - v1^2)/u1
        //w1_4:= 1;
        w1_3:= f6 - u1_2;
		ta:= u1_2*w1_3;
        w1_2:= f5 - u1_1 - h3*v1_2 - ta;
		tb:= u1_1*w1_2;
        w1_1:= f4 - u1_0 - h3*v1_1 - v1_2*t1_2 - (u1_1 + u1_2)*(w1_2 + w1_3) + ta + tb;		// karatsuba
        w1_0:= f3 - h3*v1_0 - v1_1*t1_2 - v1_2*t1_1 - u1_0*w1_3 - tb - u1_2*w1_1;

        // s = (u2^-1 mod h+v2+v1)*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod u2)*w1 mod u2
        //   = (       a2        )*(     a1     )*(v2-v1) + (        b2       )*w1 mod u2
        //   = (       a2        )*(     0      )*(v2-v1) + (       1/dw2      )*w1 mod u2
        //   = w1/dw2 mod u2
		temp4:= w1_3 - u2_0;
		temp5:= w1_2 - u2_0*temp4;

        s0:= (w1_0 - u2_0*(w1_1 - u2_0*temp5))/dw2_0;
        s0Timesu1_1 := s0*u1_1;

        // un = (w1 - s*(h + 2*v1 + u1*s))/u2
        un3:= 1;
        un2:= temp4 - h3*s0 - s0^2;
        un1:= temp5 - s0*(s0*temp2 - temp1 + v1_2);
        un0:= w1_1 - s0*(s0Timesu1_1 + t1_1 + v1_1) - u2_0*un1;


        // vn = -h - v1 - u1*s mod un
        s0Plush3 := s0 + h3;
        vn2:= s0Plush3*un2 - s0*u1_2 - t1_2;
        vn1:= s0Plush3*un1 - s0Timesu1_1 - t1_1;
        vn0:= s0Plush3*un0 - s0*u1_0 - t1_0;

        if (ADD_DEBUG) then "Deg13ADD (deg 3 first): gcd(u1,u2) = u2, DB = P1, DA = P1+P2+P3"; end if;
        return un3, un2, un1, un0, vn2, vn1, vn0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(u1,u2) = 1
    // DB = P1, DA = P2+P3+P4
    // return P1+P2+P3+P4

    // w1 = (f - v1*h - v1^2)/u1
    //w1_4:= 1;
    w1_3:= f6 - u1_2;
    w1_2:= f5 - u1_1 - h3*v1_2 - u1_2*w1_3;
    w1_1:= f4 - u1_0 - h3*v1_1 - v1_2*t1_2 - u1_1*w1_3 - u1_2*w1_2;

    // s = (v2 - v1)/u1 mod u2
    s0:= (v2_0 - v1_0 + u2_0*(v1_1 - u2_0*v1_2))/dw1_0;

    // un = (w1 - s*(h + 2*v1 + u1*s))/u2
	ta:= w1_3 - u2_0;
    s0Timesu1_1 := s0*u1_1;

    un3:= 1;
    un2:= ta - h3*s0 - s0^2;
    un1:= w1_2 - s0*(s0*temp2 - temp1 + v1_2) - u2_0*ta;
    un0:= w1_1 - s0*(s0Timesu1_1 + t1_1 + v1_1) - u2_0*un1;

    // vn = -h - v1 - u1*s mod un
    s0Plush3 := s0 + h3;
    vn2:= s0Plush3*un2 - s0*u1_2 - t1_2;
    vn1:= s0Plush3*un1 - s0Timesu1_1 - t1_1;
    vn0:= s0Plush3*un0 - s0*u1_0 - t1_0;

    if (ADD_DEBUG) then "Deg13ADD (deg 3 first): Typical"; end if;
    return un3, un2, un1, un0, vn2, vn1, vn0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg23ADD():
// Input: u1_2..v1_0: Mumford coordinates for degree 3 divisor D1 (deg 3 first)
//        u2_1..v2_0: Mumford coordinates for degree 2 divisor D2
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of a degree three and a
//              degree two divisor. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg23ADD:= function(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, u2_1, u2_0, v2_1, v2_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(u1_0);
    R<x> := PolynomialRing(FF);
    //f0 is not an argument: at every division below the absent
    //coefficients have degree below the divisor's, so they stay in the
    //discarded remainder; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    u1 := x^3 + u1_2*x^2 + u1_1*x + u1_0;
    v1 := v1_2*x^2 + v1_1*x + v1_0;
    u2 := x^2 + u2_1*x + u2_0;
    v2 := v2_1*x + R!v2_0;

    k := (f - v1*(v1 + h)) div u1;

    S, a1, b1 := XGCD(u1, u2);
    if not IsOne(S) then
        S, a2, b2 := XGCD(S, v2 + v1 + h);
        if not IsOne(S) then
            u1 := ExactQuotient(u1, S);
            u2 := ExactQuotient(u2, S);
        end if;
        s := (a2*a1*(v2 - v1) + b2*k) mod u2;
    else
        s := a1*(v2 - v1) mod u2;
    end if;

    if Degree(u1) + Degree(u2) le 3 then
        //composition only (a gcd case shrank the degrees)
        un := u1*u2;
        vn := (v1 + u1*s) mod un;
    else
        //one reduction: un = (k*S - s*(s*u1 + 2*v1 + h))/u2, monic
        un := ExactQuotient(k*S - s*(s*u1 + 2*v1 + h), u2);
        un := un/LeadingCoefficient(un);
        vn := (-s*u1 - v1 - h) mod un;
    end if;
    return Coeff(un,3), Coeff(un,2), Coeff(un,1), Coeff(un,0),
           Coeff(vn,2), Coeff(vn,1), Coeff(vn,0);
    */ //endIGNORE
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u1,u2) = 1
    //      1.1) DB = P1+P2, DA = P3+P4+P5 and deg(s) = 1       (typical)
    //      1.2) DB =   "  , DA =    "     and deg(s) = 0
    // 2) gcd(u1,u2) = d s.t. deg(d) = 1
    //      2.1) DB = P1+P2, DA = P1+P3+P4 and deg(s) = 1       (return 2P1+P2+P3+P4)
    //      2.2) DB =   "  , DA =    "     and deg(s) = 0
    //      2.3) DB = P1+P2, DA = P3-P1+P4                      (return P2+P3+P4)
    // 3) gcd(u1,u2) = u2
    //      3.1) DB = P1+P2, DA = P1+P2+P3 and deg(s) = 1       (return 2P1+2P2+P3)
    //      3.2) DB =   "  , DA =    "     and deg(s) = 0
    //      3.3) DB = P1+P2, DA = P2-P1+P3                      (return 2P2+P3)
    //      3.4) DB = P1+P2, DA = P3-P1-P2                      (return P3)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++

	temp1:= h3*u2_1;

	// t1 = h + v1
	t1_2:= h2 + v1_2;
	t1_1:= h1 + v1_1;
	t1_0:= h0 + v1_0;

	// vt = v2 - v1
	//vt_2:= v2_2 - 0 = v2_2;
	vt_1:= v2_1 - v1_1;
	vt_0:= v2_0 - v1_0;

    // dw1 = u1 mod u2
    temp2:= u2_1 - u1_2;
	temp3:= u2_1^2 - u2_0;

    dw1_1:= u1_1 - u2_1*u1_2 + temp3;
    dw1_0:= u1_0 + u2_0*temp2;

    // set up system of equations to solve for s = (v2-v1)/u1 mod u2
    // and find the determinant
    // from Lindner's MSc thesis (pages 63-64)
    m4:= dw1_0;
    m3:= -dw1_1;
    m2:= -u2_0*m3;
    m1:= m4 + u2_1*m3;

    det:= dw1_0*m1 + m2*dw1_1;

    // if gcd(u1,u2) != 1
    if (det eq 0) then

		// ht = t1 + v2
		ht1:= t1_1 + v2_1;
		ht0:= t1_0 + v2_0;

        // if gcd(u1,u2) = u2
        if (dw1_1 eq 0) then

            // dw2 = (h + v2 + v1) mod u2
            ta:= temp1 - t1_2;

            dw2_1:= ht1 - h3*u2_0 + u2_1*ta;
            dw2_0:= ht0 + u2_0*ta;

            // if gcd(u2,h+v2+v1) = u2
            if (dw2_1 eq 0 and dw2_0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = u2
                // DB = P1+P2, DA = P3-P1-P2
                // return P3

                // un = u1/u2
                un3:= 0;
                un2:= 0;
                un1:= 1;
                un0:= -temp2;

                // vn = v1 mod un
                vn2:= 0;
                vn1:= 0;
                vn0:= v1_0 - un0*(v1_1 - v1_2*un0);

                if (ADD_DEBUG) then "Deg23ADD (deg 3 first): gcd(u1,u2) = u2, DB = P1+P2, DA = P3-P1-P2"; end if;
                return un3, un2, un1, un0, vn2, vn1, vn0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

			// w1 = (f - v1*h - v1^2)/u1
			//w1_4:= 1;
			w1_3:= f6 - u1_2;
			ta:= u1_2*w1_3;
			w1_2:= f5 - u1_1 - h3*v1_2 - ta;
			tb:= u1_1*w1_2;
			w1_1:= f4 - u1_0 - h3*v1_1 - v1_2*t1_2 - (u1_1 + u1_2)*(w1_2 + w1_3) + ta + tb;		// karatsuba
			w1_0:= f3 - h3*v1_0 - v1_1*t1_2 - v1_2*t1_1 - u1_0*w1_3 - tb - u1_2*w1_1;

            // dx = u2 mod dw2
            dx_0:= u2_0*dw2_1^2 + dw2_0*(dw2_0 - u2_1*dw2_1);        // w(dx_0) = dw2_1^2

            // if gcd (u2,h+v2+v1) = dw2
            if (dw2_1 ne 0 and dx_0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = u2
                // DB = P1+P2, DA = P2-P1+P3
                // return 2P2+P3

                // dm = dw2/dw2_1, dw2_1Inv = 1/dw2_1
                dw2_1Inv:= 1/dw2_1;
                dm_0:= dw2_0*dw2_1Inv;

                // u2 = u2/dm
                u2_0:= u2_1 - dm_0;

                // u1 = u1/dm
                ta:= u1_2 - dm_0;

                u1_0:= u1_1 - dm_0*ta;
                u1_1:= ta;

                // s = (u2^-1 mod h+v2+v1)*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod u2)*w1 mod u2
                //   = (       a2        )*(     a1     )*(v2-v1) + (        b2       )*w1 mod u2
                //   = (       a2        )*(     0      )*(v2-v1) + (      1/dw2_1      )*w1 mod u2
                //   = w1/dw2 mod u2
                s0:= ((((u2_0 - w1_3)*u2_0  + w1_2)*u2_0 - w1_1)*u2_0 + w1_0)*dw2_1Inv;

                // un = u2*u1
                un3:= 1;
                un2:= u2_0 + u1_1;
                un1:= u2_0*u1_1 + u1_0;
                un0:= u2_0*u1_0;

                // vn = (u1*s + v1) mod un
                vn2:= s0 + v1_2;
                vn1:= u1_1*s0 + v1_1;
                vn0:= u1_0*s0 + v1_0;

                if (ADD_DEBUG) then "Deg23ADD (deg 3 first): gcd(u1,u2) = u2, DB = P1+P2, DA = P2-P1+P3"; end if;
                return un3, un2, un1, un0, vn2, vn1, vn0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // w1R = w1 mod u2
            w1R_3:= w1_3 - u2_1;
			ta:= u2_1*w1R_3;
            w1R_2:= w1_2 - ta - u2_0;
            tb:= u2_0*w1R_2;
            w1R_1:= w1_1 - (u2_0 + u2_1)*(w1R_2 + w1R_3) + ta + tb;		// karatsuba
            w1R_0:= w1_0 - tb;

            // bt = (h+v2+v1^-1 mod u2)*dx
            //    = (   -(u2/dw2)/dx   )*dx
            //    = (       b2        )*dx
            //    = -(u2/dw2)
            bt1:= -dw2_1;                 // w(bt) = dw2_1^2
            bt0:= dw2_0 - u2_1*dw2_1;

            // sp = (u2^-1 mod h+v2+v1)*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod u2)*dx*w1 mod u2
            //    = (       a2        )*(     a1     )*(v2-v1) + (        b2       )*dx*w1 mod u2
            //    = (       a2        )*(     0      )*(v2-v1) + (         bt         )*(  w1R  ) mod u2
            //    = bt*w1R mod u2
            ta:= bt1*w1R_1;
            tb:= bt0*w1R_0;

            //sp2:= ta;				// w(sp) = w(bt)*w(w1R) = w(bt) = dw2_1^2
            sp1:= (bt1 + bt0)*(w1R_1 + w1R_0) - ta - tb - u2_1*ta;		// karatsuba
            sp0:= tb - u2_0*ta;

            if (sp1 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = u2
                // DB = P1+P2, DA = P1+P2+P3

                // s = sp/dx_0
                s0:= sp0/dx_0;

                // un = (w1 - s*(h + 2*v1 + u1*s))/u2
                un3:= 0;
                un2:= 1;
                un1:= w1R_3 - h3*s0 - s0^2;
                un0:= w1R_2 + s0*(temp1 + s0*temp2 - t1_2 - v1_2);

                // vn = -h - v1 - u1*s mod un
                ta:= u1_2 - un1;
                tb:= t1_2 - h3*un1;

                vn2:= 0;
                vn1:= s0*(un1*ta - u1_1 + un0) + un1*tb + h3*un0 - t1_1;
                vn0:= s0*(un0*ta - u1_0) + un0*tb - t1_0;

                if (ADD_DEBUG) then "Deg23ADD (deg 3 first): gcd(u1,u2) = u2, DB = P1+P2, DA = P1+P2+P3, deg(s) = 0"; end if;
                return un3, un2, un1, un0, vn2, vn1, vn0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = u2
            // DB = P1+P2, DA = P1+P2+P3

            // s = sp/dx, s1Inv = 1/s1
            w1:= 1/(sp1*dx_0);       // because sp and dx have weights: 1/(sp1*dx_0*dw2_1^4)
            w2:= dx_0*w1;            // (dx_0*dw2_1^2)/(sp1*dx_0*dw2_1^4) = 1/(sp1*dw2_1^2)
            s1Inv:= dx_0*w2;            // (dx_0*dw2_1^2)/(sp1*dw2_1^2) = dx_0/sp1 = 1/s1

            sm0:= sp0*w2;           // (sp0*dw2_1^2)/(sp1*dw2_1^2) = sp0/sp1 = s0/s1
            s1:= sp1^2*w1;          // (sp1^2*dw2_1^4)/(sp1*dx_0*dw2_1^4) = sp1/dx_0 = s1

            // un = (w1 - s*(h + 2*v1 + u1*s))/u2 (made monic)
            temp4:= sm0*u1_2;
			ta:= u1_1 + temp4;
			tb:= t1_2 + v1_2;

			un3:= 1;
			un2:= h3*s1Inv - temp2 + sm0 + sm0 - s1Inv^2;
			un1:= ta - u2_0 - u2_1*un2 + temp4 + sm0^2 + (tb + h3*sm0 - w1_3*s1Inv)*s1Inv;
			un0:= u1_0 - u2_1*un1 - u2_0*un2 + sm0*(u1_1 + ta) + (t1_1 + v1_1 + sm0*tb - w1_2*s1Inv)*s1Inv;

            // vn = -h - v1 - u1*s mod un
            ta:= u1_2 - un2;
            tb:= u1_1 - un1;
            tc:= u1_0 - un0;

            vn2:= s1*(un2*(ta + sm0) - temp4 - tb) - t1_2 + h3*un2;
            vn1:= s1*(un1*ta - sm0*tb - tc) - t1_1 + h3*un1;
            vn0:= s1*(un0*ta - sm0*tc) - t1_0 + h3*un0;

            if (ADD_DEBUG) then "Deg23ADD (deg 3 first): gcd(u1,u2) = u2, DB = P1+P2, DA = P1+P2+P3, deg(s) = 1"; end if;
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;
        // gcd(u1,u2) = dw1

        // dw3 = (h + v2 + v1) mod dw1
        temp4:= dw1_1^2;
        temp5:= dw1_1*temp4;
        temp6:= dw1_1*t1_2 - dw1_0*h3;       //dw1_1 ?
        temp7:= temp4*ht1 - dw1_0*temp6;		//dw1_1^2 ?

        dw3_0:= temp5*ht0 - dw1_0*temp7;     // w(dw3) = dw1_1^3

        // if gcd(dw1,h+v2+v1) = dw1
        if (dw3_0 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = dw1
            // DB = P1+P2, DA = P3-P1+P4
            // return return P2+P3+P4

            // dw1_1Inv:= 1/dw1_1
            dw1_1Inv:= 1/dw1_1;

            // dm = dw1/dw1_1
        	// dm_1:= 1
            dm_0:= dw1_0*dw1_1Inv;

            // u2 = u2/dm
            u2_0:= u2_1 - dm_0;

            // u1 = u1/dm
            ta:= u1_2 - dm_0;

            u1_0:= u1_1 - dm_0*ta;
            u1_1:= ta;

            // vp = (v2 - v1) mod u2
            //vp2:= -v1_2;
            vp1:= vt_1 + u2_0*v1_2;
            vp0:= vt_0 - u2_0*vp1;

            // s = (dw1^-1 mod h+v2+v1)*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod dw1)*w1 mod u2
            //   = (       a2       )*(     a1     )*(v2-v1) + (       b2       )*w1 mod u2
            //   = (       1        )*(    1/dw1_1    )*(v2-v1) + (       0        )*w1 mod u2
            //   = a1*vp
            s0:= dw1_1Inv*vp0;

            // un = u2*u1
            un3:= 1;
            un2:= u2_0 + u1_1;
            un1:= u2_0*u1_1 + u1_0;
            un0:= u2_0*u1_0;

            // vn = (u1*s + v1) mod un
            vn2:= s0 + v1_2;
            vn1:= u1_1*s0 + v1_1;
            vn0:= u1_0*s0 + v1_0;

            if (ADD_DEBUG) then "Deg23ADD (deg 3 first): gcd(u1,u2) = dw1, DB = P1+P2, DA = P3-P1+P4"; end if;
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

		// w1 = (f - v1*h - v1^2)/u1
		//w1_4:= 1;
		w1_3:= f6 - u1_2;
		ta:= u1_2*w1_3;
		w1_2:= f5 - u1_1 - h3*v1_2 - ta;
		tb:= u1_1*w1_2;
		w1_1:= f4 - u1_0 - h3*v1_1 - v1_2*t1_2 - (u1_1 + u1_2)*(w1_2 + w1_3) + ta + tb;		// karatsuba
		w1_0:= f3 - h3*v1_0 - v1_1*t1_2 - v1_2*t1_1 - u1_0*w1_3 - tb - u1_2*w1_1;

        // at = ( dw1^-1 mod h+v2+v1 )*(u1^-1 mod u2)*dw3_0
        //    = (        a2        )*( a1  )*dw3_0
        //    = ((-(h+v2+v1)/dw1)/dw3_0)*(1/dw1_1 )*dw3_0
        //    = (-(h+v2+v1)/dw1)/dw1_1
        at2:= -h3*temp4; // w(at) = dw1_1^2; but why? Seemingly it should be dw1_1^4 since deg(h+v2+v1)-deg(dw1)+1 = 3-1+1 = 3 and there's an extra div by dw1_1 above.
        at1:= -temp6*dw1_1;
        at0:= -temp7;

        // z = at*vt
        ta:= at1*vt_1;       // w(z) = w(at)*w(vt) = dw1_1^2
        tb:= at0*vt_0;

        z4:= -at2*v1_2;
        z3:= (at1 + at2)*(vt_1 - v1_2) - z4 - ta;           	// karatsuba
        z2:= (at0 + at2)*(vt_0 - v1_2) - z4 + ta - tb;		// karatsuba
        z1:= (at0 + at1)*(vt_0 + vt_1) - ta - tb;           	// karatsuba
        z0:= tb;

        // sp = (dw1^-1 mod h+v2+v1)*dw3_0*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod dw1)*dw3_0*w1 mod u2
        //    = (       a2       )*dw3_0*(     a1     )*( vt  ) + (       b2       )*dw3_0*w1 mod u2
        //    = (       1        )*dw3_0*(    1/dw1_1    )*( vt  ) + (     1/dw3_0      )*dw3_0*w1 mod u2
        //    = z + w1 mod u2
        sp4:= z4 + temp5;                                             //dw1_1^2,dw1_1^3
        ta:= u2_1*sp4;                                               //dw1_1^2,dw1_1^3
        sp3:= z3 + w1_3*temp5 - ta;                                     //dw1_1^2,dw1_1^3
        tb:= u2_0*sp3;                                               //dw1_1^2,dw1_1^3
        sp2:= z2 + w1_2*temp5 - (u2_0 + u2_1)*(sp3 + sp4) + ta + tb;		//dw1_1^2,dw1_1^3 karatsuba
        sp1:= z1 + w1_1*temp5 - u2_1*sp2 - tb;                           //dw1_1^2,dw1_1^3
        sp0:= z0 + w1_0*temp5 - u2_0*sp2;                                //dw1_1^2,dw1_1^3

        if (sp1 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = dw1
            // DB = P1+P2, DA = P1+P3+P4

            // s = sp/dw3
            s0:= sp0/dw3_0;       // (sp0*(z part is dw1_1^2 w1 part is dw1_1^3))/(dw3_0*dw1_1^3) = sp0/dw3_0 = s0

            // un = (w1 - s*(h + 2*v1 + u1*s))/u2
			un3:= 0;
			un2:= 1;
			un1:= w1_3 - u2_1 - h3*s0 - s0^2;
			un0:= w1_2 + s0*(temp1 + s0*temp2 - t1_2 - v1_2) + temp3 - u2_1*w1_3;

            // vn = -h - v1 - u1*s mod un
            ta:= u1_2 - un1;
            tb:= t1_2 - h3*un1;

            vn2:= 0;
            vn1:= s0*(un1*ta - u1_1 + un0) + un1*tb + h3*un0 - t1_1;
            vn0:= s0*(un0*ta - u1_0) + un0*tb - t1_0;

            if (ADD_DEBUG) then "Deg23ADD (deg 3 first): gcd(u1,u2) = dw1, DB = P1+P2, DA = P1+P3+P4, deg(s) = 0"; end if;
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u1,u2) = dw1
        // DB = P1+P2, DA = P1+P3+P4
        // return 2P1+P2+P3+P4

        // s1Inv:= 1/s1, s = sp/dw2, sm = s/s1
                                // for sp*, z part is dw1_1^2 w1 part is dw1_1^3
        w1:= 1/(dw3_0*sp1);       // 1/(dw3_0*sp1*dw1_1^6)
        s1Inv:= dw3_0^2*w1;          // (dw3_0^2*dw1_1^6)/(dw3_0*sp1*dw1_1^6) = dw3_0/sp1 = 1/s1

        sm0:= dw3_0*sp0*w1;       // (dw3_0*sp0*dw1_1^6)/(dw3_0*sp1*dw1_1^6) = sp0/sp1 = s0/s1 = sm0
        s1:= sp1^2*w1;          // (sp1^2*dw1_1^6)/(dw3_0*sp1*dw1_1^6) = sp1/dw3_0 = s1

        // un = (w1 - s*(h + 2*v1 + u1*s))/u2 (made monic)
        temp8:= sm0*u1_2;
		ta:= u1_1 + temp8;
		tb:= t1_2 + v1_2;

		un3:= 1;
		un2:= h3*s1Inv - temp2 + sm0 + sm0 - s1Inv^2;
		un1:= ta - u2_0 - u2_1*un2 + temp8 + sm0^2 + (tb + h3*sm0 - w1_3*s1Inv)*s1Inv;
		un0:= u1_0 - u2_1*un1 - u2_0*un2 + sm0*(u1_1 + ta) + (t1_1 + v1_1 + sm0*tb - w1_2*s1Inv)*s1Inv;

        // vn = -h - v1 - u1*s mod un
        ta:= u1_2 - un2;
        tb:= u1_1 - un1;
        tc:= u1_0 - un0;

        vn2:= s1*(un2*(ta + sm0) - temp8 - tb) - t1_2 + h3*un2;
        vn1:= s1*(un1*ta - sm0*tb - tc) - t1_1 + h3*un1;
        vn0:= s1*(un0*ta - sm0*tc) - t1_0 + h3*un0;

        if (ADD_DEBUG) then "Deg23ADD (deg 3 first): gcd(u1,u2) = dw1, DB = P1+P2, DA = P1+P3+P4, deg(s) = 1"; end if;
        return un3, un2, un1, un0, vn2, vn1, vn0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // w1 = (f - v1*h - v1^2)/u1
    //w1_4:= 1;
    w1_3:= f6 - u1_2;
    w1_2:= f5 - u1_1 - h3*v1_2 - u1_2*w1_3;

    // vp = v2 - v1 mod u2
    //vp2:= v2_2;
    vp1:= vt_1 + u2_1*v1_2;
    vp0:= vt_0 + u2_0*v1_2;

    // partially solve system to get sp = s*det
    // from Lindner's MSc thesis (pages 63-64)
    sp0:= vp0*m1 + vp1*m2;
    sp1:= vp0*m3 + vp1*m4;

    if (sp1 eq 0) then
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u1,u2) = 1
        // DB = P1+P2, DA = P1+P3+P4

        // s = sp/det
        s0:= sp0/det;

        // un = (w1 - s*(h + 2*v1 + u1*s))/u2
        un3:= 0;
        un2:= 1;
        un1:= w1_3 - u2_1 - h3*s0 - s0^2;
        un0:= w1_2 + s0*(temp1 + s0*temp2 - t1_2 - v1_2) + temp3 - u2_1*w1_3;

        // vn = -h - v1 - u1*s mod un
        ta:= u1_2 - un1;
        tb:= t1_2 - h3*un1;

        vn2:= 0;
        vn1:= s0*(un1*ta - u1_1 + un0) + un1*tb + h3*un0 - t1_1;
        vn0:= s0*(un0*ta - u1_0) + un0*tb - t1_0;

        if (ADD_DEBUG) then "Deg23ADD (deg 3 first): Typical, deg(s) = 0"; end if;
        return un3, un2, un1, un0, vn2, vn1, vn0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(u1,u2) = 1
    // DB = P1+P2, DA = P3+P4+P5
    // return P1+P2+P3+P4+P5

    // s1Inv:= 1/s1, s = sp/det, sm = s/s1
    w1:= 1/(det*sp1);       // 1/(s1*det^2)
    w2:= det*w1;            // det/(s1*det^2) = 1/(s1*det)
    s1Inv:= det*w2;            // det/(s1*det) = 1/s1

    sm0:= sp0*w2;           // (s0*det)/(s1*det) = s0/s1
    s1:= sp1^2*w1;          // (s1^2*det^2)/(s1*det^2) = s1

    // un = (w1 - s*(h + 2*v1 + u1*s))/u2 (made monic)
    temp4:= sm0*u1_2;
	ta:= u1_1 + temp4;
	tb:= t1_2 + v1_2;

    un3:= 1;
    un2:= h3*s1Inv - temp2 + sm0 + sm0 - s1Inv^2;
    un1:= ta - u2_0 - u2_1*un2 + temp4 + sm0^2 + (tb + h3*sm0 - w1_3*s1Inv)*s1Inv;
    un0:= u1_0 - u2_1*un1 - u2_0*un2 + sm0*(u1_1 + ta) + (t1_1 + v1_1 + sm0*tb - w1_2*s1Inv)*s1Inv;

    // vn = -h - v1 - u1*s mod un
    ta:= u1_2 - un2;
    tb:= u1_1 - un1;
    tc:= u1_0 - un0;

    vn2:= s1*(un2*(ta + sm0) - temp4 - tb) - t1_2 + h3*un2;
    vn1:= s1*(un1*ta - sm0*tb - tc) - t1_1 + h3*un1;
    vn0:= s1*(un0*ta - sm0*tc) - t1_0 + h3*un0;

    if (ADD_DEBUG) then "Deg23ADD (deg 3 first): Typical"; end if;
    return un3, un2, un1, un0, vn2, vn1, vn0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg3ADD():
// Input: u1_2..v1_0: Mumford coordinates for degree 3 divisor D1
//        u2_2..v2_0: Mumford coordinates for degree 3 divisor D2
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = D1 + D2
//
// Description: Computes the explicit formula for the addition of two degree three
//              divisors. Assumes D1 != D2 (dispatched in ADD).
///////////////////////////////////////////////////////////////////////////////
Deg3ADD:= function(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, u2_2, u2_1, u2_0, v2_2, v2_1, v2_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Nucomp_g3_RAM (ramifiedUtilities.mag) specialised to this degree pair.
    //Assumes D1 ne D2: the ADD dispatcher routes D1 eq D2 to DBL.
    FF := Parent(u1_0);
    R<x> := PolynomialRing(FF);
    //f0 is not an argument: at every division below the absent
    //coefficients have degree below the divisor's, so they stay in the
    //discarded remainder; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    u1 := x^3 + u1_2*x^2 + u1_1*x + u1_0;
    v1 := v1_2*x^2 + v1_1*x + v1_0;
    u2 := x^3 + u2_2*x^2 + u2_1*x + u2_0;
    v2 := v2_2*x^2 + v2_1*x + v2_0;

    k := (f - v1*(v1 + h)) div u1;

    S, a1, b1 := XGCD(u1, u2);
    if not IsOne(S) then
        S, a2, b2 := XGCD(S, v2 + v1 + h);
        if not IsOne(S) then
            u1 := ExactQuotient(u1, S);
            u2 := ExactQuotient(u2, S);
        end if;
        s := (a2*a1*(v2 - v1) + b2*k) mod u2;
    else
        s := a1*(v2 - v1) mod u2;
    end if;

    if Degree(u1) + Degree(u2) le 3 then
        //composition only (a gcd case shrank the degrees)
        un := u1*u2;
        vn := (v1 + u1*s) mod un;
    elif Degree(s) lt 2 then
        //one reduction: un = (k*S - s*(s*u1 + 2*v1 + h))/u2, monic
        un := ExactQuotient(k*S - s*(s*u1 + 2*v1 + h), u2);
        un := un/LeadingCoefficient(un);
        vn := (-s*u1 - v1 - h) mod un;
    else
        //two reductions, the typical case: one continued-fraction step
        //(reachable only with S = 1, as in Nucomp_g3_RAM)
        q, r := Quotrem(u2, s);
        M1 := ExactQuotient((v2 - v1)*q + u1*r, u2);
        M2 := ExactQuotient(r*(v2 + v1 + h) + q*k, u2);
        un := r*M1 - q*M2;
        z := ExactQuotient(u1*r - un, q);
        un := un/LeadingCoefficient(un);
        vn := (z - v1 - h) mod un;
    end if;
    return Coeff(un,3), Coeff(un,2), Coeff(un,1), Coeff(un,0),
           Coeff(vn,2), Coeff(vn,1), Coeff(vn,0);
    */ //endIGNORE
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u1,u2) = 1
    //      1.1) DB = P1+P2+P3, DA = P4+P5+P6 and deg(s) = 2        (typical)
    //      1.2) DB =    "    , DA =    "     and deg(s) = 1
    //      1.3) DB =    "    , DA =    "     and deg(s) = 0
    // 2) gcd(u1,u2) = e s.t. deg(e) = 1
    //      2.1) DB = P1+P2+P3, DA = P1+P4+P5 and deg(s) = 2        (return 2P1+P2+P3+P4+P5)
    //      2.2) DB =    "    , DA =    "     and deg(s) = 1
    //      2.3) DB =    "    , DA =    "     and deg(s) = 0
    //      2.4) DB = P1+P2+P3, DA = P4-P1+P5                       (return P2+P3+P4+P5)
    // 3) gcd(u1,u2) = d s.t. deg(d) = 2
    //      3.1) DB = P1+P2+P3, DA = P1+P2+P4 and deg(s) = 2        (return 2P1+2P2+P3+P4)
    //      3.2) DB = P1+P2+P3, DA = P1+P2+P4 and deg(s) = 1
    //      3.3) DB = P1+P2+P3, DA = P1+P2+P4 and deg(s) = 0
    //      3.4) DB = P1+P2+P3, DA = P2-P1+P4                       (return 2P2+P3+P4)
    //      3.5) DB = P1+P2+P3, DA = P4-P1-P2                       (return P3+P4)
    // 4) gcd(u1,u2) = u2
    //      4.1) DB = P1+P2+P3, DA = P2-P1+P3                       (return 2P2+2P3)
    //      4.2) DB = P1+P2+P3, DA = P3-P1-P2                       (return 2P3)
    //      4.3) DB = P1+P2-P3, DA = P3-P1-P2                       (return P0)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++

	// t1 = h + v1
	t1_0:= h0 + v1_0;
	t1_1:= h1 + v1_1;
	t1_2:= h2 + v1_2;

	// ht = t1 + v2
	// Only ht2 is needed on the generic path -- it is read at the resultant
	// below. ht1 and ht0 are read solely inside the `det eq 0` branch, so they
	// are formed there instead; the special cases pay the same two additions,
	// just later.
	ht2:= t1_2 + v2_2;

    // dw1 = u1 mod u2
    dw1_2:= u1_2 - u2_2;
    dw1_1:= u1_1 - u2_1;
    dw1_0:= u1_0 - u2_0;

    // set up system of equations to solve for s = (v2-v1)/u1 mod u2
    // and find the determinant
	ta:= u2_2*dw1_2;
	tb:= u2_1*dw1_2;
	tc:= u2_0*dw1_2;
	temp1:= dw1_1 - ta;
    temp2:= dw1_0 - tb;
	temp3:= dw1_2*tc;
	temp4:= dw1_1*temp1;
	temp5:= dw1_0*temp1;

    m9:= dw1_0*temp2 + dw1_1*tc;
	m8:= -temp5 - temp3;
	m7:= temp4 - dw1_2*temp2;

    tf:= -u2_0*m7;

    m5:= m9 + u2_2*m8;
    m3:= -u2_0*m8;
    m2:= tf;
    m1:= m5 + u2_1*m7;

    det:= dw1_0*m1 + dw1_1*m2 + dw1_2*m3;

    // if gcd(u1,u2) != 1
    if (det eq 0) then

		ht1:= t1_1 + v2_1;
		ht0:= t1_0 + v2_0;

        // if gcd(u1,u2) = u2
        if (dw1_2 eq 0 and dw1_1 eq 0) then

            // dw2 = (h + v2 + v1) mod u2
            dw2_2:= ht2 - h3*u2_2;
            dw2_1:= ht1 - h3*u2_1;
            dw2_0:= ht0 - h3*u2_0;

            // if gcd(u2,h+v2+v1) = u2
            if (dw2_2 eq 0 and dw2_1 eq 0 and dw2_0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #4.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = u2
                // DB = P1+P2-P3, DA = P3-P1-P2
                // return P0

				if (ADD_DEBUG) then "Deg3ADD: gcd(u1,u2) = u2, DB = P1+P2-P3, DA = P3-P1-P2"; end if;
                return 0, 0, 0, 1, 0, 0, 0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #4.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

			// w1 = (f - v1*h - v1^2)/u1
			//w1_4:= 1;
			w1_3:= f6 - u1_2;
			ta:= u1_2*w1_3;
			w1_2:= f5 - u1_1 - h3*v1_2 - ta;
			tb:= u1_1*w1_2;
			w1_1:= f4 - u1_0 - h3*v1_1 - v1_2*t1_2 - (u1_1 + u1_2)*(w1_2 + w1_3) + ta + tb;		// karatsuba
			w1_0:= f3 - h3*v1_0 - v1_1*t1_2 - v1_2*t1_1 - u1_0*w1_3 - tb - u1_2*w1_1;

            // dx = u2 mod dw2
            ta:= dw2_2^2;
            temp6:= u2_2*dw2_2 - dw2_1;                    //dw2_2

            dx_1:= u2_1*ta - dw2_0*dw2_2 - dw2_1*temp6;		// w(dx) = dw2_2^2
            dx_0:= u2_0*ta - dw2_0*temp6;

            // if gcd(u2,h+v2+v1) = dw2
            if (dx_1 eq 0 and dx_0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #4.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = u2
                // DB = P1+P2+P3, DA = P1-P2-P3
                // return 2P1

                // dw2_2Inv = h+v2+v1^-1 mod u2
                //    = b2
                dw2_2Inv:= 1/dw2_2;

                // dm = dw2/dw2_2
            	// NOTE: No need to compute dm_0 since u1, u2, and dm are monic and we'll do exact divisions u1/dm
            	//	and u2/dm where doing each long division reveals that dm_0 has no role in coeffs of the quotient.
                dm_1:= dw2_1*dw2_2Inv;

                // u2 = u2/dm
                //u2_1:= 1;
                u2_0:= u2_2 - dm_1;

                // u1 = u1/dm
                //u1_1:= 1;
                u1_0:= u1_2 - dm_1;

                // s = (u2^-1 mod h+v2+v1)*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod u2)*w1 mod u2
                //   = (       a2        )*(     a1     )*(v2-v1) + (       b2        )*w1 mod u2
                //   = (       a2        )*(     0      )*(v2-v1) + (       dw2_2Inv        )*w1 mod u2
                //   = w1*dw2_2Inv mod u2
                s0:= (w1_0 - u2_0*(w1_1 - u2_0*(w1_2 - u2_0*(w1_3 - u2_0))))*dw2_2Inv;

                // un = u2*u1
                un3:= 0;
                un2:= 1;
                un1:= u2_0 + u1_0;
                un0:= u2_0*u1_0;

                // vn = (u1*s + v1) mod un
                vn2:= 0;
                vn1:= s0 + v1_1 - un1*v1_2;
                vn0:= u1_0*s0 + v1_0 - un0*v1_2;

				if (ADD_DEBUG) then "Deg3ADD: gcd(u1,u2) = u2, DB = P1+P2+P3, DA = P1-P2-P3"; end if;
                return un3, un2, un1, un0, vn2, vn1, vn0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #4.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #4.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = u2
            // gcd(u2,h+v2+v1) = dx (degree 1)
            // DB = P1+P2+P3, DA = P3+P2-P1
            // return 2P2+2P3

            // dx_1Inv = 1/dx_1, dm = dx/dx_1
            dx_1Inv:= 1/dx_1;			// 1/(dx_1*dw2_2^2) because of weight of dx_1

            //dm_1:= 1;
            dm_0:= dx_0*dx_1Inv;		// (dx_0*dw2_2^2)/(dx_1*dw2_2^2) = dx_0/dx_1

            // bt = (h+v2+v1^-1 mod u2)*dx_1
            //    = (       b2        )*dx_1
            //    = (  (-u2/dw2)/dx_1   )*dx_1
            //    = -u2/dw2
            bt1:= -dw2_2;     // w(bt) = dw2_2^2
            bt0:= -temp6;

            // u2 = u2/dm
            ta:= u2_2 - dm_0;

            u2_0:= u2_1 - dm_0*ta;
            u2_1:= ta;

            // u1 = u1/dm
            ta:= u1_2 - dm_0;

            u1_0:= u1_1 - dm_0*ta;
			u1_1:= ta;

            // w1R = w1 mod u2
            //w1R_4:= 1;
            w1R_3:= w1_3 - u2_1;
            ta:= u2_1*w1R_3;
            w1R_2:= w1_2 - u2_0 - ta;
            tb:= u2_0*w1R_2;
            w1R_1:= w1_1 - (u2_0 + u2_1)*(w1R_2 + w1R_3) + ta + tb;		// karatsuba
            w1R_0:= w1_0 - tb;

            // sp = (u2^-1 mod h+v2+v1)*(u1^-1 mod u2)*dx_1*(v2-v1) + (h+v2+v1^-1 mod u2)*dx_1*w1 mod u2
            //    = (       a2        )*(     a1     )*dx_1*(v2-v1) + (       b2        )*dx_1*w1 mod u2
            //    = (       a2        )*(     0      )*dx_1*(v2-v1) + (          bt         )*(  w1R  ) mod u2
            //    = bt*w1R mod u2
            ta:= bt1*w1R_1;
            tb:= bt0*w1R_0;

            sp1:= (bt0 + bt1)*(w1R_0 + w1R_1) - ta - tb - u2_1*ta;		// w(sp) = dx_1*dw2_2^2, but why? karatsuba
            sp0:= tb - u2_0*ta;

            // s = sp/dx_1
            s1:= sp1*dx_1Inv;        // (s1*dx_1*dw2_2^2)/(dx_1*dw2_2^2) = s1
            s0:= sp0*dx_1Inv;        // (s0*dx_1*dw2_2^2)/(dx_1*dw2_2^2) = s0

            // un = (dm*w1 - s*(h + 2*v1 + u1*s))/u2, why to multiply dm by w1? Based on which step of NUCOMP, etc.?
			temp7:= t1_2 + s0;
			ta:= temp7 + v1_2;
            tb:= s0*u1_1;
			temp8:= t1_1 + tb + s1*u1_0;

            un3:= 1;
            un2:= w1R_3 + dm_0 - h3*s1 - s1^2;
            un1:= w1R_2 - h3*s0 + w1R_3*dm_0 - s1*(ta + s0 - h3*u2_1 - s1*(u2_1 - u1_1));
            un0:= w1_1 + w1_2*dm_0 - u2_1*un1 - u2_0*un2 - s1*(temp8 + v1_1 + tb) - s0*ta;

            // vn = -h - v1 - u1*s mod un
            ta:= h3 + s1;

            vn2:= h3*un2 - temp7 - s1*(u1_1 - un2);
            vn1:= un1*ta - temp8;
            vn0:= un0*ta - t1_0 - u1_0*s0;

			if (ADD_DEBUG) then "Deg3ADD: gcd(u1,u2) = u2, DB = P1+P2+P3, DA = P3+P2-P1"; end if;
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #4.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ew = u2 mod dw1
        ew_1:= m7;		// w(ew) = dw1_2^2
        ew_0:= -m8;

        // if gcd(u1,u2) = dw1
        if (ew_1 eq 0) then

			// vt = v2 - v1
			vt2:= v2_2 - v1_2;
			vt1:= v2_1 - v1_1;
			vt0:= v2_0 - v1_0;

            // dw3 = h + v2 + v1 mod dw1
			temp6:= dw1_2^2;
			ta:= dw1_0*dw1_2;					//dw1_2
            tb:= ht2*dw1_2 - h3*dw1_1;		//dw1_2

            dw3_1:= ht1*temp6 - h3*ta - dw1_1*tb;		// w(dw3) = dw1_2^2
            dw3_0:= ht0*temp6 - dw1_0*tb;

            // if gcd(dw1,h+v2+v1) = dw1
            if (dw3_1 eq 0 and dw3_0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.5 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = dw1
                // DB = P1+P2+P3, DA = P4-P1-P2
                // return P3+P4

                // dw1_2Inv = 1/dw1_2, dm = dw1/dw1_2
                dw1_2Inv:= 1/dw1_2;

                dm_1:= dw1_1*dw1_2Inv;

                // u1 = u1/dw1
                u1_0:= u1_2 - dm_1;

                // u2 = u2/dw1
                u2_0:= u2_2 - dm_1;

                // s = (dw1^-1 mod h+v2+v1)*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod dw1)*w1 mod u2
                //   = (       a2       )*(     a1     )*(v2-v1) + (       b2       )*w1 mod u2
                //   = (       1        )*(    1/dw1_2    )*(v2-v1) + (       0        )*w1 mod u2
                //   = (v2-v1)/dw1_2 mod u2
                s0:= (vt0 - u2_0*(vt1 - u2_0*vt2))*dw1_2Inv;

                // un = u2*u1
                un3:= 0;
                un2:= 1;
                un1:= u2_0 + u1_0;
                un0:= u2_0*u1_0;

                // vn = (u1*s + v1) mod un
                vn2:= 0;
                vn1:= s0 + v1_1 - un1*v1_2;
                vn0:= u1_0*s0 + v1_0 - un0*v1_2;

				if (ADD_DEBUG) then "Deg3ADD: gcd(u1,u2) = dw1, DB = P1+P2+P3, DA = P4-P2-P1"; end if;
                return un3, un2, un1, un0, vn2, vn1, vn0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.5 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

			// w1 = (f - v1*h - v1^2)/u1
			//w1_4:= 1;
			w1_3:= f6 - u1_2;
			ta:= u1_2*w1_3;
			w1_2:= f5 - u1_1 - h3*v1_2 - ta;
			tb:= u1_1*w1_2;
			w1_1:= f4 - u1_0 - h3*v1_1 - v1_2*t1_2 - (u1_1 + u1_2)*(w1_2 + w1_3) + ta + tb;		// karatsuba
			w1_0:= f3 - h3*v1_0 - v1_1*t1_2 - v1_2*t1_1 - u1_0*w1_3 - tb - u1_2*w1_1;

            // dy = dw1 mod dw3
            temp7:= dw3_1^2;
            temp8:= dw1_1*dw3_1 - dw3_0*dw1_2;

            dy_0:= dw1_0*temp7 - dw3_0*temp8;		// w(dy) = dw3_1^2*dw1_2^2, but why?


            // if gcd(dw1,h+v2+v1) = dw3
            if (dy_0 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = dw1
                // DB = P1+P2+P3, DA = P4-P1+P2
                // return 2P2+P3+P4

                // dw1_2Inv = 1/dw1_2, dm = dw3/dw3_1
                w1:= 1/(dw3_1*dw1_2);        // 1/(dw3_1*dw1_2^3)
                dw1_2Inv:= dw3_1*w1;            // (dw3_1*dw1_2^2)/(dw3_1*dw1_2^3) = 1/dw1_2
                w2:= dw1_2*w1;             // dw1_2/(dw3_1*dw1_2^3) = 1/(dw3_1*dw1_2^2)

                dm_0:= dw3_0*w2;           // (dw3_0*dw1_2^2)/(dw3_1*dw1_2^2) = dw3_0/dw3_1

                // b2 = h+v2+v1^-1 mod dw1
                //    = 1/dw3_1
                b2:= temp6*w2;           	// dw1_2^2/(dw3_1*dw1_2^2) = 1/dw3_1

                // at = ((dw1^-1 mod h+v2+v1 )*dw3_1)*(u1^-1 mod u2)
                //    = ((       a2        )*dw3_1)*(     a1     )
                //    = ((-(h+v2+v1/dw1)/dw3_1 )*dw3_1)*(    1/dw1_2    )
                //    = ((-(h+v2+v1/dw1)/dw3_1 )*dw3_1)*(     dw1_2Inv     )
                //    = -(h+v2+v1/dw1)*dw1_2Inv
                at1:= -h3*dw1_2Inv;
                at0:= -(dw1_1*at1 + ht2)*dw1_2Inv;

				// u1 = u1/dw3
                ta:= u1_2 - dm_0;

                u1_0:= u1_1 - dm_0*ta;
                u1_1:= ta;

                // u2 = u2/dw3
                ta:= u2_2 - dm_0;

                u2_0:= u2_1 - dm_0*ta;
                u2_1:= ta;

                // sp = (dw1^-1 mod h+v2+v1)*dw3_1*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod dw1)*dw3_1*w1 mod u2
                //    = (       a2       )*dw3_1*(     a1     )*( vt  ) + (       b2       )*dw3_1*w1 mod u2
                //    = (                at                 )*( vt  ) + (     1/dw3_1      )*dw3_1*w1 mod u2
                //    = (w1 + at*vt) mod u2
				temp9:= w1_3 - u2_1;
				t10:= w1_2 - u2_0;
                ta:= at1*vt2;
                tb:= at0*vt1;

                //sp4:= 1;
                sp3:= temp9 + ta;
                tc:= u2_1*sp3;
                sp2:= t10 + (at0 + at1)*(vt1 + vt2) - ta - tb - tc;					// karatsuba
                td:= u2_0*sp2;
                sp1:= w1_1 + tb + at1*vt0 - (u2_0 + u2_1)*(sp2 + sp3) + tc + td;		// karatsuba
                sp0:= w1_0 + at0*vt0 - td;

                // s = sp/dw3_1
                s1:= sp1*b2;
                s0:= sp0*b2;

				// un = (dm*w1 - s*(h + 2*v1 + u1*s))/u2 // why to multiply dm by w1?
				t11:= t1_2 + s0;
				ta:= t11 + v1_2;
				tb:= s0*u1_1;
				t12:= t1_1 + tb + s1*u1_0;

				un3:= 1;
				un2:= temp9 + dm_0 - h3*s1 - s1^2;
				un1:= t10 - h3*s0 + temp9*(dm_0 - u2_1) - s1*(ta + s0 - h3*u2_1 - s1*(u2_1 - u1_1));
				un0:= w1_1 + w1_2*dm_0 - u2_1*un1 - u2_0*un2 - s1*(t12 + v1_1 + tb) - s0*ta;

				// vn = -h - v1 - u1*s mod un
				ta:= h3 + s1;

				vn2:= h3*un2 - t11 - s1*(u1_1 - un2);
				vn1:= un1*ta - t12;
				vn0:= un0*ta - t1_0 - u1_0*s0;

				if (ADD_DEBUG) then "Deg3ADD: gcd(u1,u2) = dw1, DB = P1+P2+P3, DA = P4-P1+P2"; end if;
                return un3, un2, un1, un0, vn2, vn1, vn0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;
			// gcd(dw1,h+v2+v1) = 1

            // b2 = (  h+v2+v1^-1 mod dw1   )
            //    = (     -dw1/dw3      )/dy_0
            //    = (       bt       )/dy_0
            bt1:= -temp6*dw3_1;     // w(bt) = dw3_1^2; doing long division, bt1 and bt0 seem to be the current ones divided by dw1_2!
            bt0:= -dw1_2*temp8;

            // a2 = (     dw1^-1 mod h+v2+v1      )
            //    = (1 + (h+v2+v1/dw1)*(dw1/dw3))/dy_0
            //    = (1 + (    y    )*(-bt ))/dy_0
            //    = (1 + (        z        ))/dy_0
            //    = (          at          )/dy_0

            // y = h+v2+v1/dw1
            y1:= h3*dw1_2;					// w(y) = dw1_2
            y0:= ht2*dw1_2 - h3*dw1_1;

            // z = -bt*y
            ta:= bt0*y0;

            z2:= -bt1*y1;                               // w(z) = w(bt)*w(y) = dw3_1^2*dw1_2
            z1:= -z2 + ta - (bt0 + bt1)*(y0 + y1);		// karatsuba
            z0:= -ta;

            // at = 1 + z
            at2:= z2;               // w(at) = w(z) = dw3_1^2*dw1_2
            at1:= z1;
            at0:= temp7*dw1_2 + z0;      // because we want at=1+z to have the weight dw3_1^2*dw1_2, so that after dividing by the latter we get 1 + weightless z

            // lh = at*vt
            ta:= at1*vt1;
            tb:= at0*vt0;

            lh4:= at2*vt2;                                      // w(lh) = w(at)*1 = dw3_1^2*dw1_2
            lh3:= (at1 + at2)*(vt1 + vt2) - lh4 - ta;           // karatsuba
            lh2:= ta + (at0 + at2)*(vt0 + vt2) - lh4 - tb;		// karatsuba
            lh1:= (at0 + at1)*(vt0 + vt1) - ta - tb;            // karatsuba
            lh0:= tb;


            // rh = b2*w1
            ta:= bt1*temp6;		//dw3_1^2*dw1_2^2 //extra dw1_2^2 added here (1 extra dw1_2^2 compared to the LHS)
            tb:= bt0*temp6;      	//dw3_1^2*dw1_2^2 //extra dw1_2^2 added here (1 extra dw1_2^2 compared to the LHS)
            tc:= ta*w1_3;       	//dw3_1^2*dw1_2^2
            td:= tb*w1_2;       	//dw3_1^2*dw1_2^2
            te:= ta*w1_1;       	//dw3_1^2*dw1_2^2
            tf:= tb*w1_0;       	//dw3_1^2*dw1_2^2

            rh5:= ta;                                   //dw3_1^2*dw1_2^2
            rh4:= tc + tb;                              //dw3_1^2*dw1_2^2
            rh3:= (ta + tb)*(w1_2 + w1_3) - tc - td;		//dw3_1^2*dw1_2^2 karatsuba
            rh2:= td + te;                              //dw3_1^2*dw1_2^2
            rh1:= (ta + tb)*(w1_0 + w1_1) - te - tf;        //dw3_1^2*dw1_2^2 karatsuba
            rh0:= tf;                                   //dw3_1^2*dw1_2^2

            // sp = (d^-1 mod h+v2+v1)*dy_0*(u1^-1 mod u2)*dw1_2*(v2-v1) + (h+v2+v1^-1 mod d)*dy_0*w1 mod u2
            //    = (       a2       )*dy_0*(     a1     )*dw1_2*( vt  ) + (       b2       )*dy_0*w1 mod u2
            //    = (     at/dy_0     )*dy_0*(    1/dw1_2    )*dw1_2*( vt  ) + (     bt/dy_0     )*dy_0*w1 mod u2
            //    = (         at         )*(       1       )*( vt  ) + (         bt         )*w1 mod u2
            //    = (                      lh                      ) + (          rh          ) mod u2
            //    = (lh + rh) mod u2
            sp5:= rh5;
            ta:= u2_2*sp5;
            sp4:= lh4 + rh4 - ta;
            tb:= u2_1*sp4;
            sp3:= lh3 + rh3 - (u2_1 + u2_2)*(sp4 + sp5) + ta + tb;            // karatsuba
            tc:= u2_0*sp3;

            sp2:= lh2 + rh2 - tb - (u2_0 + u2_2)*(sp3 + sp5) + ta + tc;		// karatsuba
            sp1:= lh1 + rh1 - (u2_0 + u2_1)*(sp3 + sp4) + tb + tc;            // karatsuba
            sp0:= lh0 + rh0 - tc;

            if (sp2 eq 0) then
                if (sp1 eq 0) then
                    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                    // gcd(u1,u2) = dw1
                    // DB = P1+P2+P3, DA = P1+P2+P4

                    // s = sp/(dy_0*dw1_2)
                    s0:= sp0/(dy_0*dw1_2);

                    // un = (w1 - s*(h + 2*v1 + u1*s))/u2
                    un3:= 0;
                    un2:= 0;
                    un1:= 1;
                    un0:= w1_3 - u2_2 - h3*s0 - s0^2;

                    // vn = -h - v1 - u1*s mod un
                    vn2:= 0;
                    vn1:= 0;
                    vn0:= un0*(u1_1*s0 + t1_1 + un0*(s0*(un0 - u1_2) - t1_2 + h3*un0)) - t1_0 - u1_0*s0;

					if (ADD_DEBUG) then "Deg3ADD: gcd(u1,u2) = dw1, DB = P1+P2+P3, DA = P1+P2+P4, deg(s) = 0"; end if;
                    return un3, un2, un1, un0, vn2, vn1, vn0;
                    // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                end if;

                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = dw1
                // DB = P1+P2+P3, DA = P1+P2+P4

                // s = sp/(dy_0*dw1_2), s1Inv = 1/s1, sm = s/s1
                ta:= dy_0*dw1_2;

                w1:= 1/(sp1*ta);        // 1/(s1*dy_0^2*dw1_2)
                w2:= ta*w1;             // (dy_0*dw1_2)/(s1*dy_0^2*dw1_2) = 1/s1*dy_0
                s1Inv:= ta*w2;             // (dy_0*dw1_2)/(s1*dy_0) = 1/s1

                s1:= sp1^2*w1;          // (s1^2*dy_0^2)/(s1*dy_0^2*dw1_2) = s1/dw1_2 = s1
                sm0:= sp0*w2;           // s0*dy_0/s1*dy_0 = s0/s1

                // un = (w1 - s*(h + 2*v1 + u1*s))/u2 (made monic)
                temp9:= sm0*u1_2;

                un3:= 0;
                un2:= 1;
                un1:= dw1_2 + sm0 + sm0 + h3*s1Inv - s1Inv^2;
				t10:= un1 - sm0;
                un0:= dw1_1 + temp9 + (sm0 - u2_2)*t10 + (t1_2 + v1_2 + (sm0 - w1_3)*s1Inv)*s1Inv;

                // vn = -h - v1 - u1*s mod un
                ta:= s1*(t10 - u1_2) - h3;
                tb:= un1*ta;
                tc:= s1*(un0 - u1_1 - temp9) - t1_2 - tb;
                td:= un0*tc;

                vn2:= 0;
                vn1:= -s1*(u1_0 + u1_1*sm0) - t1_1 - (un0 + un1)*(tc + ta) + tb + td;		// karatsuba
                vn0:= -s1*(u1_0*sm0) - t1_0 - td;

                if (ADD_DEBUG) then "Deg3ADD: gcd(u1,u2) = dw1, DB = P1+P2+P3, DA = P1+P2+P4, deg(s) = 1"; end if;
                return un3, un2, un1, un0, vn2, vn1, vn0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = dw1
            // DB = P1+P2+P3, DA = P1+P2+P4
            // return 2P1+2P2+P3+P4

            // s = sp/(dy_0*dw1_2), s2Inv = 1/s2, sm = s/s2
            ta:= dy_0*dw1_2;

            w1:= 1/(sp2*ta);        // 1/(s2*dy_0^2*dw1_2)
            w2:= ta*w1;             // (dy_0*dw1_2)/(s2*dy_0^2*dw1_2) = 1/s2*dy_0
            s2Inv:= ta*w2;             // (dy_0*dw1_2)/(s2*dy_0) = 1/s2

            s2:= sp2^2*w1;          // (s2^2*dy_0^2)/(s2*dy_0^2*dw1_2) = s2/dw1_2 = s2
            sm1:= sp1*w2;           // s1*dy_0/s2*dy_0 = s1/s2
            sm0:= sp0*w2;           // s0*dy_0/s2*dy_0 = s0/s2

			// q, r = DivRem(u2, s)
            // q = quot(u2/s)
            //q1:= 1;           // w(q) = s2
            q0:= u2_2 - sm1;

            // r = u2 mod s
            r1:= s2*(u2_1 - sm1*q0 - sm0);       // w(r) = s2
            r0:= s2*(u2_0 - sm0*q0);

            // M1 = (q*(v2 - v1) + r*u1)/u2
            //M11:= r1;                 //s2^2 ?
            M10:= vt2 + r0 + r1*dw1_2;     // w(M1) = s2

            // M2 = (r*(h + v2 + v1) + q*w1)/u2
            //M22:= 1;                                                          // w(M2) = s2
            M21:= w1_3 + h3*r1 - sm1;
            M20:= w1_2 + h3*r0 - sm1*(w1_3 - u2_2) + r1*(ht2 - h3*u2_2) - u2_1;

            // un = r*M1 - q*M2 (monic)
			// weights of r, M1, q, and M2 (each of which is s2) don't matter anymore for computing un, because
			//	we just need monic(un); in fact weightless un / lcf(weightless un) = weighted un / lcf(weighted un) which can be rewritten as
			//	(weighted un / s2^2) / lcf(weighted un / s2^2) = weighted un / lcf(weighted un) = monic(un)
            un3:= 1;
            un2:= M21 - r1^2 + q0;
            un1:= M20 - r1*(M10 + r0) + M21*q0;
            un0:= M20*q0 - r0*M10;

            // vn = ((u1*r - un)/q - v1 - h) mod un
            ta:= r0 - r1*q0;
			tb:= (u1_2 - q0)*ta + (un2 - q0)*s2Inv;

			vn2:= r1*(u1_2 - un2) + ta + s2Inv - t1_2 + h3*un2;
            vn1:= r1*(u1_1 - un1) + tb - t1_1 + h3*un1;
			vn0:= r1*(u1_0 - un0) + u1_1*ta - q0*tb + un1*s2Inv - t1_0 + h3*un0;

            if (ADD_DEBUG) then "Deg3ADD: gcd(u1,u2) = dw1, DB = P1+P2+P3, DA = P1+P2+P4, deg(s) = 2"; end if;
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;
		// gcd(u1, u2) = ew, because det=0 here, thus gcd is non-trivial and deg(ew)=1; so, dw1 mod ew must be 0, otherwise we would have gcd(u1,u2)=1, i.e., trivial.

        // at = (u1^-1 mod u2)*ew_1
        //    = (     a1     )*ew_1
        //    = ( -(u2/dw1)/ew_1 )*ew_1
        //    = -(u2/dw1)
        at1:= -dw1_2;		// w(at) = dw1_2^2
        at0:= temp1;

        // dw4 = (h + v2 + v1) mod ew
        temp4:= ew_1^2;
		temp5:= ht2*ew_1 - ew_0*h3;
		temp6:= ht1*temp4;
		temp7:= ew_0*temp5;
        temp8:= ew_1*temp4;		// ew_1^3

        dw4_0:= ht0*temp8 - ew_0*(temp6 - temp7);		// w(dw4) = (weighted ew_1)^3 = (weightless ew_1)^3*dw1_2^6

        // if gcd(ew,h+v2+v1) = ew
        if (dw4_0 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = ew
            // DB = P1+P2+P3, DA = P4-P1+P5
            // return P2+P3+P4+P5

            // w1 = (f - v1*h - v1^2)/u1
            //w1_4:= 1;
            w1_3:= f6 - u1_2;
            w1_2:= f5 - u1_1 - f6*u1_2 - h3*v1_2 + u1_2^2;
            w1_1:= f4 - u1_0 - f6*u1_1 - h3*v1_1 - v1_2*t1_2 - u1_2*(w1_2 - u1_1);

            // ew_1Inv = 1/ew_1, dm = ew/ew_1
            ew_1Inv:= 1/ew_1;         	// 1/(ew_1*dw1_2^2)

            em_0:= ew_0*ew_1Inv;		// (ew_0*dw1_2^2)/(ew_1*dw1_2^2) = ew_0/ew_1

            // a1 = u1^-1 mod u2
            //    = at/ew_1
            a11:= at1*ew_1Inv;
            a10:= at0*ew_1Inv;

            // u1 = u1/em
            ta:= u1_2 - em_0;
            u1_0:= u1_1 - em_0*ta;
            u1_1:= ta;

            // u2 = u2/em
            ta:= u2_2 - em_0;
            u2_0:= u2_1 - em_0*ta;
            u2_1:= ta;

            // vt = v2 - v1
            vt2:= v2_2 - v1_2;
            vt1:= v2_1 - v1_1;
            vt0:= v2_0 - v1_0;

            // y = a1*vt
            ta:= a10*vt1;

            y3:= a11*vt2;
            y2:= (a10 + a11)*(vt1 + vt2) - y3 - ta;		// karatsuba
            y1:= a11*vt0 + ta;
            y0:= a10*vt0;

            // s = (ew^-1 mod h+v2+v1)*(u1^-1 mod u2)*(v2-v1) + (h+v2+v1^-1 mod ew)*w1 mod u2
            //   = (       a2       )*(     a1     )*( vt  ) + (       b2       )*w1 mod u2
            //   = (       1        )*(         y          ) + (       0        )*w1 mod u2
            //   = y mod u2
            s3:= y3;
            ta:= u2_1*s3;
            s2:= y2 - ta;
            tb:= u2_0*s2;
            s1:= y1 - (u2_0 + u2_1)*(s2 + s3) + ta + tb;		// karatsuba
            s0:= y0 - tb;

            // un = (w1*em - s*(h + 2*v1 + u1*s))/u2
            t10:= s0*u1_1;
            t11:= s1*u1_0;
            ta:= w1_3 - u2_1;

            un3:= 1;
            un2:= ta + em_0 - h3*s1 - s1^2;
            un1:= w1_2 - u2_0 - ta*(u2_1 - em_0) - s1*(h2 + 2*(v1_2 + s0) - h3*u2_1 + s1*(u1_1 - u2_1)) - h3*s0;
            un0:= w1_1 - u2_1*(un1) - u2_0*(un2) - s1*(h1 + 2*(v1_1 + t10) + t11) + em_0*w1_2 - s0*(h2 + 2*v1_2 + s0);

            // vn = -h - v1 - u1*s mod un
			ta:= h3 + s1;

            vn2:= h3*un2 + s1*(un2 - u1_1) - t1_2 - s0;
            vn1:= un1*ta - t10 - t11 - t1_1;
            vn0:= un0*ta - s0*u1_0 - t1_0;

            //"Deg3ADD - gcd(u1,u2) = e, DB = P1+P2+P3, DA = P4-P1+P5";
            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.4 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;
		// gcd(ew,h+v2+v1) = 1

        // w1 = (f - v1*h - v1^2)/u1
		ta:= h3*v1_2;
		tb:= h2*v1_1;

        //w1_4:= 1;
        w1_3:= f6 - u1_2;
        w1_2:= f5 - u1_1 - f6*u1_2 - ta + u1_2^2;
        w1_1:= f4 - u1_0 - f6*u1_1 - h3*v1_1 - v1_2*t1_2 - u1_2*(w1_2 - u1_1);                      // no karatsuba, use u1_2 multiplication
        w1_0:= f3 - f6*u1_0 - h3*v1_0 - tb - u1_2*(w1_1 - u1_0) - u1_1*(w1_2) - v1_2*(h1 + 2*v1_1);

        // vt = v2 - v1
        vt2:= v2_2 - v1_2;
        vt1:= v2_1 - v1_1;
        vt0:= v2_0 - v1_0;

        // a2 = ( ew^-1 mod h+v2+v1 )
        //    = ( -(h+v2+v1)/ew )/dw4_0
        //    = (      y       )/dw4_0
        // y = -(h+v2+v1)/ew
        y2:= -h3*temp4;			// w(y) = ew_1^2, but shouldn't be ew_1^3?
        y1:= -ew_1*temp5;
        y0:= -(temp6 - temp7);

        // z = at*vt mod u2
        z3:= at1*vt2;                           				//dw1_2^2
		ta:= at0*vt1;											//dw1_2^2
        z2:= (at0 + at1)*(vt1 + vt2) - z3  - ta - u2_2*z3;		//dw1_2^2 karatsuba
        z1:= at1*vt0 + ta - u2_1*z3;        						//dw1_2^2
        z0:= at0*vt0 - u2_0*z3;                  				//dw1_2^2

        // lh = y*z
		ta:= y1*z1;										//ew_1^2*dw1_2^2
		tb:= y0*z0;										//ew_1^2*dw1_2^2

        lh4:= y2*z2;                       				//ew_1^2*dw1_2^2
        lh3:= (y1 + y2)*(z1 + z2) - lh4 - ta;			//ew_1^2*dw1_2^2 karatsuba
        lh2:= ta + (y0 + y2)*(z0 + z2) - lh4 - tb;		//ew_1^2*dw1_2^2 karatsuba
        lh1:= (y0 + y1)*(z0 + z1) - ta - tb;            //ew_1^2*dw1_2^2 karatsuba
        lh0:= tb;                       				//ew_1^2*dw1_2^2

        //rhs = w1
        rh4:= temp8;        	//ew_1^3
        rh3:= w1_3*temp8;     	//ew_1^3
        rh2:= w1_2*temp8;     	//ew_1^3
        rh1:= w1_1*temp8;     	//ew_1^3
        rh0:= w1_0*temp8;		//ew_1^3

        // sp = ( ew^-1 mod h+v2+v1 )*dw4_0*(u1^-1 mod u2)*ew_1*(v2-v1) + (h+v2+v1^-1 mod ew)*dw4_0*w1 mod u2
        //    = (        a2        )*dw4_0*(     a1     )*ew_1*( vt  ) + (       b2       )*dw4_0*w1 mod u2
        //    = ((-(h+v2+v1)/ew)/dw4_0)*dw4_0*( -(u2/d)/ew_1 )*ew_1*( vt  ) + (     1/dw4_0      )*dw4_0*w1 mod u2
        //    = (          y           )*(      at       )*( vt  ) + (         1          )*w1 mod u2
        //    = (          y           )*(           z           ) + (         1          )*w1 mod u2
        //    = (                       lh                       ) + (          rh          ) mod u2
        //    = lh + rh mod u2
        sp4:= lh4 + rh4;
		ta:= u2_2*sp4;
        sp3:= lh3 + rh3 - ta;
		tb:= u2_1*sp3;

        sp2:= lh2 + rh2 - (u2_1 + u2_2)*(sp3 + sp4) + ta + tb;		// karatsuba
        sp1:= lh1 + rh1 - tb - u2_0*sp4;
        sp0:= lh0 + rh0 - u2_0*sp3;

        if (sp2 eq 0) then
            if (sp1 eq 0) then
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
                // gcd(u1,u2) = ew
                // DB = P1+P2+P3, DA = P1+P4+P5

                // s = sp/dw4_0
                s0:= sp0/(dw4_0);

                // un = (w1 - s*(h + 2*v1 + u1*s))/u2
                un3:= 0;
                un2:= 0;
                un1:= 1;
                un0:= w1_3 - u2_2 - h3*s0 - s0^2;

                // vn = -h - v1 - u1*s mod un
                vn2:= 0;
                vn1:= 0;
                vn0:= un0*(u1_1*s0 + t1_1 + un0*(s0*(un0 - u1_2) - t1_2 + h3*un0)) - t1_0 - u1_0*s0;

                return un3, un2, un1, un0, vn2, vn1, vn0;
                // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            end if;

            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = ew
            // DB = P1+P2+P3, DA = P1+P4+P5

            // s = sp/dw4_0, s1Inv = 1/s1, sm = s/s1
            ta:= dw4_0;

            w1:= 1/(sp1*ta);        // 1/(s1*dw4_0^2*dw1_2)
            w2:= ta*w1;             // (dw4_0*dw1_2)/(s1*dw4_0^2*dw1_2) = 1/s1*dw4_0
            s1Inv:= ta*w2;             // (dw4_0*dw1_2)/(s1*dw4_0) = 1/s1

            s1:= sp1^2*w1;          // (s1^2*dw4_0^2)/(s1*dw4_0^2*dw1_2) = s1/dw1_2 = s1
            sm0:= sp0*w2;           // s0*dw4_0/s1*dw4_0 = s0/s1

            // un = (w1 - s*(h + 2*v1 + u1*s))/u2 (made monic)
            tsb:= sm0*u1_2;

            un3:= 0;
            un2:= 1;
            un1:= dw1_2 + h3*s1Inv + 2*sm0 - s1Inv^2;
            un0:= (sm0 - u2_2)*(un1 - sm0) + tsb + dw1_1 + (h2 + 2*v1_2 + (sm0 - w1_3)*s1Inv)*s1Inv;

            // vn = -h - v1 - u1*s mod un
            ta:= s1*(un1 - u1_2 - sm0) - h3;
            tc:= un1*ta;
            tb:= s1*(un0 - u1_1 - tsb) - t1_2 - tc;
            td:= un0*tb;

            vn2:= 0;
            vn1:= -s1*(u1_0 + u1_1*sm0) - t1_1 - (un0 + un1)*(ta + tb) + tc + td;        // karatsuba
            vn0:= -s1*(u1_0*sm0) - t1_0 - td;

            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u1,u2) = ew
        // DB = P1+P2+P3, DA = P1+P4+P5
        // return 2P1+P2+P3+P4+P5

        // s = sp/dw4_0, s2Inv = 1/s2, sm = s/s2
        tx:= dw4_0;

        w1:= 1/(sp2*tx);        // 1/(s2*dw4_0^2*dw1_2)
        w2:= tx*w1;             // (dw4_0*dw1_2)/(s2*dw4_0^2*dw1_2) = 1/s2*dw4_0
        s2Inv:= tx*w2;             // (dw4_0*dw1_2)/(s2*dw4_0) = 1/s2

        s2:= sp2^2*w1;          // (s2^2*dw4_0^2)/(s2*dw4_0^2*dw1_2) = s2/dw1_2 = s2
        sm1:= sp1*w2;           // s1*dw4_0/s2*dw4_0 = s1/s2
        sm0:= sp0*w2;           // s0*dw4_0/s2*dw4_0 = s0/s2

        // q = u2/s
        //q1:= 1;           //s2
        q0:= u2_2 - sm1;     //s2

        // r = u2 mod s
        r1:= s2*(u2_1 - sm1*q0 - sm0);       //s2
        r0:= s2*(u2_0 - sm0*q0);             //s2

        // M1 = (q*(v2 - v1) + r*u1)/u2
        //M11:= r1;                 //s2^2
        M10:= vt2 + r0 + r1*dw1_2;     // w(M1)=s2

        // M2 = (r*(h + v2 + v1) + q*w1)/u2
        //M22:= 1;					// w(M2)=s2
        M21:= w1_3 + h3*r1 - sm1;
        M20:= w1_2 + h3*r0 - sm1*(w1_3 - u2_2) + r1*(ht2 - h3*u2_2) - u2_1;

        // un = r*M1 - q*M2 (monic)
        un3:= 1;
        un2:= M21 - r1^2 + q0;
        un1:= M20 - r1*(M10 + r0) + M21*q0;
        un0:= M20*q0 - r0*M10;

        // vn = ((u1*r - un)/q - v1 - h) mod un
        tx:= r0 - r1*q0;
        ty:= (u1_2 - q0)*tx + (un2 - q0)*s2Inv;        // shared by vn1 and vn0

        vn2:= r1*(u1_2 - un2) + tx + s2Inv - t1_2 + h3*un2;
        vn1:= r1*(u1_1 - un1) + ty - t1_1 + h3*un1;
        vn0:= r1*(u1_0 - un0) + u1_1*tx - q0*ty + un1*s2Inv - t1_0 + h3*un0;

        return un3, un2, un1, un0, vn2, vn1, vn0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    end if;
	// gcd(u1,u2)=1

    // w1 = (f - v1*h - v1^2)/u1
	ta:= h3*v1_2;

    //w1_4:= 1;
    w1_3:= f6 - u1_2;
    w1_2:= f5 - u1_1 - f6*u1_2 - ta + u1_2^2;
    // w1_1 and w1_0 are not formed here. Only the top two coefficients of the
    // quotient (f - v1*h - v1^2)/u1 are used on this path -- w1_3 and w1_2 feed
    // the resultant below -- and the thesis's efficient exact division
    // (sec:exactdiv) says only the highest d1 - d2 + 1 are ever needed. Their
    // former definitions read:
    //   w1_1:= f4 - u1_0 - f6*u1_1 - (h3 + h2)*(v1_2 + v1_1) + ta + tb - v1_2^2 - u1_2*(w1_2 - u1_1);
    //   w1_0:= f3 - f6*u1_0 - h3*v1_0 - tb - u1_2*(w1_1 - u1_0) - u1_1*(w1_2) - v1_2*(h1 + 2*v1_1);
    // and tb := h2*v1_1 existed only to serve them.


    //vt = v2 - v1
    vt2:= v2_2 - v1_2;
    vt1:= v2_1 - v1_1;
    vt0:= v2_0 - v1_0;

    // m6 and m4 close the adjugate. The sp1 row below is their only reader, and
    // it is on the gcd(u1,u2) = 1 path, so they belong here rather than above the
    // `det eq 0` test -- the special cases all return without reading them.
    //
    // Each is the plain cofactor with a term that is identically zero folded in,
    // which is what lets tf, m8 and m7 stand in for products the cofactor would
    // otherwise need. The zero terms are tc*(tb + temp2 - dw1_0) for m6 and
    // temp1*temp2 - temp2*temp1 for m4. Both entries are ordinary adjugate
    // values, nonzero for essentially every curve, and the reuse-free forms are
    //   m6 = dw1_0*tc + u2_1*temp5 - u2_0*temp4            (adj_23)
    //   m4 = u2_2*temp4 - dw1_1*temp2 - temp3 - temp1*tb   (adj_21)
    //
    // `tf` is assigned once above the `det eq 0` test and reassigned inside it at
    // the dw3_1^2*dw1_2^2 block. This read is safe only because every path in
    // that block returns, so the reassignment can never reach here. Preserve that
    // property or move tf's definition down.
    m6:= tf - u2_1*m8;
    m4:= m8 + u2_2*m7;

	// partially solve system to get sp = s*det
    sp0:= vt0*m1 + vt1*m2 + vt2*m3;
    sp1:= vt0*m4 + vt1*m5 + vt2*m6;
    sp2:= vt0*m7 + vt1*m8 + vt2*m9;
	// 11m 0s 8a
	// top: 16m 0s 9a
	// total: 27m 0s 17a (equivalent 98a)


    if (sp2 eq 0) then
        if (sp1 eq 0) then
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            // gcd(u1,u2) = 1
            // DB = P1+P2+P3, DA = P4+P5+P6

            // s = sp/det
            s0:= sp0/det;

            // un = (w1 - s*(h + 2*v1 + u1*s))/u2
            un3:= 0;
            un2:= 0;
            un1:= 1;
            un0:= w1_3 - u2_2 - h3*s0 - s0^2;

            // vn = -h - v1 - u1*s mod un
            vn2:= 0;
            vn1:= 0;
            vn0:= un0*(u1_1*s0 + t1_1 + un0*(s0*(un0 - u1_2) - t1_2 + h3*un0)) - t1_0 - u1_0*s0;

            return un3, un2, un1, un0, vn2, vn1, vn0;
            // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        end if;

        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u1,u2) = 1
        // DB = P1+P2+P3, DA = P4+P5+P6

        // s = sp/det, s1Inv = 1/s1, sm = s/s1
        tx:= det;

        w1:= 1/(sp1*tx);        // 1/(s1*det^2)
        w2:= tx*w1;             // 1/sp1 = 1/(s1*det)
        s1Inv:= tx*w2;             // det/(s1*det) = 1/s1

        s1:= sp1^2*w1;          // (s1^2*det^2)/(s1*det^2) = s1
        sm0:= sp0*w2;           // (s0*det)/(s1*det) = s0/s1

        // un = (w1 - s*(h + 2*v1 + u1*s))/u2 (made monic)
        tsb:= sm0*u1_2;

        un3:= 0;
        un2:= 1;
        un1:= dw1_2 + h3*s1Inv + 2*sm0 - s1Inv^2;
        un0:= (sm0 - u2_2)*(un1 - sm0) + tsb + dw1_1 + (h2 + 2*v1_2 + (sm0 - w1_3)*s1Inv)*s1Inv;

        // vn = -h - v1 - u1*s mod un
        tn3:= s1*(un1 - u1_2 - sm0) - h3;
        tx:= un1*tn3;
        tn2:= s1*(un0 - u1_1 - tsb) - t1_2 - tx;
        ty:= un0*tn2;

        vn2:= 0;
        vn1:= -s1*(u1_0 + u1_1*sm0) - t1_1 - (un0 + un1)*(tn2 + tn3) + tx + ty;        // karatsuba
        vn0:= -s1*(u1_0*sm0) - t1_0 - ty;

        return un3, un2, un1, un0, vn2, vn1, vn0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    end if;

    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    // gcd(u1,u2) = 1
    // DB = P1+P2+P3, DA = P4+P5+P6
    // return P1+P2+P3+P4+P5+P6

    // s = sp/(det), s2Inv = 1/s2, sm = s/s2
    tx:= det;

    w1:= 1/(sp2*tx);        // 1/(s2*det^2)
    w2:= tx*w1;             // det/(s2*det^2) = 1/(s2*det)
    s2Inv:= tx*w2;             // det/(s2*det) = 1/s2

    s2:= sp2^2*w1;          // (s2^2*det^2)/(s2*det^2) = s2
    sm1:= sp1*w2;           // s1*det/(s2*det) = s1/s2
    sm0:= sp0*w2;           // s0*det/(s2*det) = s0/s2

	// q,r = DivRem(u2,s)
    // q = quot(u2/s)
    //q1:= 1;           //s2
    q0:= u2_2 - sm1;     //s2

    // r = u2 mod s
    r1:= s2*(u2_1 - sm1*q0 - sm0);       //s2
    r0:= s2*(u2_0 - sm0*q0);             //s2

    // M1 = (q*(v2 - v1) + r*u1)/u2
    //M11:= r1;                 //s2^2
    M10:= vt2 + r0 + r1*dw1_2;     //s2

    // M2 = (r*(h + v2 + v1) + q*w1)/u2
    //M22:= 1;                                                              //s2
    M21:= w1_3 + h3*r1 - sm1;                                                 //s2
    M20:= w1_2 + h3*r0 - sm1*(w1_3 - u2_2) + r1*(ht2 - h3*u2_2) - u2_1;      		//s2

    // un = r*M1 - q*M2 (monic)
    un3:= 1;
    un2:= M21 - r1^2 + q0;
    un1:= M20 - r1*(M10 + r0) + M21*q0;
    un0:= M20*q0 - r0*M10;

    // vn = ((u1*r - un)/q - v1 - h) mod un
    tx:= r0 - r1*q0;
    ty:= (u1_2 - q0)*tx + (un2 - q0)*s2Inv;        // shared by vn1 and vn0

    vn2:= r1*(u1_2 - un2) + tx + s2Inv - t1_2 + h3*un2;
    vn1:= r1*(u1_1 - un1) + ty - t1_1 + h3*un1;
    vn0:= r1*(u1_0 - un0) + u1_1*tx - q0*ty + un1*s2Inv - t1_0 + h3*un0;

    return un3, un2, un1, un0, vn2, vn1, vn0;
    // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// ADD():
// Input: D1, D2:     divisors as [u, v] polynomial pairs, any degrees
//        f, h, h:    curve polynomials
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = D1 + D2
//
// Description: Dispatches on the operand degrees to the Deg* cases above,
//              normalising the larger-degree divisor first. D1 = D2 is routed
//              to DBL, so the D1 != D2 assumption of the cases holds below.
///////////////////////////////////////////////////////////////////////////////
ADD:= function(D1, D2, f, h)//startIGNORE

    // D1 = D2 is a doubling, not an addition: the Deg* cases below assume
    // D1 != D2 (the thesis Require clause) and return wrong results without it.
    // Above the operand sort on purpose -- identical operands have nothing to
    // normalise, and the guard then owes nothing to the tie-break for
    // equal-degree u.
    if D1 eq D2 then
        return DBL(D1,f,h);
    end if;

    // ensure u1 is always the larger polynomial
    if D2[1] le D1[1] then
        u1:= D1[1]; v1:= D1[2];
        u2:= D2[1]; v2:= D2[2];

    else
        u2:= D1[1]; v2:= D1[2];
        u1:= D2[1]; v1:= D2[2];

    end if;

    f7:= Coeff(f, 7); f6:= Coeff(f, 6); f5:= Coeff(f, 5); f4:= Coeff(f, 4); f3:= Coeff(f, 3); f2:= Coeff(f, 2); f1:= Coeff(f, 1); f0:= Coeff(f, 0);
    h3:= Coeff(h,3); h2:= Coeff(h,2); h1:= Coeff(h,1); h0:= Coeff(h,0);

    u1_3:= Coeff(u1,3); u1_2:= Coeff(u1,2); u1_1:= Coeff(u1,1); u1_0:= Coeff(u1,0);
    v1_2:= Coeff(v1,2); v1_1:= Coeff(v1,1); v1_0:= Coeff(v1,0);

    u2_3:= Coeff(u2,3); u2_2:= Coeff(u2,2); u2_1:= Coeff(u2,1); u2_0:= Coeff(u2,0);
    v2_2:= Coeff(v2,2); v2_1:= Coeff(v2,1); v2_0:= Coeff(v2,0);

    if (u1_3 ne 0) then
        if (u2_3 ne 0) then
            return Deg3ADD(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, u2_2, u2_1, u2_0, v2_2, v2_1, v2_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);

        elif (u2_2 ne 0) then
            return Deg23ADD(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, u2_1, u2_0, v2_1, v2_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);

        elif (u2_1 ne 0) then
            return Deg13ADD(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, u2_0, v2_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);

        else
			return u1_3, u1_2, u1_1, u1_0, v1_2, v1_1, v1_0;

		end if;

    elif (u1_2 ne 0) then
        if (u2_2 ne 0) then
            return Deg22ADD(u1_1, u1_0, v1_1, v1_0, u2_1, u2_0, v2_1, v2_0, f6, f5, f4, f3, f2, h3, h2, h1, h0);

        elif (u2_1 ne 0) then
            return Deg12ADD(u1_1, u1_0, v1_1, v1_0, u2_0, v2_0, f6, f5, f4, f3, f2, h3, h2, h1, h0);
            
        else
            return u1_3, u1_2, u1_1, u1_0, v1_2, v1_1, v1_0;
        
        end if;
    
    elif (u1_1 ne 0) then
        if (u2_1 ne 0) then
            return Deg1ADD(u1_0, v1_0, u2_0, v2_0);
            
        else
            return u1_3, u1_2, u1_1, u1_0, v1_2, v1_1, v1_0;
        
        end if;     
    
    else
        return u1_3, u1_2, u1_1, u1_0, v1_2, v1_1, v1_0;
    
    end if;
        
    "THIS SHOULD NEVER HAPPEN";
    return -1, -1, -1, -1, -1, -1, -1; 
    
end function;//endIGNORE
