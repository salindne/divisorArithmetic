///////////////////////////////////////////////////////////////////////////////
// Author: Randall Apperley                                                 
//                                                   
// Description: Explicit divisor doubling formulas for the 4 coordinate Mumford
//              representation over arbitrary fields where:
//
//              h(x) = h3*x^3 + h2*x^2 + h1*x + h0 (deg h <= 3) and
//              f(x) = x^7 + f6x^6 + f5x^5 + f4x^4 + f3x^3 + f2x^2 + f1x + f0
//                                                                      
///////////////////////////////////////////////////////////////////////////////


//Must keep next two lines in this format for latex conversion
//Constant: f5,f4,f3,f2,f1,f0,h2,h1,h0
//Ignore: f6,h3


///////////////////////////////////////////////////////////////////////////////
// Deg1DBL():
// Input: u1_2..v1_0: Mumford coordinates for degree one divisor D1
//                     (shares the degree-3 signature; coefficients above
//                     degree one are structurally zero here)
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = 2*D1
//
// Description: Computes the explicit formula for doubling a degree one
//              divisor.
///////////////////////////////////////////////////////////////////////////////
Deg1DBL:= function(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u1,2va+h) = 1
    //		1.1) DA = P1                (typical)
    // 2) gcd(u1,2va+h) = u1
    //      2.1) DA = P1 s.t. 2P1 = P0  (return P0)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++
    
    // d = 2va + h mod u1
    t01:= u1_0^2;
    t02:= u1_0*t01;      // u1_0^3
    
    d0:= h0 + 2*v1_0 - h1*u1_0 + h2*t01 - h3*t02;
    
	// if gcd(u1,2va+h) = u1
	if (d0 eq 0) then
		// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		// gcd(u1,2va+h) = u1    
		// DA = P1 s.t. 2P1 = P0
		// return P0
		
		if (DBL_DEBUG) then "Deg1DBL: gcd(u1,2va+h) = u1, DA = P1 s.t. 2P1 = P0"; end if;
		return 0, 0, 0, 1, 0, 0, 0;
		// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	end if;
	
	// ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	// gcd(u1,2va+h) = 1
	// DA = P1
	
	// k = (f - v1*h - v1^2)/u1 mod u1
	k0:= f1 - h1*v1_0 + u1_0*(-2*(f2 - h2*v1_0) + u1_0*(3*(f3 - h3*v1_0) - 4*f4*u1_0 + 5*f5*t01 - 6*f6*t02 + 7*(t01^2)));
	
	// s = k/(2va + h) mod u1
	s0:= k0/d0;
	
	// un = u1^2
	un3:= 0;
	un2:= 1;
	un1:= 2*u1_0;
	un0:= t01;
	
	// vn = u1*s + v1
	vn2:= 0;
	vn1:= s0;
	vn0:= u1_0*s0 + v1_0;
	
	if (DBL_DEBUG) then "Deg1DBL: Typical"; end if;
	return un3, un2, un1, un0, vn2, vn1, vn0;
	// ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg2DBL():
// Input: u1_2..v1_0: Mumford coordinates for degree two divisor D1
//                     (shares the degree-3 signature; coefficients above
//                     degree two are structurally zero here)
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = 2*D1
//
// Description: Computes the explicit formula for doubling a degree two
//              divisor.
///////////////////////////////////////////////////////////////////////////////
Deg2DBL:= function(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u1,2va+h) = 1
    //		1.1) DA = P1+P2                             (typical)
    // 2) gcd(u1,2va+h) = d
    //      2.1) DA = P1+P2 s.t. 2P1 = P0               (return 2P2) 
    // 3) gcd(u1,2va+h) = u1
    //      3.1) DA = P1+P2 s.t. 2P1 = P0 & 2P2 = P0	(return P0)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++

    // d = (2va + h) mod u1
    t01:= u1_1^2;
    t02:= u1_0*u1_1;
    
    d1:= h1 + 2*v1_1 - h2*u1_1 + h3*(t01 - u1_0);
    d0:= h0 + 2*v1_0 - h2*u1_0 + h3*t02;
    
    // set up system of equations to solve for s = (k/d) mod u1
    // and find the determinant
    // adapted from Lindner's MSc thesis (pages 63-64)
    m1:= d0 - d1*u1_1;
    m2:= d1*u1_0;
    //m3:= -d1;
    //m4:= d0;
    
    det:= d0*m1 + m2*d1;
	
	// if gcd(u1,2va+h) != 1
	if (det eq 0) then
	
		// if gcd(u1,2va+h) = u1
		if (d1 eq 0) then
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
			// gcd(u1,2va+h) = u1
			// DA = P1+P2 s.t. 2P1 = P0 and 2P2 = P0
			// return P0
			
			if (DBL_DEBUG) then "Deg2DBL: gcd(u1,2va+h) = u1, DA = P1+P2 s.t. 2P1 = P0 & 2P2 = P0"; end if;
			return 0, 0, 0, 1, 0, 0, 0;
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		end if;
		
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u1,2va+h) = d
        // DA = P1+P2 s.t. 2P1 = P0
        // return 2P2
        
		// k = (f - v1*h - v1^2)/u1
		t03:= u1_0 + u1_1;
		t04:= f6*u1_1 - t01;		// (u1_1*k4)
		t05:= u1_0 + t04;	
		t06:= f6*u1_0 - t02;		// (u1_0*k4)

		//k5:= 1;
		//k4:= f6 - u1_1;
		k3:= f5 - t05;
		t07:= u1_1*k3;
		k2:= f4 - h3*v1_1 - t06 - t07;
		t08:= u1_0*k2;
		k1:= f3 - h3*v1_0 - h2*v1_1 - (t03)*(k2 + k3) + t08 + t07;		// karatsuba
		k0:= f2 - h2*v1_0 - h1*v1_1 - v1_1^2 - t08 - u1_1*k1;
		
		// kp = k mod u1
		//kp5:= 1;
		//kp4:= k4 - u1_1;
		kp3:= k3 - t05 + t01;
		t09:= u1_1*kp3;
		kp2:= k2 - t06 + t02 - t09;
		t10:= u1_0*kp2;
		
		kp1:= k1 - (t03)*(kp2 + kp3) + t09 + t10;		// karatsuba
		kp0:= k0 - t10;
		
		// a1 = 2va+h^-1 wrt u1
		//    = 1/d1
		a1:= 1/d1;
        
        // u1 = u1/d	(where d is monic)
        //u1_1:= 1;
        u1_0:= u1_1 - d0*a1;
        
		// s = k/(2va + h) mod u1
        //   = k/(  d1   ) mod u1
		//   = k*a1 mod u1
        s0:= (kp0 - kp1*u1_0)*a1;
        
        // un = u1^2
        un3:= 0;
        un2:= 1;
        un1:= 2*u1_0;
        un0:= u1_0^2;
        
        // vn = u1*s + v1
        vn2:= 0;
        vn1:= s0 + v1_1;
        vn0:= u1_0*s0 + v1_0;
        
		if (DBL_DEBUG) then "Deg2DBL: gcd(u1,2va+h) = d, DA = P1+P2 s.t. 2P1 = P0"; end if;
        return un3, un2, un1, un0, vn2, vn1, vn0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	end if;
	
	// ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	// gcd(u1,2va+h) = 1
	// DA = P1+P2
	
	// k = (f - v1*h - v1^2)/u1
	t03:= u1_0 + u1_1;
	t04:= f6*u1_1 - t01;		// (u1_1*k4)
	t05:= u1_0 + t04;	
	t06:= f6*u1_0 - t02;		// (u1_0*k4)

	// SEE IF CAN OPTIMIZE THIS LIKE BELOW IN DOUBLING3
	//k5:= 1;
	k4:= f6 - u1_1;
	k3:= f5 - t05;
	t07:= u1_1*k3;
	k2:= f4 - h3*v1_1 - t06 - t07;
	t08:= u1_0*k2;
	k1:= f3 - h3*v1_0 - h2*v1_1 - (t03)*(k2 + k3) + t08 + t07;		// karatsuba
	k0:= f2 - h2*v1_0 - h1*v1_1 - v1_1^2 - t08 - u1_1*k1;
	
	// kp = k mod u1
	//kp5:= 1;
	//kp4:= k4 - u1_1;
	kp3:= k3 - t05 + t01;
	t09:= u1_1*kp3;
	kp2:= k2 - t06 + t02 - t09;
	t10:= u1_0*kp2;
	
	kp1:= k1 - (t03)*(kp2 + kp3) + t09 + t10;		// karatsuba
	kp0:= k0 - t10;
	
	// partially solve system to get sp = s*det
	// adapted from Lindner's MSc thesis (pages 63-64)
	sp0:= kp0*m1 + kp1*m2;
	sp1:= kp1*d0 - kp0*d1;
	
	// s = sp/det, w1 = 1/det
	w1:= 1/det;
	
	s1:= sp1*w1;       // (s1*det)/det
	s0:= sp0*w1;       // (s0*det)/det
	
	// M2 = (s*(2va + h) - k)/u1
	//M23:= -1;
	M22:= h3*s1 - k4 + u1_1;
	M21:= h2*s1 + h3*s0 - k3 + u1_0 - u1_1*M22;
	M20:= h1*s1 + h2*s0 - k2 + 2*s1*v1_1 - u1_0*M22 - u1_1*M21;
	
	// un = s^2 + M2	(made monic)
	un3:= 1;
	un2:= - s1^2 - M22;
	un1:= - 2*s0*s1 - M21;
	un0:= - s0^2 - M20;
	
	// vn = (-u1*s - v1 - h) mod un
	vn2:= s1*(un2 - u1_1) + h3*un2 - h2 - s0;
	vn1:= s1*(un1 - u1_0) + h3*un1 - s0*u1_1 - h1 - v1_1;
	vn0:= un0*(h3 + s1) - s0*u1_0 - h0 - v1_0;
	
	if (DBL_DEBUG) then "Deg2DBL: Typical"; end if;
	return un3, un2, un1, un0, vn2, vn1, vn0;
	// ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;



///////////////////////////////////////////////////////////////////////////////
// Deg3DBL():
// Input: u1_2..v1_0: Mumford coordinates for degree three divisor D1
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = 2*D1
//
// Description: Computes the explicit formula for doubling a degree three
//              divisor.
///////////////////////////////////////////////////////////////////////////////
Deg3DBL:= function(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u1,2va+h) = 1
    //		1.1) DA = P1+P2+P3 and deg(s) = 2						(typical)
    //      1.2)        "      and deg(s) = 1
    //      1.3)        "      and deg(s) = 0
    // 2) gcd(u1,2va+h) = dw s.t. deg(dw) = 1
    //      2.1) DA = P1+P2+P3 s.t. 2P1 = P0						(return 2P2+2P3)
    // 3) gcd(u1,2va+h) = d
    //      3.1) DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = 0				(return 2P3)
    // 4) gcd(u1,2va+h) = u1
    //      4.1) DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = 0 & 2P3 = 0	(return P0)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++
	
	// QUESTIONS
	// use sebastian's k calculations???
	// use my determinant calculation??
	
	
    // d = (2va + h) mod u1
	t01:= h3*u1_2;
	
    d2:= h2 + 2*v1_2 - t01;
    d1:= h1 + 2*v1_1 - h3*u1_1;
    d0:= h0 + 2*v1_0 - h3*u1_0;
	// 0m 0s 9a

    // adapted from Lindner's arb_splitG3_ADD
    // det := Resultant(u2,u1);
    // Original Setup T for (s*u2_1 = v2-v1) mod u2_2
    // |t1,t2,t3|
    // |t4,t5,t6|
    // |t7,t8,t9|

    // Inverted T up to factor of d; M = (T^-1)*Det(T)
    // | m1= t5*t9-t8*t6,  m2= t3*t8-t2*t9, m3= t2*t6-t3*t5 |
    // | m4= t6*t7-t4*t9,  m5= t1*t9-t3*t7, m6= t3*t4-t1*t6 |
    // | m7= t4*t8-t5*t7,  m8= t2*t7-t1*t8, m9= t1*t5-t2*t4 |

    //t1 := d0;
    //t4 := d1;
    //t7 := d2;
    t2 := -u1_0*d2;
    t5 := d0 - u1_1*d2;
    t8 := d1 - u1_2*d2;
    //t3 := -u1_2*t8;
    t6 := t2 - u1_1*t8;
    t9 := t5 - u1_2*t8;
    
    m1 := t5*t9 - t6*t8;
    m4 := t6*d2 - d1*t9;
    m7 := d1*t8 - t5*d2;
    
    det := d0*m1 + t2*m4 - u1_0*t8*m7; //Determinant of T = d0*m1 + t2*m4 + t3*m7
	// 15m 0s 9a

	// if gcd(u1,2va+h) != 1
	if (det eq 0) then

		// if gcd(u1,2va+h) = u1
		if (d2 eq 0 and d1 eq 0) then
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #4.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
			// gcd(u1,2va+h) = u1
			// DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = P0 & 2P3 = P0
			// return P0

			if (DBL_DEBUG) then "Deg3DBL: gcd(u1,2va+h) = u1, DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = P0 & 2P3 = P0"; end if;
			return 0, 0, 0, 1, 0, 0, 0;
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #4.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		end if;

		// dw = d mod u1
		t02:= d2^2;
		dw2:= u1_2*d2 - d1;					//d2

		dw1:= u1_1*t02 - d0*d2 - d1*dw2;		//d2^2
		dw0:= u1_0*t02 - d0*dw2;				//d2^2

		// if gcd(u1,2va+h) = d
		if (dw1 eq 0) then
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
			// gcd(u1,2va+h) = d
			// DA = P1+P2+P3 s.t. 2P1 = P0 and 2P2 = P0
			// return 2P3

            // k = (f - v1*h - v1^2)/u1 mod u1
			t02:= u1_2^2;
			t03:= f6*u1_2;
			t04:= h3*v1_2;
			t05:= t02 - t03;
			t06:= f5 - t04;

			k2:= f5 + t02 - t04 - 2*(u1_1 - t05);
			k1:= f4 - h2*v1_2 - h3*v1_1 - v1_2^2 - 2*(u1_0 + f6*u1_1) + u1_2*(4*u1_1 - t05 - t06);
			k0:= f3 - h1*v1_2 - h3*v1_0 - 2*f6*u1_0 + u1_1*(u1_1 + t02 - t06) + u1_2*(2*u1_0 - k1) - v1_1*(h2 + 2*v1_2);		// convenient precomputation

			// a1 = 2va+h^-1 wrt u1
			//    = 1/d2
			a1:= 1/d2;

			// u1 = u1/d	(where d is monic)
			//u1_1:= 1;
			u1_0:= u1_2 - d1*a1;

			// s = k/(2va + h) mod u1
			//   = k/(  d2   ) mod u1
			//   = k*a1 mod u1
			s0:= ((k2*u1_0 - k1)*u1_0 + k0)*a1;

			// un = u1^2
			un3:= 0;
			un2:= 1;
			un1:= 2*u1_0;
			un0:= u1_0^2;

			// vn = (u1*s + v1) mod un
			vn2:= 0;
			vn1:= s0 + v1_1 - un1*v1_2;
			vn0:= u1_0*s0 + v1_0 - un0*v1_2;

			if (DBL_DEBUG) then "Deg3DBL: gcd(u1,2va+h) = d, DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = P0"; end if;
			return un3, un2, un1, un0, vn2, vn1, vn0;
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		end if;

		// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		// gcd(u1,2va+h) = dw
		// DA = P1+P2+P3 s.t. 2P1 = P0
		// return 2P2+2P3

		// kp = (f - v1*h - v1^2)/u1
		t03:= u1_2^2;
		t04:= f6*u1_2;

		//kp4:= 1;
		kp3:= f6 - u1_2;
		kp2:= f5 - u1_1 - t04 - h3*v1_2 + t03;
		kp1:= f4 - u1_0 - f6*u1_1 - h3*v1_1 - h2*v1_2 - v1_2^2 - u1_2*(kp2 - u1_1);                      // no karatsuba, use u1_2 multiplication
		//kp0:= f3 - f6*u1_0 - h3*v1_0 - h2*v1_1 - u1_2*(kp1 - u1_0) - u1_1*(kp2) - v1_2*(h1 + 2*v1_1);

		// k = kp mod u1
		//k3:= kp3 - u1_2;
		k2:= kp2 - u1_1 - t04 + 2*t03;
		k1:= kp1 - u1_0 - u1_1*(kp3 - u1_2);
		//k0:= kp0 - u1_0*k3;
		k0:= f3 - 2*f6*u1_0 - h3*v1_0 - h2*v1_1 - u1_2*(kp1 - 3*u1_0) - u1_1*(kp2) - v1_2*(h1 + 2*v1_1);

		// dm = dw/dw1, w1 = 1/dw1
		w1:= 1/dw1;

		dm1:= 1;
		dm0:= dw0*w1;

		// a1 = (2va + h)^-1
		//    = -(u1/d)/dw1
		//    = -(u1/d)*w1
		a11:= - d2*w1;
		a10:= (d1 - u1_2*d2)*w1;

		// u1 = u1/dm
		tx:= u1_2;
		ty:= u1_1;

		//u1_2:= 1;
		u1_1:= tx - dm0;
		u1_0:= ty - u1_1*dm0;

		// s = k/(2va+h) mod u1
		// this has the same number of multiplications and fewer additions than calculating sp = k/(2va+h) and s = sp mod u1 and using karatsuba twice
		t14:= k2*u1_1;
		t15:= k2*u1_0;
		t16:= t14 - k1;
		t17:= t15 - k0;

		s1:= (t16*u1_1 - t17)*a11 - t16*a10;
		s0:= (t16*u1_0)*a11 - t17*a10;

		// kt = kp*dm
		//kt5:= 1;
		kt4:= kp3 + dm0;
		kt3:= kp2 + dm0*kp3;
		kt2:= kp1 + dm0*kp2;

		// M2 = (s*(2va + h) - kt)/u1
		//M23:= -1;
		M22:= h3*s1 - kt4 + u1_1;
		M21:= s1*(h2 + 2*v1_2) + h3*s0 - kt3 + u1_0 - u1_1*M22;
		M20:= s1*(h1 + 2*v1_1) + s0*(h2 + 2*v1_2) - kt2 - u1_1*M21 - u1_0*M22;

		// un = s^2 + M2	(made monic)
		un3:= 1;
		un2:= - s1^2 - M22;
		un1:= - 2*s0*s1 - M21;
		un0:= - s0^2 - M20;

		// vn = (-u1*s - v1 - h) mod un
		vn2:= s1*(un2 - u1_1) + h3*un2 - h2 - s0 - v1_2;
		vn1:= s1*(un1 - u1_0) + h3*un1 - s0*u1_1 - h1 - v1_1;
		vn0:= un0*(h3 + s1) - s0*u1_0 - h0 - v1_0;

		if (DBL_DEBUG) then "Deg3DBL: gcd(u1,2va+h) = dw, DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = P0"; end if;
		return un3, un2, un1, un0, vn2, vn1, vn0;
		// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	end if;
	
	// k = (f - v1*h - v1^2)/u1 mod u1
	t02:= u1_2^2;
	t03:= f6*u1_2;
	t04:= h3*v1_2;
	t05:= t02 - t03;
	t06:= f5 - t04;
	
	k2:= f5 + t02 - t04 - 2*(u1_1 - t05);
	k1:= f4 - h2*v1_2 - h3*v1_1 - v1_2^2 - 2*(u1_0 + f6*u1_1) + u1_2*(4*u1_1 - t05 - t06);
	k0:= f3 - h1*v1_2 - h3*v1_0 - 2*f6*u1_0 + u1_1*(u1_1 + t02 - t06) + u1_2*(2*u1_0 - k1) - v1_1*(h2 + 2*v1_2);     // convenient precomputation
	// 4m 2s 32a

    // adapted from Lindner's arb_splitG3_ADD
    //First column of M corresponds to polynomial q = m7x^2 + m4x + m1 = det/u1 mod u2.
    //Compute s = k*q mod u2 using Karatsuba twice
    t0 := k0*m1;
    t1 := k1*m4;
    t2 := k2*m7;
    t3 := (m4 + m7)*(k1 + k2) - t2 - t1 - u1_2*t2;
    t4 := u1_1*t2;
    t5 := t4 - t1;
	
    sp0 := t0 - u1_0*t3;
    sp1 := (m1 + m4)*(k0 + k1) - sp0 - (u1_0 + u1_1)*(t2 + t3) + t5;
    sp2 := (m1 + m7)*(k0 + k2) - t0 - t2 - t5 - u1_2*t3;
	// 11m 0s 20a

	if (sp2 eq 0) then
		if (sp1 eq 0) then
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
			// gcd(u1,2va+h) = 1 and deg(s) = 0
			// DA = P1+P2+P3
			// return 2P1+2P2+2P3

			// s = sp/det
			s0:= sp0/det;

			// M2 = (s*(2va + h) - kp)/u1
			// where kp = (f - v1*h - v1^2)/u1
			//M21:= -1;
			//M20:= s0*h3 - f6 + 2*u1_2;

			// un = s^2 + M2	(made monic)
			un3:= 0;
			un2:= 0;
			un1:= 1;
			un0:= f6 - s0*h3 - 2*u1_2 - s0^2;

			// vn = (-u1*s - v1 - h) mod un
			vn2:= 0;
			vn1:= 0;
			vn0:=  un0*(un0*(s0*(un0 - u1_2) + h3*un0 - h2 - v1_2) + h1 + v1_1 + s0*u1_1) - h0 - v1_0 - s0*u1_0;

			if (DBL_DEBUG) then "Deg3DBL: gcd(u1,2va+h) = 1 and deg(s) = 0"; end if;
			return un3, un2, un1, un0, vn2, vn1, vn0;
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		end if;

		// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		// gcd(u1,2va+h) = 1 and deg(s) = 1
		// DA = P1+P2+P3
		// return 2P1+2P2+2P3

		// s = sp/det, sm = s/s1, wi = 1/s1
		w1:= 1/(det*sp1);		// 1/((det^2)*s1)
		w2:= det*w1;            // det/((det^2)*s1) = 1/(det*s1)
		wi:= det*w2;            // det/(det*s1) = 1/s1

		sm0:= sp0*w2;      		// (s0*det)/(s1*det) = s0/s1
		s1:= (sp1^2)*w1;        // (s1*det)^2/((det^2)*s1) = s1^2/s1 = s1

		// M2 = (s*(2va + h) - kp)/u1
		// where kp = (f - v1*h - v1^2)/u1
		t06:= wi^2;

		M21:= h3*wi - t06;
		M20:= (h2 + 2*v1_2 + h3*(sm0 - u1_2) - (f6 - 2*u1_2)*wi)*wi;

		// un = s^2 + M2	(made monic)
		un3:= 0;
		un2:= 1;
		un1:= 2*sm0 + M21;
		un0:= sm0^2 + M20;

		// vn = (-u1*s - v1 - h) mod un
		t12:= u1_2 - sm0 + t06;		//wi
		t13:= s1*(un0 - u1_1 + un1*t12 - sm0*u1_2) - h2 - v1_2;

		vn2:= 0;
		vn1:= s1*(un0*t12 - u1_0 - sm0*u1_1) - un1*t13 - h1 - v1_1;
		vn0:= s1*(- sm0*u1_0) - un0*t13 - h0 - v1_0;

		if (DBL_DEBUG) then "Deg3DBL: gcd(u1,2va+h) = 1 and deg(s) = 1"; end if;
		return un3, un2, un1, un0, vn2, vn1, vn0;
		// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	end if;
	
	// ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	// gcd(u1,2va+h) = 1 and deg(s) = 2
	// DA = P1+P2+P3

	// Compute: wi = 1/s2, spmonic = s*wi = s/(det*s2), s2

	w1:= 1/(det*sp2);       // 1/((det^2)*s2)
	w2:= det*w1;            // 1/(det*s2)
	wi:= det*w2;            // 1/s2
	
	s0_monic:= sp0*w2;      // (s0*det)/(s2*det) = s0/s2
	s1_monic:= sp1*w2;      // (s1*det)/(s2*det) = s1/s2
	
	sm0:= s0_monic;
	sm1:= s1_monic;
	
	s2:= (sp2^2)*w1;        // ((s2*det)^2)/((det^2)*s2)) = s2^2/s2 = s2

	// q = u1/s
	//q1:= 1;			//s2
	q0:= u1_2 - sm1;		//s2
	
	// r = u1 mod s
	t07:= sm1*q0;
	r1:= (u1_1 - sm0 - t07)*s2;		//s2
	r0:= (u1_0 - sm0*q0)*s2;			//s2
	// 4m 0s 4a

	// kp = (f - v1*h - v1^2)/u1
	//kp3:= f6 - u1_2;
	//kp2:= f5 - u1_1 - f6*u1_2 - h3*v1_2 + u1_2^2;

	// M2 = (r*(2va + h) + kp*q)/u1
	t08:= f6 - 2*u1_2;
	
	//M22:= q1;																										//s2
	//M21:= h3*r1 + q1*(kp3 - u1_2) + q0;																			//s2
	M21:= q0 + t08 + h3*r1;																							//s2
	//M20:= - h3*r1*u1_2 - kp3*q1*u1_2 + q1*u1_2^2 + h2*r1 + h3*r0 + kp2*q1 + kp3*q0 - q0*u1_2 - q1*u1_1 + 2*r1*v1_2;		//s2
	M20:= f5 - 2*u1_1 + t05 + h3*(r0 - v1_2) - sm1*t08 + r1*(h2 + 2*v1_2 - h3*u1_2);									//s2
	//2m 0s 14a

	// un = r^2 - q*M2		(made monic)
	un3:= 1;
	un2:= M21 + q0 - r1^2;
	un1:= M20 + M21*q0 - 2*r0*r1;
	un0:= M20*q0 - r0^2;
	
	// z = (u1*r - un)/q	(where un is not monic)
	//z3:= r1;
	//z2:= r0 + wi - r1*(q0 - u1_2);
	z1:= r1*(u1_1 - t07) + r0*sm1 + wi*(un2 - q0);
	//z0:= r0*u1_1 + wi*un1 - q0*z1 + r1*u1_0;

	// vn = (z - v1 - h) mod un
	//vn2:= h3*un2 - un2*z3 - h2 - v1_2 + z2;
	//vn1:= h3*un1 - un1*z3 - h1 - v1_1 + z1;
	//vn0:= h3*un0 - un0*z3 - h0 - v1_0 + z0;

	vn2:= h3*un2 - r1*(un2 + q0 - u1_2) - h2 - v1_2 + r0 + wi;
	vn1:= h3*un1 - un1*r1 - h1 - v1_1 + z1;
	vn0:= h3*un0 - r1*(un0 - u1_0) - h0 - v1_0 + r0*u1_1 + wi*un1 - q0*z1;

	return un3, un2, un1, un0, vn2, vn1, vn0;
	// ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// DBL():
// Input: D1:         divisor as a [u, v] polynomial pair, any degree
//        f, h:       curve polynomials
//
// Output: Mumford coordinates un3, un2, un1, un0, vn2, vn1, vn0 for D3 = 2*D1
//
// Description: Dispatches on the operand degree to the Deg*DBL cases above.
///////////////////////////////////////////////////////////////////////////////
DBL:= function(D1, f, h)//startIGNORE

    f7:= Coeff(f, 7); f6:= Coeff(f, 6); f5:= Coeff(f, 5); f4:= Coeff(f, 4); f3:= Coeff(f, 3); f2:= Coeff(f, 2); f1:= Coeff(f, 1); f0:= Coeff(f, 0);

    h3:= Coeff(h,3); h2:= Coeff(h,2); h1:= Coeff(h,1); h0:= Coeff(h,0);

    u1:= D1[1]; v1:= D1[2];
        
    u1_3:= Coeff(u1,3); u1_2:= Coeff(u1,2); u1_1:= Coeff(u1,1); u1_0:= Coeff(u1,0);
    v1_2:= Coeff(v1,2); v1_1:= Coeff(v1,1); v1_0:= Coeff(v1,0);

    // handler
    if (not IsZero(u1_3)) then
        return Deg3DBL(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);

    elif (not IsZero(u1_2)) then
        return Deg2DBL(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);
        
    elif (not IsZero(u1_1)) then
        return Deg1DBL(u1_2, u1_1, u1_0, v1_2, v1_1, v1_0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);
                
    else
        return u1_3, u1_2, u1_1, u1_0, v1_2, v1_1, v1_0;
        
    end if;
        
    "THIS SHOULD NEVER HAPPEN";
    return -1, -1, -1, -1, -1, -1, -1; 
    
end function;//endIGNORE
