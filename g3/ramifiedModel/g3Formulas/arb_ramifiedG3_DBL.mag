///////////////////////////////////////////////////////////////////////////////
// Author: Randall Apperley, Sebastian Lindner
//
// Description: Explicit divisor doubling formulas for the 4 coordinate Mumford
//              representation over arbitrary fields where:
//
//              h(x) = h3*x^3 + h2*x^2 + h1*x + h0 (h3 in {0,1}) and
//              f(x) = x^7 + f6x^6 + f5x^5 + f4x^4 + f3x^3 + f2x^2 + f1x + f0
//
// On h3 in {0,1}: always reachable, and here a costing convention rather than a
//              domain restriction. Reachable because x -> a^2*x, y -> a^7*y
//              (dividing through by a^14) leaves f monic and sends h's leading
//              coefficient to h3/a, so a = h3 makes h monic; no division by 2,
//              3 or 7 is involved, so it holds in every characteristic. It is
//              declared so h3 can be //Ignore'd, which is only sound when h3 is
//              0 or 1. Note the contrast with genus 2, which is about how the
//              formulas were derived and not about the mathematics: the same
//              scaling makes h monic there too, but the genus-2 formulas were
//              written using the assumption, so they are wrong for h2 outside
//              {0,1} in every characteristic tested (char 2, 3, 5, 7, 11, 13 --
//              not a GF(4) quirk). These genus-3 formulas were written
//              generically in h3 and were measured correct outside {0,1}, so
//              the declaration narrows what is claimed and tested, not what
//              works -- and the assumption is so far declared but unexploited.
///////////////////////////////////////////////////////////////////////////////


//Must keep next line in this format for latex conversion
//Constant: f6,f5,f4,f3,f2,f1,f0,h2,h1,h0
//Ignore: h3


///////////////////////////////////////////////////////////////////////////////
// Deg1DBL():
// Input: u2..v0: Mumford coordinates for degree one divisor D1
//                     (shares the degree-3 signature; coefficients above
//                     degree one are structurally zero here)
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = 2*D1
//
// Description: Computes the explicit formula for doubling a degree one
//              divisor.
///////////////////////////////////////////////////////////////////////////////
Deg1DBL:= function(u2, u1, u0, v2, v1, v0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Cantor doubling: gcd with 2v + h, compose, then reduce. The explicit code
    //below follows NUCOMP's continued-fraction shortcut for the reduction; the
    //generic reduction here computes the same divisor.
    FF := Parent(u0);
    R<x> := PolynomialRing(FF);
    //f0 is not an argument: at every division below the absent
    //coefficients have degree below the divisor's, so they stay in the
    //discarded remainder; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    //only u0, v0 are live at degree one; the shared signature's
    //upper coefficients are structurally zero here
    u := x + u0;
    v := R!v0;

    d, s1, s3 := XGCD(u, 2*v + h);
    if not IsOne(d) then
        //the gcd factors are ramification points, order 2, killed by doubling
        u := ExactQuotient(u, d);
        v := v mod u;
        if Degree(u) eq 0 then
            return 0, 0, 0, 1, 0, 0, 0;
        end if;
        _, s1, s3 := XGCD(u, 2*v + h);
    end if;
    k := (f - v*(v + h)) div u;
    s := s3*k mod u;
    upp := u^2;
    vpp := (v + u*s) mod upp;
    while Degree(upp) gt 3 do
        upp2 := (f - vpp*(vpp + h)) div upp;
        upp2 := upp2/LeadingCoefficient(upp2);
        vpp := (-vpp - h) mod upp2;
        upp := upp2;
    end while;
    return Coeff(upp,3), Coeff(upp,2), Coeff(upp,1), Coeff(upp,0),
           Coeff(vpp,2), Coeff(vpp,1), Coeff(vpp,0);
    */ //endIGNORE
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u,2va+h) = 1
    //		1.1) DA = P1                (typical)
    // 2) gcd(u,2va+h) = u
    //      2.1) DA = P1 s.t. 2P1 = P0  (return P0)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++
    
    // d = 2va + h mod u
    t01:= u0^2;
    t02:= u0*t01;      // u0^3
    
    d0:= h0 + 2*v0 - h1*u0 + h2*t01 - h3*t02;
    
	// if gcd(u,2va+h) = u
	if (d0 eq 0) then
		// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		// gcd(u,2va+h) = u    
		// DA = P1 s.t. 2P1 = P0
		// return P0
		
		if (DBL_DEBUG) then "Deg1DBL: gcd(u,2va+h) = u, DA = P1 s.t. 2P1 = P0"; end if;
		return 0, 0, 0, 1, 0, 0, 0;
		// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	end if;
	
	// ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	// gcd(u,2va+h) = 1
	// DA = P1
	
	// k = (f - v*h - v^2)/u mod u
	k0:= f1 - h1*v0 + u0*(-2*(f2 - h2*v0) + u0*(3*(f3 - h3*v0) - 4*f4*u0 + 5*f5*t01 - 6*f6*t02 + 7*(t01^2)));
	
	// s = k/(2va + h) mod u
	s0:= k0/d0;
	
	// upp = u^2
	upp3:= 0;
	upp2:= 1;
	upp1:= 2*u0;
	upp0:= t01;
	
	// vpp = u*s + v
	vpp2:= 0;
	vpp1:= s0;
	vpp0:= u0*s0 + v0;
	
	if (DBL_DEBUG) then "Deg1DBL: Typical"; end if;
	return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
	// ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// Deg2DBL():
// Input: u2..v0: Mumford coordinates for degree two divisor D1
//                     (shares the degree-3 signature; coefficients above
//                     degree two are structurally zero here)
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = 2*D1
//
// Description: Computes the explicit formula for doubling a degree two
//              divisor.
///////////////////////////////////////////////////////////////////////////////
Deg2DBL:= function(u2, u1, u0, v2, v1, v0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Cantor doubling: gcd with 2v + h, compose, then reduce. The explicit code
    //below follows NUCOMP's continued-fraction shortcut for the reduction; the
    //generic reduction here computes the same divisor.
    FF := Parent(u0);
    R<x> := PolynomialRing(FF);
    //f0 is not an argument: at every division below the absent
    //coefficients have degree below the divisor's, so they stay in the
    //discarded remainder; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    //only the degree-2 coefficients are live here (shared signature)
    u := x^2 + u1*x + u0;
    v := v1*x + R!v0;

    d, s1, s3 := XGCD(u, 2*v + h);
    if not IsOne(d) then
        //the gcd factors are ramification points, order 2, killed by doubling
        u := ExactQuotient(u, d);
        v := v mod u;
        if Degree(u) eq 0 then
            return 0, 0, 0, 1, 0, 0, 0;
        end if;
        _, s1, s3 := XGCD(u, 2*v + h);
    end if;
    k := (f - v*(v + h)) div u;
    s := s3*k mod u;
    upp := u^2;
    vpp := (v + u*s) mod upp;
    while Degree(upp) gt 3 do
        upp2 := (f - vpp*(vpp + h)) div upp;
        upp2 := upp2/LeadingCoefficient(upp2);
        vpp := (-vpp - h) mod upp2;
        upp := upp2;
    end while;
    return Coeff(upp,3), Coeff(upp,2), Coeff(upp,1), Coeff(upp,0),
           Coeff(vpp,2), Coeff(vpp,1), Coeff(vpp,0);
    */ //endIGNORE
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u,2va+h) = 1
    //		1.1) DA = P1+P2                             (typical)
    // 2) gcd(u,2va+h) = d
    //      2.1) DA = P1+P2 s.t. 2P1 = P0               (return 2P2) 
    // 3) gcd(u,2va+h) = u
    //      3.1) DA = P1+P2 s.t. 2P1 = P0 & 2P2 = P0	(return P0)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++

    // d = (2va + h) mod u
    t01:= u1^2;
    t02:= u0*u1;
    
    d1:= h1 + 2*v1 - h2*u1 + h3*(t01 - u0);
    d0:= h0 + 2*v0 - h2*u0 + h3*t02;
    
    // set up system of equations to solve for s = (k/d) mod u
    // and find the determinant
    // adapted from Lindner's MSc thesis (pages 63-64)
    m1:= d0 - d1*u1;
    m2:= d1*u0;
    //m3:= -d1;
    //m4:= d0;
    
    det:= d0*m1 + m2*d1;
	
	// if gcd(u,2va+h) != 1
	if (det eq 0) then
	
		// if gcd(u,2va+h) = u
		if (d1 eq 0) then
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
			// gcd(u,2va+h) = u
			// DA = P1+P2 s.t. 2P1 = P0 and 2P2 = P0
			// return P0
			
			if (DBL_DEBUG) then "Deg2DBL: gcd(u,2va+h) = u, DA = P1+P2 s.t. 2P1 = P0 & 2P2 = P0"; end if;
			return 0, 0, 0, 1, 0, 0, 0;
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		end if;
		
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        // gcd(u,2va+h) = d
        // DA = P1+P2 s.t. 2P1 = P0
        // return 2P2
        
		// k = (f - v*h - v^2)/u
		t03:= u0 + u1;
		t04:= f6*u1 - t01;		// (u1*k4)
		t05:= u0 + t04;	
		t06:= f6*u0 - t02;		// (u0*k4)

		//k5:= 1;
		//k4:= f6 - u1;
		k3:= f5 - t05;
		t07:= u1*k3;
		k2:= f4 - h3*v1 - t06 - t07;
		t08:= u0*k2;
		k1:= f3 - h3*v0 - h2*v1 - (t03)*(k2 + k3) + t08 + t07;		// karatsuba
		k0:= f2 - h2*v0 - h1*v1 - v1^2 - t08 - u1*k1;
		
		// kp = k mod u
		//kp5:= 1;
		//kp4:= k4 - u1;
		kp3:= k3 - t05 + t01;
		t09:= u1*kp3;
		kp2:= k2 - t06 + t02 - t09;
		t10:= u0*kp2;
		
		kp1:= k1 - (t03)*(kp2 + kp3) + t09 + t10;		// karatsuba
		kp0:= k0 - t10;
		
		// a1 = 2va+h^-1 wrt u
		//    = 1/d1
		a1:= 1/d1;
        
        // u = u/d	(where d is monic)
        //u1:= 1;
        u0:= u1 - d0*a1;
        
		// s = k/(2va + h) mod u
        //   = k/(  d1   ) mod u
		//   = k*a1 mod u
        s0:= (kp0 - kp1*u0)*a1;
        
        // upp = u^2
        upp3:= 0;
        upp2:= 1;
        upp1:= 2*u0;
        upp0:= u0^2;
        
        // vpp = u*s + v
        vpp2:= 0;
        vpp1:= s0 + v1;
        vpp0:= u0*s0 + v0;
        
		if (DBL_DEBUG) then "Deg2DBL: gcd(u,2va+h) = d, DA = P1+P2 s.t. 2P1 = P0"; end if;
        return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
        // ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	end if;
	
	// ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	// gcd(u,2va+h) = 1
	// DA = P1+P2
	
	// k = (f - v*h - v^2)/u
	t03:= u0 + u1;
	t04:= f6*u1 - t01;		// (u1*k4)
	t05:= u0 + t04;	
	t06:= f6*u0 - t02;		// (u0*k4)

	// SEE IF CAN OPTIMIZE THIS LIKE BELOW IN DOUBLING3
	//k5:= 1;
	k4:= f6 - u1;
	k3:= f5 - t05;
	t07:= u1*k3;
	k2:= f4 - h3*v1 - t06 - t07;
	t08:= u0*k2;
	k1:= f3 - h3*v0 - h2*v1 - (t03)*(k2 + k3) + t08 + t07;		// karatsuba
	k0:= f2 - h2*v0 - h1*v1 - v1^2 - t08 - u1*k1;
	
	// kp = k mod u
	//kp5:= 1;
	//kp4:= k4 - u1;
	kp3:= k3 - t05 + t01;
	t09:= u1*kp3;
	kp2:= k2 - t06 + t02 - t09;
	t10:= u0*kp2;
	
	kp1:= k1 - (t03)*(kp2 + kp3) + t09 + t10;		// karatsuba
	kp0:= k0 - t10;
	
	// partially solve system to get sp = s*det
	// adapted from Lindner's MSc thesis (pages 63-64)
	sp0:= kp0*m1 + kp1*m2;
	sp1:= kp1*d0 - kp0*d1;
	
	// s = sp/det, w1 = 1/det
	w1:= 1/det;
	
	s1:= sp1*w1;       // (s1*det)/det
	s0:= sp0*w1;       // (s0*det)/det
	
	// M2 = (s*(2va + h) - k)/u
	//M23:= -1;
	M22:= h3*s1 - k4 + u1;
	M21:= h2*s1 + h3*s0 - k3 + u0 - u1*M22;
	M20:= h1*s1 + h2*s0 - k2 + 2*s1*v1 - u0*M22 - u1*M21;
	
	// upp = s^2 + M2	(made monic)
	upp3:= 1;
	upp2:= - s1^2 - M22;
	upp1:= - 2*s0*s1 - M21;
	upp0:= - s0^2 - M20;
	
	// vpp = (-u*s - v - h) mod upp
	vpp2:= s1*(upp2 - u1) + h3*upp2 - h2 - s0;
	vpp1:= s1*(upp1 - u0) + h3*upp1 - s0*u1 - h1 - v1;
	vpp0:= upp0*(h3 + s1) - s0*u0 - h0 - v0;
	
	if (DBL_DEBUG) then "Deg2DBL: Typical"; end if;
	return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
	// ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;



///////////////////////////////////////////////////////////////////////////////
// Deg3DBL():
// Input: u2..v0: Mumford coordinates for degree three divisor D1
//        f6..f1, h3..h0: curve coefficients
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = 2*D1
//
// Description: Computes the explicit formula for doubling a degree three
//              divisor.
///////////////////////////////////////////////////////////////////////////////
Deg3DBL:= function(u2, u1, u0, v2, v1, v0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0)
    /* //startIGNORE
    //Poly Dev Testing
    //Cantor doubling: gcd with 2v + h, compose, then reduce. The explicit code
    //below follows NUCOMP's continued-fraction shortcut for the reduction; the
    //generic reduction here computes the same divisor.
    FF := Parent(u0);
    R<x> := PolynomialRing(FF);
    //f0 is not an argument: at every division below the absent
    //coefficients have degree below the divisor's, so they stay in the
    //discarded remainder; `div` makes that explicit.
    f := x^7 + f6*x^6 + f5*x^5 + f4*x^4 + f3*x^3 + f2*x^2 + f1*x;
    h := h3*x^3 + h2*x^2 + h1*x + h0;
    u := x^3 + u2*x^2 + u1*x + u0;
    v := v2*x^2 + v1*x + v0;

    d, s1, s3 := XGCD(u, 2*v + h);
    if not IsOne(d) then
        //the gcd factors are ramification points, order 2, killed by doubling
        u := ExactQuotient(u, d);
        v := v mod u;
        if Degree(u) eq 0 then
            return 0, 0, 0, 1, 0, 0, 0;
        end if;
        _, s1, s3 := XGCD(u, 2*v + h);
    end if;
    k := (f - v*(v + h)) div u;
    s := s3*k mod u;
    upp := u^2;
    vpp := (v + u*s) mod upp;
    while Degree(upp) gt 3 do
        upp2 := (f - vpp*(vpp + h)) div upp;
        upp2 := upp2/LeadingCoefficient(upp2);
        vpp := (-vpp - h) mod upp2;
        upp := upp2;
    end while;
    return Coeff(upp,3), Coeff(upp,2), Coeff(upp,1), Coeff(upp,0),
           Coeff(vpp,2), Coeff(vpp,1), Coeff(vpp,0);
    */ //endIGNORE
    // +++++++++++++++++++++++++++++ CASES +++++++++++++++++++++++++++++++
    // 1) gcd(u,2va+h) = 1
    //		1.1) DA = P1+P2+P3 and deg(s) = 2						(typical)
    //      1.2)        "      and deg(s) = 1
    //      1.3)        "      and deg(s) = 0
    // 2) gcd(u,2va+h) = dw s.t. deg(dw) = 1
    //      2.1) DA = P1+P2+P3 s.t. 2P1 = P0						(return 2P2+2P3)
    // 3) gcd(u,2va+h) = d
    //      3.1) DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = 0				(return 2P3)
    // 4) gcd(u,2va+h) = u
    //      4.1) DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = 0 & 2P3 = 0	(return P0)
    // ++++++++++++++++++++++++++++ /CASES +++++++++++++++++++++++++++++++
	
	// This function builds all nine entries of the adjugate and recovers s by a
	// matrix-vector product, the same shape arb_ramifiedG3_ADD uses for the same
	// job. Both land on 27m 0s 17a.
	//
	// The alternative -- take only the first column of the adjugate, as Lindner's
	// arb_splitG3_ADD does, and reduce s = k*q mod u with Karatsuba twice -- costs
	// 11m 20a where the matrix-vector product costs 11m 8a, so it buys one
	// multiplication for twelve additions. That is the losing side of sec:trades'
	// 1M:3A rule, which is why this file does not use it.
	//
	// m4 and m6 are the two entries the determinant does not read, and they are
	// formed below the `det eq 0` test so the rare special cases do not pay for
	// them.
	
	
    // d = (2va + h) mod u
	t01:= h3*u2;

	// h + v, formed once: `d` needs it plus another v, and the typical case's
	// `vpp` subtracts it. Re-forming it in both cost an addition per coefficient.
	vh2:= h2 + v2;
	vh1:= h1 + v1;
	vh0:= h0 + v0;

    d2:= vh2 + v2 - t01;
    d1:= vh1 + v1 - h3*u1;
    d0:= vh0 + v0 - h3*u0;
	// 0m 0s 9a

    // adapted from Lindner's arb_splitG3_ADD
    // det := Resultant(up,u);
    // Original Setup T for (s*up1 = vp-v) mod up2
    // |t1,t2,t3|
    // |t4,t5,t6|
    // |t7,t8,t9|

    // Inverted T up to factor of d; M = (T^-1)*Det(T)
    // | m1= t5*t9-t8*t6,  m2= t3*t8-t2*t9, m3= t2*t6-t3*t5 |
    // | m4= t6*t7-t4*t9,  m5= t1*t9-t3*t7, m6= t3*t4-t1*t6 |
    // | m7= t4*t8-t5*t7,  m8= t2*t7-t1*t8, m9= t1*t5-t2*t4 |

    //t1 := d0;
    //t4 := d1;
    //t7 := d2;
	ta := u2*d2;
	tb := u1*d2;
	tc := u0*d2;
    t5 := d0 - tb;
    t8 := d1 - ta;
    //t2 := -tc;
    //t3 := -u0*t8;
    //t6 := t2 - u1*t8;
    //t9 := t5 - u2*t8;
	temp3 := d2*tc;
	temp4 := d1*t8;
	temp5 := d0*t8;

	// Bottom row of the adjugate needs only columns 1 and 2 of T.
	m9 := d0*t5 + d1*tc;
	m8 := -temp5 - temp3;
	m7 := temp4 - d2*t5;

	// Column 3 of T is x*(column 2) reduced mod u, so the remaining six
	// adjugate entries are shifts of the bottom row -- one multiplication each,
	// not a 2x2 minor. m4 and m6 are the only two the determinant does not
	// read, so they wait until the generic path below.
	tf := -u0*m7;
	m5 := m9 + u2*m8;
	m3 := -u0*m8;
	m2 := tf;
	m1 := m5 + u1*m7;

    det := d0*m1 + d1*m2 + d2*m3; //Determinant of T = t1*m1 + t4*m2 + t7*m3
	// 16m 0s 9a

	// if gcd(u,2va+h) != 1
	if (det eq 0) then

		// if gcd(u,2va+h) = u
		if (d2 eq 0 and d1 eq 0) then
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #4.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
			// gcd(u,2va+h) = u
			// DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = P0 & 2P3 = P0
			// return P0

			if (DBL_DEBUG) then "Deg3DBL: gcd(u,2va+h) = u, DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = P0 & 2P3 = P0"; end if;
			return 0, 0, 0, 1, 0, 0, 0;
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #4.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		end if;

		// dw = d mod u. The Sylvester block above already holds it: dw is the
		// third row of the adjugate up to sign, so
		//   dw2 = u2*d2 - d1               = -t8
		//   dw1 = u1*d2^2 - d0*d2 - d1*dw2 =  m7
		//   dw0 = u0*d2^2 - d0*dw2         = -m8
		// Polynomial identities in d2,d1,d0,u2,u1,u0, not coincidences of
		// this branch. dw2 is not formed at all: its only readers were the two
		// lines below.
		dw1:= m7;								//d2^2
		dw0:= -m8;								//d2^2

		// if gcd(u,2va+h) = d
		if (dw1 eq 0) then
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
			// gcd(u,2va+h) = d
			// DA = P1+P2+P3 s.t. 2P1 = P0 and 2P2 = P0
			// return 2P3

            // k = (f - v*h - v^2)/u mod u
			t02:= u2^2;
			t03:= f6*u2;
			t04:= h3*v2;
			t05:= t02 - t03;
			t06:= f5 - t04;

			k2:= t06 + t02 - 2*(u1 - t05);
			k1:= f4 - v2*vh2 - h3*v1 - 2*(u0 + f6*u1) + u2*(4*u1 - t05 - t06);
			k0:= f3 - h1*v2 - h3*v0 - 2*f6*u0 + u1*(u1 + t02 - t06) + u2*(2*u0 - k1) - v1*(vh2 + v2);		// convenient precomputation

			// a1 = 2va+h^-1 wrt u
			//    = 1/d2
			a1:= 1/d2;

			// u = u/d	(where d is monic)
			//u1:= 1;
			u0:= u2 - d1*a1;

			// s = k/(2va + h) mod u
			//   = k/(  d2   ) mod u
			//   = k*a1 mod u
			s0:= ((k2*u0 - k1)*u0 + k0)*a1;

			// upp = u^2
			upp3:= 0;
			upp2:= 1;
			upp1:= 2*u0;
			upp0:= u0^2;

			// vpp = (u*s + v) mod upp
			vpp2:= 0;
			vpp1:= s0 + v1 - upp1*v2;
			vpp0:= u0*s0 + v0 - upp0*v2;

			if (DBL_DEBUG) then "Deg3DBL: gcd(u,2va+h) = d, DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = P0"; end if;
			return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #3.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		end if;

		// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		// gcd(u,2va+h) = dw
		// DA = P1+P2+P3 s.t. 2P1 = P0
		// return 2P2+2P3

		// kp = (f - v*h - v^2)/u
		t03:= u2^2;
		t04:= f6*u2;

		//kp4:= 1;
		kp3:= f6 - u2;
		kp2:= f5 - u1 - t04 - h3*v2 + t03;
		kp1:= f4 - u0 - f6*u1 - h3*v1 - v2*vh2 - u2*(kp2 - u1);                      // no karatsuba, use u2 multiplication
		//kp0:= f3 - f6*u0 - h3*v0 - h2*v1 - u2*(kp1 - u0) - u1*(kp2) - v2*(h1 + 2*v1);

		// k = kp mod u
		//k3:= kp3 - u2;
		k2:= kp2 - u1 - t04 + 2*t03;
		k1:= kp1 - u0 - u1*(kp3 - u2);
		//k0:= kp0 - u0*k3;
		k0:= f3 - 2*f6*u0 - h3*v0 - h2*v1 - u2*(kp1 - 3*u0) - u1*(kp2) - v2*(vh1 + v1);

		// dm = dw/dw1, w1 = 1/dw1
		w1:= 1/dw1;

		dm1:= 1;
		dm0:= dw0*w1;

		// a1 = (2va + h)^-1
		//    = -(u/d)/dw1
		//    = -(u/d)*w1
		a11:= - d2*w1;
		a10:= (d1 - u2*d2)*w1;

		// u = u/dm
		tx:= u2;
		ty:= u1;

		//u2:= 1;
		u1:= tx - dm0;
		u0:= ty - u1*dm0;

		// s = k/(2va+h) mod u
		// this has the same number of multiplications and fewer additions than calculating sp = k/(2va+h) and s = sp mod u and using karatsuba twice
		t14:= k2*u1;
		t15:= k2*u0;
		t16:= t14 - k1;
		t17:= t15 - k0;

		s1:= (t16*u1 - t17)*a11 - t16*a10;
		s0:= (t16*u0)*a11 - t17*a10;

		// kt = kp*dm
		//kt5:= 1;
		kt4:= kp3 + dm0;
		kt3:= kp2 + dm0*kp3;
		kt2:= kp1 + dm0*kp2;

		// M2 = (s*(2va + h) - kt)/u
		//M23:= -1;
		M22:= h3*s1 - kt4 + u1;
		M21:= s1*(vh2 + v2) + h3*s0 - kt3 + u0 - u1*M22;
		M20:= s1*(vh1 + v1) + s0*(vh2 + v2) - kt2 - u1*M21 - u0*M22;

		// upp = s^2 + M2	(made monic)
		upp3:= 1;
		upp2:= - s1^2 - M22;
		upp1:= - 2*s0*s1 - M21;
		upp0:= - s0^2 - M20;

		// vpp = (-u*s - v - h) mod upp
		vpp2:= s1*(upp2 - u1) + h3*upp2 - h2 - s0 - v2;
		vpp1:= s1*(upp1 - u0) + h3*upp1 - s0*u1 - h1 - v1;
		vpp0:= upp0*(h3 + s1) - s0*u0 - h0 - v0;

		if (DBL_DEBUG) then "Deg3DBL: gcd(u,2va+h) = dw, DA = P1+P2+P3 s.t. 2P1 = P0 & 2P2 = P0"; end if;
		return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
		// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #2.1 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	end if;
	
	// k = (f - v*h - v^2)/u mod u
	t02:= u2^2;
	t03:= f6*u2;
	t04:= h3*v2;
	t05:= t02 - t03;
	t06:= f5 - t04;
	
	k2:= t06 + t02 - 2*(u1 - t05);
	k1:= f4 - v2*vh2 - h3*v1 - 2*(u0 + f6*u1) + u2*(4*u1 - t05 - t06);
	k0:= f3 - h1*v2 - h3*v0 - 2*f6*u0 + u1*(u1 + t02 - t06) + u2*(2*u0 - k1) - v1*(vh2 + v2);     // convenient precomputation
	// 6m 1s 27a 3c   (t02..k0; the only annotated block here with a live C)

    // adapted from Lindner's arb_splitG3_ADD
	// the two adjugate entries the determinant did not need
	m4 := m8 + u2*m7;
	m6 := tf - u1*m8;

	// sp = s*det = M*k as a matrix-vector product. M is multiplication by
	// q = det/(2va+h) mod u, so this is the same map as k*q mod u. Building all
	// nine adjugate entries and solving this way costs 1 multiplication more and
	// 12 additions fewer than taking the first column alone and reducing with
	// Karatsuba twice -- counting the whole job, the adjugate block above
	// included. This block by itself is 11m 8a against that route's 11m 20a.
    sp0 := k0*m1 + k1*m2 + k2*m3;
    sp1 := k0*m4 + k1*m5 + k2*m6;
    sp2 := k0*m7 + k1*m8 + k2*m9;
	// 11m 0s 8a

	if (sp2 eq 0) then
		if (sp1 eq 0) then
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
			// gcd(u,2va+h) = 1 and deg(s) = 0
			// DA = P1+P2+P3
			// return 2P1+2P2+2P3

			// s = sp/det
			s0:= sp0/det;

			// M2 = (s*(2va + h) - kp)/u
			// where kp = (f - v*h - v^2)/u
			//M21:= -1;
			//M20:= s0*h3 - f6 + 2*u2;

			// upp = s^2 + M2	(made monic)
			upp3:= 0;
			upp2:= 0;
			upp1:= 1;
			upp0:= f6 - s0*h3 - 2*u2 - s0^2;

			// vpp = (-u*s - v - h) mod upp
			vpp2:= 0;
			vpp1:= 0;
			vpp0:=  upp0*(upp0*(s0*(upp0 - u2) + h3*upp0 - h2 - v2) + h1 + v1 + s0*u1) - h0 - v0 - s0*u0;

			if (DBL_DEBUG) then "Deg3DBL: gcd(u,2va+h) = 1 and deg(s) = 0"; end if;
			return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
			// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		end if;

		// ~~~~~~~~~~~~~~~~~~~~~~~~~~~ CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
		// gcd(u,2va+h) = 1 and deg(s) = 1
		// DA = P1+P2+P3
		// return 2P1+2P2+2P3

		// s = sp/det, sm = s/s1, wi = 1/s1
		w1:= 1/(det*sp1);		// 1/((det^2)*s1)
		w2:= det*w1;            // det/((det^2)*s1) = 1/(det*s1)
		wi:= det*w2;            // det/(det*s1) = 1/s1

		sm0:= sp0*w2;      		// (s0*det)/(s1*det) = s0/s1
		s1:= (sp1^2)*w1;        // (s1*det)^2/((det^2)*s1) = s1^2/s1 = s1

		// M2 = (s*(2va + h) - kp)/u
		// where kp = (f - v*h - v^2)/u
		t06:= wi^2;

		M21:= h3*wi - t06;
		M20:= (vh2 + v2 + h3*(sm0 - u2) - (f6 - 2*u2)*wi)*wi;

		// upp = s^2 + M2	(made monic)
		upp3:= 0;
		upp2:= 1;
		upp1:= 2*sm0 + M21;
		upp0:= sm0^2 + M20;

		// vpp = (-u*s - v - h) mod upp
		t12:= u2 - sm0 + t06;		//wi
		t13:= s1*(upp0 - u1 + upp1*t12 - sm0*u2) - h2 - v2;

		vpp2:= 0;
		vpp1:= s1*(upp0*t12 - u0 - sm0*u1) - upp1*t13 - h1 - v1;
		vpp0:= s1*(- sm0*u0) - upp0*t13 - h0 - v0;

		if (DBL_DEBUG) then "Deg3DBL: gcd(u,2va+h) = 1 and deg(s) = 1"; end if;
		return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
		// ~~~~~~~~~~~~~~~~~~~~~~~~~~ /CASE #1.2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	end if;
	
	// ~~~~~~~~~~~~~~~~~~~~~~~~~ TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	// gcd(u,2va+h) = 1 and deg(s) = 2
	// DA = P1+P2+P3

	// Compute: wi = 1/s2, spmonic = s*wi = s/(det*s2), s2

	w1:= 1/(det*sp2);       // 1/((det^2)*s2)
	w2:= det*w1;            // 1/(det*s2)
	wi:= det*w2;            // 1/s2
	
	sm0:= sp0*w2;      // (s0*det)/(s2*det) = s0/s2
	sm1:= sp1*w2;      // (s1*det)/(s2*det) = s1/s2
	
	s2:= (sp2^2)*w1;        // ((s2*det)^2)/((det^2)*s2)) = s2^2/s2 = s2

	// q = u/s
	//q1:= 1;			//s2
	q0:= u2 - sm1;		//s2
	
	// r = u mod s
	t07:= sm1*q0;
	r1:= (u1 - sm0 - t07)*s2;		//s2
	r0:= (u0 - sm0*q0)*s2;			//s2
	// 4m 0s 4a

	// kp = (f - v*h - v^2)/u
	//kp3:= f6 - u2;
	//kp2:= f5 - u1 - f6*u2 - h3*v2 + u2^2;

	// M2 = (r*(2va + h) + kp*q)/u
	t08:= f6 - 2*u2;
	
	//M22:= q1;																										//s2
	//M21:= h3*r1 + q1*(kp3 - u2) + q0;																			//s2
	M21:= q0 + t08 + h3*r1;																							//s2
	//M20:= - h3*r1*u2 - kp3*q1*u2 + q1*u2^2 + h2*r1 + h3*r0 + kp2*q1 + kp3*q0 - q0*u2 - q1*u1 + 2*r1*v2;		//s2
	M20:= t06 - 2*u1 + t05 + h3*r0 - sm1*t08 + r1*d2;									//s2
	//2m 0s 10a

	// upp = r^2 - q*M2		(made monic)
	upp3:= 1;
	upp2:= M21 + q0 - r1^2;
	upp1:= M20 + M21*q0 - 2*r0*r1;
	upp0:= M20*q0 - r0^2;
	
	// z = (u*r - upp)/q	(where upp is not monic)
	//z3:= r1;
	//z2:= r0 + wi - r1*(q0 - u2);
	z1:= r1*(u1 - t07) + r0*sm1 + wi*(upp2 - q0);
	//z0:= r0*u1 + wi*upp1 - q0*z1 + r1*u0;

	// vpp = (z - v - h) mod upp
	//vpp2:= h3*upp2 - upp2*z3 - h2 - v2 + z2;
	//vpp1:= h3*upp1 - upp1*z3 - h1 - v1 + z1;
	//vpp0:= h3*upp0 - upp0*z3 - h0 - v0 + z0;

	vpp2:= h3*upp2 - r1*(upp2 + q0 - u2) - vh2 + r0 + wi;
	vpp1:= h3*upp1 - upp1*r1 - vh1 + z1;
	vpp0:= h3*upp0 - r1*(upp0 - u0) - vh0 + r0*u1 + wi*upp1 - q0*z1;

	return upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0;
	// ~~~~~~~~~~~~~~~~~~~~~~~~ /TYPICAL CASE ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
end function;


///////////////////////////////////////////////////////////////////////////////
// DBL():
// Input: D1:         divisor as a [u, v] polynomial pair, any degree
//        f, h:       curve polynomials
//
// Output: Mumford coordinates upp3, upp2, upp1, upp0, vpp2, vpp1, vpp0 for D3 = 2*D1
//
// Description: Dispatches on the operand degree to the Deg*DBL cases above.
///////////////////////////////////////////////////////////////////////////////
DBL:= function(D1, f, h)//startIGNORE

    f7:= Coeff(f, 7); f6:= Coeff(f, 6); f5:= Coeff(f, 5); f4:= Coeff(f, 4); f3:= Coeff(f, 3); f2:= Coeff(f, 2); f1:= Coeff(f, 1); f0:= Coeff(f, 0);

    h3:= Coeff(h,3); h2:= Coeff(h,2); h1:= Coeff(h,1); h0:= Coeff(h,0);

    u:= D1[1]; v:= D1[2];
        
    u3:= Coeff(u,3); u2:= Coeff(u,2); u1:= Coeff(u,1); u0:= Coeff(u,0);
    v2:= Coeff(v,2); v1:= Coeff(v,1); v0:= Coeff(v,0);

    // handler
    if (not IsZero(u3)) then
        return Deg3DBL(u2, u1, u0, v2, v1, v0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);

    elif (not IsZero(u2)) then
        return Deg2DBL(u2, u1, u0, v2, v1, v0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);
        
    elif (not IsZero(u1)) then
        return Deg1DBL(u2, u1, u0, v2, v1, v0, f6, f5, f4, f3, f2, f1, h3, h2, h1, h0);
                
    else
        return u3, u2, u1, u0, v2, v1, v0;
        
    end if;
        
    "THIS SHOULD NEVER HAPPEN";
    return -1, -1, -1, -1, -1, -1, -1; 
    
end function;//endIGNORE
