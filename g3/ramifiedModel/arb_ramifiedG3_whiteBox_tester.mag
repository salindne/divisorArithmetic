FF := GF(8);
R<x>:=PolynomialRing(FF);
f:= R! x^7 + x^2 + FF.1^2*x + FF.1^3;
h:= R! x^3 + FF.1^4*x^2 + FF.1^3*x + FF.1;
C:= HyperellipticCurve(f,h);
J:= Jacobian(C);

U1 := R!x^3+FF.1*x^2;
V1 := R!FF.1^4*x+1;
D1 := J![U1,V1];
un3,un2,un1,un0,vn2,vn1,vn0 := DBL(U1,V1,f,h);
nU:= R! un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! vn2*x^2 + vn1*x^1 + vn0*x^0;
Cantor:= 2*D1;
assert (un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0) eq Cantor[1] and (vn2*x^2 + vn1*x^1 + vn0*x^0) eq Cantor[2];


