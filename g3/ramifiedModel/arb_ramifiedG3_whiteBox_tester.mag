C:= HyperellipticCurve(f,h);
J:= Jacobian(C);

U1 := R!x^3+3*x^2+2*x+1;
V1 := R!2*x^2+2*x+1;
U2 := R!x^3+2*x^2+4*x+1;
V2 := R!x+1;
D1 := J![U1,V1];
D2 := J![U2,V2];
un3,un2,un1,un0,vn2,vn1,vn0 := ADD(U1,V1,U2,V2,f,h);
nU:= R! un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! vn2*x^2 + vn1*x^1 + vn0*x^0;
Cantor:= D1 + D2;
assert (un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0) eq Cantor[1] and (vn2*x^2 + vn1*x^1 + vn0*x^0) eq Cantor[2];


