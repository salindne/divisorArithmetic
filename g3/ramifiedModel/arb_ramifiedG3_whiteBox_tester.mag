ADD_DEBUG := true;
DBL_DEBUG := true;
load "ramifiedUtilities.mag";
load "g3Formulas/arb_ramifiedG3_DBL.mag";
load "g3Formulas/arb_ramifiedG3_ADD.mag";
"";

FF := GF(2);
R<x>:=PolynomialRing(FF);
f:= R! x^7 + x^6 + x^3 + x^2 + x;
h:= R! x^2 + 1;
C:= HyperellipticCurve(f,h);
J:= Jacobian(C);

U1 := R!x;
V1 := R!0;
U2 := R!x;
V2 := R!1;
D1 := J![U1,V1];
D2 := J![U2,V2];
un3,un2,un1,un0,vn2,vn1,vn0 := ADD(U1,V1,U2,V2,f,h);
nU:= R! un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! vn2*x^2 + vn1*x^1 + vn0*x^0;
Cantor:= D1 + D2;
assert (un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0) eq Cantor[1] and (vn2*x^2 + vn1*x^1 + vn0*x^0) eq Cantor[2];


FF := GF(3);
R<x>:=PolynomialRing(FF);
f:= R! x^7 + x^6 + 2*x^5 + x^3;
h:= R! 2*x^2 + x + 2;
C:= HyperellipticCurve(f,h);
J:= Jacobian(C);

U1 := R!x;
V1 := R!0;
U2 := R!x;
V2 := R!1;
D1 := J![U1,V1];
D2 := J![U2,V2];
un3,un2,un1,un0,vn2,vn1,vn0 := ADD(U1,V1,U2,V2,f,h);
nU:= R! un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! vn2*x^2 + vn1*x^1 + vn0*x^0;
Cantor:= D1 + D2;
assert (un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0) eq Cantor[1] and (vn2*x^2 + vn1*x^1 + vn0*x^0) eq Cantor[2];


FF := GF(4);
R<x>:=PolynomialRing(FF);
f:= R! x^7 + FF.1*x^6 + x^5 + FF.1^2*x^2 + FF.1*x + FF.1;
h:= R! FF.1*x^2 + FF.1*x + 1;
C:= HyperellipticCurve(f,h);
J:= Jacobian(C);

U1 := R!x+1;
V1 := R!FF.1;
U2 := R!x+1;
V2 := R!FF.1^2;
D1 := J![U1,V1];
D2 := J![U2,V2];
un3,un2,un1,un0,vn2,vn1,vn0 := ADD(U1,V1,U2,V2,f,h);
nU:= R! un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! vn2*x^2 + vn1*x^1 + vn0*x^0;
Cantor:= D1 + D2;
assert (un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0) eq Cantor[1] and (vn2*x^2 + vn1*x^1 + vn0*x^0) eq Cantor[2];


FF := GF(5);
