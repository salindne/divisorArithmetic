nU:= R! un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! Coeff(Vn,4)*x^4 + Coeff(Vn,3)*x^3 + vn2*x^2 + vn1*x^1 + vn0*x^0;
Cantor:= NegativeReducedBasis(Add(AD1,AD2,f,h,V),f,h);
