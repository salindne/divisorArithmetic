ADD_DEBUG := true;
DBL_DEBUG := true;
UTL_DEBUG := false;
load "poly_balanced_arithmetic.mag";
load "g3Formulas/ch2_splitG3_UTL.mag";
load "g3Formulas/ch2_splitG3_DBL.mag";
load "g3Formulas/ch2_splitG3_ADD.mag";
"";

FF := GF(4);
R<x>:=PolynomialRing(FF);
f:= R! x^8 + x^2 + x + FF.1;
h:= R! x^4 + x + 1;
V:= R! FF.1^2*x^4 + FF.1^2*x + FF.1^2;
Vn:= -V - h;
ccs:= Precompute(f,h,4);

U1 := R! 1;
V1 := R! FF.1*x^4+FF.1*x+FF.1;
N1 := 3;
U2 := R! x+FF.1^2;
V2 := R! FF.1*x^4+FF.1*x+FF.1^2;
N2 := 2;
D1 := <U1, V1, N1>;
D2 := <U2, V2, N2>;
AD1 := AdaptedBasis(D1,f,h);
AD2 := AdaptedBasis(D2,f,h);
un3,un2,un1,un0,vn2,vn1,vn0, nN := ADD(U1,V1,N1,U2,V2,N2,ccs);
nU:= R! un3*x^3 + un2*x^2 + un1*x^1 + un0*x^0;
nV:= R! Coeff(Vn,4)*x^4 + Coeff(Vn,3)*x^3 + vn2*x^2 + vn1*x^1 + vn0*x^0;
Cantor:= NegativeReducedBasis(Add(AD1,AD2,f,h,V),f,h);
assert <nU,nV,nN> eq Cantor;

FF := GF(8);
R<x>:=PolynomialRing(FF);
f:= R! FF.1*x^8 + FF.1^3*x^2 + x + FF.1^6;
