clear;
///////////////////////////////////////////////////////////////////////////////
/////// TESTING SPLIT MODEL DIVISOR ARITHMETIC OVER ARBITRARY FIELDS //////////
///////////////////////////////////////////////////////////////////////////////
//
// Sebastian Lindner, 2019
//-----------------------------------------------------------------------------
// OVERVIEW
//-----------------------------------------------------------------------------
// This script generates white box testsing cases over aribtrary fields.
//
///////////////////////////////////////////////////////////////////////////////


///////////////////////////////////////////////////////////////////////////////
//PRINT CASES FOR splitG2_tester.py SCRIPT
///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////
UTL_DEBUG := false;
DBL_DEBUG := true;
ADD_DEBUG := true;

///////////////////////////////////////////////////////////////////////////////
//LOAD FILES
///////////////////////////////////////////////////////////////////////////////
load "genFiles/ramifiedUtilities.mag";
load "../g2/ramifiedModel/g2Formulas/ch2_ramifiedG2_DBL.mag";
load "../g2/ramifiedModel/g2Formulas/ch2_ramifiedG2_ADD.mag";
"     ";


///////////////////////////////////////////////////////////////////////////////
// BUDGET -- see whitebox_auto_NEG.py, which sets these
///////////////////////////////////////////////////////////////////////////////
// WB_FIELDS  comma separated field sizes, overriding the ladder below. This is
//            what the two-cases-per-branch quota needs: a branch takes two cases
//            per characteristic class and they must come from DIFFERENT fields,
//            so a class with only one field in the ladder can never reach quota.
// WB_TRIALS  random curves per field. The loop was `while true`, stoppable only
//            by being killed, which is also why its output could be truncated
//            mid-block.
// WB_SEED    Magma seed, so a regenerated tester is a function of (seed, budget)
//            rather than of the moment the loop happened to be interrupted.
// WB_LOG     where to write the blocks. Was hardcoded, so the tool could not tell
//            the generator where to put them.
FIELDS := [4,8];
if GetEnv("WB_FIELDS") ne "" then
    FIELDS := [ StringToInteger(s) : s in Split(GetEnv("WB_FIELDS"), ",") ];
end if;
TRIALS := StringToInteger(GetEnv("WB_TRIALS") eq "" select "40" else GetEnv("WB_TRIALS"));
SetSeed(StringToInteger(GetEnv("WB_SEED") eq "" select "1" else GetEnv("WB_SEED")));
WB_LOG := GetEnv("WB_LOG");
if WB_LOG eq "" then WB_LOG := "logs/ch2_ramifiedG2_log.txt"; end if;

SetOutputFile(WB_LOG : Overwrite := true);
SetAutoColumns(false);
SetColumns(0);

///////////////////////////////////////////////////////////////////////////////
//GLOBAL TESTING VARIABLES
///////////////////////////////////////////////////////////////////////////////
//Field sizes below 10 for auto gen cases
//Split curves do not exist for FF(2)
DIVISORS:= 1;


/////////////////////////////////////////////////////////
///////////////////// TEST LOOPS ////////////////////////
/////////////////////////////////////////////////////////
for F in FIELDS do
 for trial in [1..TRIALS] do
  // Every field in the ladder, TRIALS curves each. Was
  // `while true` with F drawn at random.
  FF:=GF(F);
  R<x>:=PolynomialRing(FF);
  f,h:= RandomG2Char2Curve(F);
  C:= HyperellipticCurve(f,h);
  Jac:= Jacobian(C); 
  
  divisor:= 0;
  while divisor le DIVISORS do
    divisor+:=1;

    /////////////////////////////////////////////////////
    ///RANDOM DIVISORS
    /////////////////////////////////////////////////////
    D1:= Random(Jac);
    U1:= D1[1];
    V1:= D1[2];
  
    D2 := Random(Jac);
    U2:= D2[1];
    V2:= D2[2];

    "@B";
    nU2,nU1,nU0,nV1,nV0 := DBL(U1,V1,f,h);
    nU:= R ! nU2*x^2 + nU1*x + nU0;
    nV:= R ! nV1*x + nV0;
    cantor:= D1 + D1;
    if nU eq cantor[1] and nV eq cantor[2] then
      F; f, h, <D1[1], D1[2]>, <D2[1],D2[2]>, <nU,nV>;
      "@E";
    else
      "failed";
    end if;
    if D1 ne D2 then
      "@B";
      nU2,nU1,nU0,nV1,nV0 := ADD(U1,V1,U2,V2,f,h);
      nU:= R ! nU2*x^2 + nU1*x + nU0;
      nV:= R ! nV1*x + nV0;
      cantor:= D1 + D2;
      if nU eq cantor[1] and nV eq cantor[2] then
        F; f, h, <D1[1], D1[2]>, <D2[1],D2[2]>, <nU,nV>;
        "@E";
      else
        "failed";
      end if;
    end if;
  end while; 
end for;
end for;
