clear;
///////////////////////////////////////////////////////////////////////////////
/////// TESTING SPLIT MODEL DIVISOR ARITHMETIC OVER ARBITRARY FIELDS //////////
///////////////////////////////////////////////////////////////////////////////
//
// Sebastian Lindner, 2019
//-----------------------------------------------------------------------------
// OVERVIEW
//-----------------------------------------------------------------------------
// This script generates white box testsing cases over aribtrary fields.
//
///////////////////////////////////////////////////////////////////////////////


///////////////////////////////////////////////////////////////////////////////
//PRINT CASES FOR splitG2_tester.py SCRIPT
///////////////////////////////////////////////////////////////////////////////
WB_LOG := GetEnv("WB_LOG") eq "" select "logs/arb_splitG3_log.txt" else GetEnv("WB_LOG");
Write(WB_LOG, "Loaded ..."); 

///////////////////////////////////////////////////////////////////
UTL_DEBUG := false;
DBL_DEBUG := true;
ADD_DEBUG := true;

///////////////////////////////////////////////////////////////////////////////
//LOAD FILES
///////////////////////////////////////////////////////////////////////////////
load "../g3/splitModel/negReduced/poly_balanced_arithmetic.mag";
load "../g3/splitModel/negReduced/g3Formulas/arb_splitG3_UTL.mag";
load "../g3/splitModel/negReduced/g3Formulas/arb_splitG3_DBL.mag";
load "../g3/splitModel/negReduced/g3Formulas/arb_splitG3_ADD.mag";
"     ";

SetOutputFile(WB_LOG); //Comment out if manually debugging
SetAutoColumns(false);
SetColumns(0);

///////////////////////////////////////////////////////////////////////////////
//GLOBAL TESTING VARIABLES
///////////////////////////////////////////////////////////////////////////////
//Field sizes below 10 for auto gen cases
//Split curves do not exist for FF(2)
FIELDS:= {3,4,5,7}; //,8,9,11};
// Divisor pairs per curve, minus one. Raising this reuses a curve and its
// Precompute across more pairs, which is the cheaper way to buy samples; the
// trade is less curve diversity, so a mix of both levers beats either alone.
DIVISORS := StringToInteger(GetEnv("WB_DIVISORS") eq "" select "1" else GetEnv("WB_DIVISORS"));
H_ZERO := false;

///////////////////////////////////////////////////////////////////////////////
//TRIAL BOUND AND SEED
///////////////////////////////////////////////////////////////////////////////
// The trial loop below was `while true do`, stoppable only from outside:
// whitebox_auto_NEG.py ran this file with `magma` on PATH, then SIGSTOPped the
// process every ten seconds to scrape the log and killed it once every branch tag
// had been seen. Neither half survives Magma running in a container, so the bound
// lives here now and the generator terminates on its own.
//
// Reaching every tag is a random search either way -- that is what the loop always
// was. The difference is that an unreached tag is now reported by the runner
// instead of spinning here forever.
//
// SetSeed makes the search reproducible, so a regenerated tester is a function of
// (seed, trials) rather than of the moment it happened to be interrupted.
TRIALS := StringToInteger(GetEnv("WB_TRIALS") eq "" select "400" else GetEnv("WB_TRIALS"));
SetSeed(StringToInteger(GetEnv("WB_SEED") eq "" select "1" else GetEnv("WB_SEED")));

/////////////////////////////////////////////////////////
///////////////////// TEST LOOPS ////////////////////////
/////////////////////////////////////////////////////////
trial:= 0;
while trial lt TRIALS do
  trial +:= 1;
  // Random finite field FF and polynomial ring over FF
  F:= Random(FIELDS);
  FF:=GF(F);
  R<x>:=PolynomialRing(FF);
  f,h:= RandomSplitCurve(3,F,H_ZERO);
  Vp:= ComputeVpl(f,h);
  Vn:= -Vp - h;
  curveConst:= Precompute(f,h,F); 
  
  divisor:= 0;
  while divisor le DIVISORS do
    divisor+:=1;

    /////////////////////////////////////////////////////
    ///RANDOM DIVISORS
    /////////////////////////////////////////////////////
    D1:= RandomDivisorAB(f,h);
    RD1:= NegativeReducedBasis(D1,f,h);
    U1:= RD1[1];
    V1:= RD1[2];
    N1:= RD1[3];

    D2 := RandomDivisorAB(f,h);
    RD2:= NegativeReducedBasis(D2,f,h);
    U2:= RD2[1];
    V2:= RD2[2];
    N2:= RD2[3];

    "@B";
    nU3,nU2,nU1,nU0,nV2,nV1,nV0,nN := DBL(U1,V1,N1,curveConst);
    nU:= R ! nU3*x^3 + nU2*x^2 + nU1*x + nU0;
    nV:= R ! Coeff(Vn,4)*x^4 + Coeff(Vn,3)*x^3 + nV2*x^2 + nV1*x + nV0;
    cantor:= NegativeReducedBasis(Double(D1,f,h,Vp),f,h);
    if <nU,nV,nN> eq cantor then
      F; f, h, Vp, Vn, RD1, RD2, <nU,nV,nN>;
      "@E";
    else
      "failed";
    end if;
    if D1 ne D2 then
      "@B";
      nU3,nU2,nU1,nU0,nV2,nV1,nV0,nN := ADD(U1,V1,N1,U2,V2,N2,curveConst);
      nU:= R ! nU3*x^3 + nU2*x^2 + nU1*x + nU0;
      nV:= R ! Coeff(Vn,4)*x^4 + Coeff(Vn,3)*x^3 + nV2*x^2 + nV1*x + nV0;
      cantor:= NegativeReducedBasis(Add(D1,D2,f,h,Vp),f,h);
      if <nU,nV,nN> eq cantor then
        F; f, h, Vp, Vn, RD1, RD2, <nU,nV,nN>;
        "@E";
      else
        "failed";
      end if;
    end if;
  end while; 
end while;

UnsetOutputFile();
quit;
